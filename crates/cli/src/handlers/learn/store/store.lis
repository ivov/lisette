import "go:encoding/json"
import "go:errors"
import "go:io/fs"
import "go:os"

import "models"

/// Loads tasks from the JSON file. Returns an empty list if the file doesn't exist.
pub fn load() -> Result<Slice<models.Task>, error> {
  let Ok(bytes) = os.ReadFile("tasks.json") else {
    return Ok([])
  }
  let mut items: Slice<models.Task> = []
  json.Unmarshal(bytes, &items).wrap_err("parsing tasks.json")?
  Ok(items)
}

/// Saves tasks to the JSON file.
pub fn save(items: Slice<models.Task>) -> Result<(), error> {
  let data = json.MarshalIndent(items, "", "  ").wrap_err("encoding tasks")?
  let permissions = 0o644 as fs.FileMode
  os.WriteFile("tasks.json", data, permissions).wrap_err("writing tasks.json")?
  Ok(())
}

/// Returns the next available ID (max existing ID + 1).
pub fn next_id(items: Slice<models.Task>) -> int {
  items.fold(0, |max, t| if t.id > max { t.id } else { max }) + 1
}

/// Finds a task by ID.
pub fn find(items: Slice<models.Task>, id: int) -> Option<models.Task> {
  items.find(|t| t.id == id)
}

/// Marks a task as done. Returns an error if the task doesn't exist.
pub fn complete(items: Slice<models.Task>, id: int) -> Result<Slice<models.Task>, error> {
  let Some(_) = find(items, id) else {
    return Err(errors.New(f"task #{id} not found"))
  }
  Ok(items.map(|t| if t.id == id {
    models.Task { status: models.Status.Done, ..t }
  } else {
    t
  }))
}

/// Cancels a task with a reason. Returns an error if the task doesn't exist.
pub fn cancel(items: Slice<models.Task>, id: int, reason: string) -> Result<Slice<models.Task>, error> {
  let Some(_) = find(items, id) else {
    return Err(errors.New(f"task #{id} not found"))
  }
  Ok(items.map(|t| if t.id == id {
    models.Task { status: models.Status.Cancelled(reason), ..t }
  } else {
    t
  }))
}
