{
  "name": "lisette-site",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "npm run generate && astro dev",
    "dev:fresh": "rm -rf .astro node_modules/.astro && npm run dev",
    "build": "npm run generate && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate": "npm run changelog && npm run prelude && npm run chapters",
    "changelog": "node scripts/build-changelog.mjs",
    "prelude": "node scripts/build-prelude.mjs",
    "chapters": "node scripts/build-chapters.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.7",
    "@catppuccin/starlight": "^2.1.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "astro": "^7.2.0",
    "starlight-sidebar-topics": "^0.8.0"
  }
}
