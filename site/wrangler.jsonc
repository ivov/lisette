{
  "name": "lisette-run",
  "main": "worker.js",
  "compatibility_date": "2026-08-24",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/install.sh",
      "/docs",
      "/docs/",
      "/quickstart",
      "/quickstart/"
    ]
  }
}
