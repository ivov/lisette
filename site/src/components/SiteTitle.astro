---
const { siteTitle } = Astro.locals.starlightRoute;
// Starlight points the wordmark at its own base, `/docs`. The landing page sits at the root.
---

<a href="/" class="site-title sl-flex">
  <span translate="no">{siteTitle}</span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: var(--sl-nav-gap);
    color: var(--sl-color-text-accent);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }

  span {
    overflow: hidden;
    font-family: "Lexend", var(--__sl-font);
    font-weight: 600;
    font-size: 1.45rem;
    letter-spacing: -0.02em;
  }
</style>
