---
import { headingSegments } from "../lib/heading-segments.mjs";
import TableOfContentsList from "./TableOfContentsList.astro";

const { toc, entry } = Astro.locals.starlightRoute;
const segments = headingSegments(entry.body);
---

{
  toc && (
    <starlight-toc data-min-h={toc.minHeadingLevel} data-max-h={toc.maxHeadingLevel}>
      <nav aria-labelledby="starlight__on-this-page">
        <h2 id="starlight__on-this-page">{Astro.locals.t("tableOfContents.onThisPage")}</h2>
        <TableOfContentsList toc={toc.items} segments={segments} />
      </nav>
    </starlight-toc>
  )
}

{/* Reached by path because the package does not export it. */}
<script src="../../node_modules/@astrojs/starlight/components-internals/TableOfContents/starlight-toc.ts"
></script>

{/* The scroll-spy marks a heading current once it crosses a band near the top, which a short last section never reaches. At the page bottom the last entry is the right answer, so it is set directly. The delayed repeat catches an observer callback landing after the final scroll. */}
<script>
  const CURRENT = "aria-current";

  const markLastAtBottom = (toc: Element) => {
    const links = [...toc.querySelectorAll("a")];
    const last = links
      .filter((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .at(-1);
    if (!last) return;

    let displaced: HTMLAnchorElement | null = null;
    const label = toc.querySelector(".display-current");
    const show = (link: HTMLAnchorElement) => {
      if (label) label.textContent = link.textContent;
    };

    const sync = () => {
      const atBottom =
        window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      if (atBottom) {
        if (!displaced) {
          displaced = links.find((link) => link.getAttribute(CURRENT) === "true") ?? null;
        }
        for (const link of links) {
          if (link !== last) link.removeAttribute(CURRENT);
        }
        last.setAttribute(CURRENT, "true");
        show(last);
      } else if (displaced) {
        last.removeAttribute(CURRENT);
        displaced.setAttribute(CURRENT, "true");
        show(displaced);
        displaced = null;
      }
    };

    const schedule = () => {
      sync();
      setTimeout(sync, 150);
    };

    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    schedule();
    return () => {
      window.removeEventListener("scroll", schedule);
      window.removeEventListener("resize", schedule);
    };
  };

  const teardowns = new Map<Element, () => void>();
  const markAll = () => {
    for (const toc of document.querySelectorAll("starlight-toc, mobile-starlight-toc")) {
      const teardown = markLastAtBottom(toc);
      if (teardown) teardowns.set(toc, teardown);
    }
  };
  markAll();

  const holder = document.getElementById("changelog-older");
  if (holder) {
    let loading: Promise<void> | undefined;

    const offerRetry = () => {
      const retry = document.createElement("button");
      retry.type = "button";
      retry.textContent = "Could not load older releases. Try again.";
      retry.addEventListener("click", () => loadOlder());
      holder.replaceChildren(retry);
    };

    const loadOlder = () =>
      (loading ??= (async () => {
        nearEnd.disconnect();
        holder.replaceChildren();
        try {
          const response = await fetch(holder.dataset.src!);
          if (!response.ok) throw new Error(String(response.status));
          const range = document.createRange();
          range.selectNode(holder);
          holder.replaceWith(range.createContextualFragment(await response.text()));
        } catch {
          loading = undefined;
          offerRetry();
          return;
        }
        // Starlight's scroll-spy reads the headings only once.
        for (const [toc, teardown] of teardowns) {
          teardown();
          toc.replaceWith(toc.cloneNode(true));
        }
        teardowns.clear();
        markAll();
      })());

    const reveal = async (hash: string) => {
      const id = decodeURIComponent(hash.slice(1));
      if (!id || document.getElementById(id)) return;
      await loadOlder();
      document.getElementById(id)?.scrollIntoView();
    };

    const nearEnd = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) loadOlder();
      },
      { rootMargin: "0px 0px 100% 0px" },
    );
    nearEnd.observe(holder);

    document.addEventListener("keydown", (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "f") loadOlder();
    });

    document.addEventListener("click", (event) => {
      const link = (event.target as Element).closest?.("a[href^='#']");
      if (!link) return;
      const hash = link.getAttribute("href")!;
      if (document.getElementById(decodeURIComponent(hash.slice(1)))) return;
      event.preventDefault();
      history.pushState(null, "", hash);
      reveal(hash);
    });

    if (location.hash) reveal(location.hash);
    window.addEventListener("hashchange", () => reveal(location.hash));
  }
</script>
