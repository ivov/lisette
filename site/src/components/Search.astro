---
/**
 * Arrow keys walk the results. Pagefind's own UI binds only Escape.
 */
import Default from "@astrojs/starlight/components/Search.astro";
---

<Default {...Astro.props} />

<script>
  document.addEventListener("keydown", (event) => {
    if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;

    const dialog = document.querySelector("site-search dialog[open]");
    if (!dialog) return;

    // Read on every press, because the list re-renders on each keystroke.
    const stops = [
      ...dialog.querySelectorAll<HTMLElement>(
        "a.pagefind-ui__result-link, button.pagefind-ui__button",
      ),
    ];
    if (stops.length === 0) return;

    const current = stops.indexOf(document.activeElement as HTMLElement);
    if (current === -1 && event.key === "ArrowUp") return;

    event.preventDefault();

    if (current === 0 && event.key === "ArrowUp") {
      dialog.querySelector("input")?.focus();
      return;
    }

    const next =
      event.key === "ArrowDown" ? Math.min(current + 1, stops.length - 1) : current - 1;
    stops[next]?.focus();
  });
</script>
