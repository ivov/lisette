struct Point { x: int, y: int }

fn test() {
  let mut x = 10;
  x += 5;
  x -= 3;
  x *= 2;
  x /= 4;
  x %= 3;

  let mut bits = 12;
  bits &= 10;
  bits |= 3;
  bits ^= 5;
  bits <<= 2;
  bits >>= 1;
  bits &^= 4;

  let mut p = Point { x: 1, y: 1 };
  p.x = 10;

  let mut arr = [1, 2, 3];
  arr[0] = 100;
}
