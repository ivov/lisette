  ▲ Lost query mutation
   ╭─[test.lis:8:3]
 7 │   let u: MyURL = url.URL { Scheme: "https", Host: "example.com", .. }
 8 │   u.Query().Set("b", "2")
   ·   ───────────┬───────────
   ·              ╰── mutates a discarded copy
 9 │ }
