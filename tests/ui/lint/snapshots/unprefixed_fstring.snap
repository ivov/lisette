  ▲ Unprefixed f-string
   ╭─[test.lis:4:13]
 3 │   let name = "world";
 4 │   let msg = "hello {name}";
   ·             ───────┬──────
   ·                    ╰── `name` will not be interpolated
 5 │   let _ = name;
