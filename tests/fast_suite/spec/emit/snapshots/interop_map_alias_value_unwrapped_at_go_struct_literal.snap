---
package main

import (
	"go/ast"

	lisette "github.com/ivov/lisette/prelude"
)

type Objects = map[string]lisette.Option[*ast.Object]

func scope() ast.Scope {
	none := lisette.MakeOptionNone[int]()
	obj := ast.Object{
		Kind: ast.Bad,
		Name: "x",
		Decl: none,
		Data: none,
		Type: none,
	}
	objects := make(map[string]lisette.Option[*ast.Object])
	objects["present"] = lisette.MakeOptionSome(&obj)
	objects["absent"] = lisette.MakeOptionNone[*ast.Object]()
	unwrapped := make(map[string]*ast.Object, len(objects))
	for i, v := range objects {
		if v.Tag == lisette.OptionSome {
			unwrapped[i] = v.SomeVal
		} else {
			unwrapped[i] = nil
		}
	}
	return ast.Scope{
		Outer:   nil,
		Objects: unwrapped,
	}
}
