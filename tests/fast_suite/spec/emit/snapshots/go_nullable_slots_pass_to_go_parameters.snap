---
source: tests/fast_suite/spec/emit/imports.rs
description: |
  
  import "go:example.com/vars"
  import "go:io"
  
  fn forward() {
    vars.Inspect(vars.Target)
  }
  
  fn forward_parenthesized() {
    vars.Inspect((vars.Target))
  }
  
  fn forward_field(h: mut Ref<vars.Holder>) {
    vars.Inspect(h.Next)
  }
  
  fn forward_pointer_to_value(h: mut Ref<vars.Holder>) {
    vars.Bump(h.Count)
  }
  
  fn forward_nested_interface(h: Ref<vars.Holder>) {
    vars.Scan(h.Writers)
  }
  
  fn forward_interface() {
    vars.Use(vars.Output)
  }
  
  fn takes(w: Option<io.Writer>) -> bool {
    w.is_some()
  }
  
  fn forward_to_lisette() -> bool {
    takes(vars.Output)
  }
---
package main

import (
	"io"

	"example.com/vars"
	lisette "github.com/ivov/lisette/prelude"
)

func forward() {
	vars.Inspect(vars.Target)
}

func forwardParenthesized() {
	vars.Inspect(vars.Target)
}

func forwardField(h *vars.Holder) {
	vars.Inspect(h.Next)
}

func forwardPointerToValue(h *vars.Holder) {
	raw := h.Count
	option := lisette.OptionFromPointer[int](raw)
	var ptr *int
	if option.Tag == lisette.OptionSome {
		ptr = &option.SomeVal
	}
	vars.Bump(ptr)
}

func forwardNestedInterface(h *vars.Holder) {
	raw := h.Writers
	var option lisette.Option[*[]lisette.Option[io.Writer]]
	if raw != nil {
		src := *raw
		wrapped := make([]lisette.Option[io.Writer], len(src))
		for i, v := range src {
			if !lisette.IsNilInterface(v) {
				wrapped[i] = lisette.MakeOptionSome[io.Writer](v)
			} else {
				wrapped[i] = lisette.MakeOptionNone[io.Writer]()
			}
		}
		ref := &wrapped
		option = lisette.MakeOptionSome[*[]lisette.Option[io.Writer]](ref)
	} else {
		option = lisette.MakeOptionNone[*[]lisette.Option[io.Writer]]()
	}
	var unwrap *[]io.Writer
	if option.Tag == lisette.OptionSome {
		src2 := option.SomeVal
		src3 := *src2
		unwrapped := make([]io.Writer, len(src3))
		for i2, v2 := range src3 {
			if v2.Tag == lisette.OptionSome {
				unwrapped[i2] = v2.SomeVal
			}
		}
		ref2 := &unwrapped
		unwrap = ref2
	}
	vars.Scan(unwrap)
}

func forwardInterface() {
	raw := vars.Output
	option := lisette.OptionFromNilable[io.Writer](raw, lisette.IsNilInterface(raw))
	var unwrap io.Writer
	if option.Tag == lisette.OptionSome {
		unwrap = option.SomeVal
	}
	vars.Use(unwrap)
}

func takes(w lisette.Option[io.Writer]) bool {
	return w.IsSome()
}

func forwardToLisette() bool {
	raw := vars.Output
	option := lisette.OptionFromNilable[io.Writer](raw, lisette.IsNilInterface(raw))
	return takes(option)
}
