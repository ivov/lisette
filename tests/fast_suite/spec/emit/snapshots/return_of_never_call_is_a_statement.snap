---
source: tests/fast_suite/spec/emit/functions.rs
description: |
  
  fn diverges() -> Never {
    return diverges()
  }
  
  fn pick(x: int) -> int {
    if x > 5 {
      return diverges()
    }
    x
  }
  
  fn main() {
    let _ = pick(1)
  }
---
package main

func diverges() {
	diverges()
}

func pick(x int) int {
	if x > 5 {
		diverges()
		panic("unreachable")
	}
	return x
}

func main() {
	pick(1)
}
