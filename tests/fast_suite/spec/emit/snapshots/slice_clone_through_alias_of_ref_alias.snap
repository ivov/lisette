---
source: tests/fast_suite/spec/emit/prelude.rs
description: |
  
  type Nums = Slice<int>
  type NumsRef = Ref<Nums>
  fn test(r: NumsRef) -> Slice<int> {
    r.clone()
  }
---
package main

import "slices"

type Nums = []int

type NumsRef = *Nums

func test(r NumsRef) []int {
	return slices.Clone(*r)
}
