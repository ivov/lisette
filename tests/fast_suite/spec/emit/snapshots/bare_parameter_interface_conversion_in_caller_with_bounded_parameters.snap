---
source: tests/fast_suite/spec/emit/types.rs
description: |
  
  interface Holder<X> {
    fn h() -> X
  }
  
  interface Box<U> {
    fn get() -> U
  }
  
  struct Bar<S> {
    s: S,
  }
  
  impl<S> Bar<S> {
    fn get(self) -> Option<S> {
      Some(self.s)
    }
  }
  
  struct IntHolder {}
  
  impl IntHolder {
    fn h(self) -> int {
      1
    }
  }
  
  fn consume<T>(box: Box<Option<T>>) {
    if let Some(v) = box.get() {
      let _ = v
    }
  }
  
  fn pass<U, T: Holder<U>>(b: Bar<T>) {
    consume(b)
  }
  
  fn main() {
    pass<int, IntHolder>(Bar { s: IntHolder {} })
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

type Holder[X any] interface {
	h_() X
}

type Box[U any] interface {
	get_() U
}

type Bar[S any] struct {
	s S
}

func (b Bar[S]) get() (S, bool) {
	return b.s, true
}

func (b Bar[S]) get_() lisette.Option[S] {
	return lisette.OptionFromCommaOk[S](b.get())
}

type IntHolder struct{}

func (i IntHolder) h() int {
	return 1
}

func (i IntHolder) h_() int {
	return i.h()
}

func consume[T any](box Box[lisette.Option[T]]) {
	subject := box.get_()
	if subject.Tag == lisette.OptionSome {
		_ = subject.SomeVal
	}
}

func pass[U any, T Holder[U]](b Bar[T]) {
	consume(b)
}

func main() {
	pass[int, IntHolder](Bar[IntHolder]{s: IntHolder{}})
}
