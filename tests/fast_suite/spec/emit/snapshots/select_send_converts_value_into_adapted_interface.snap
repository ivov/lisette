---
source: tests/fast_suite/spec/emit/go_interface_adapter.rs
description: |
  
  import "go:fmt"
  
  interface Get<T> {
    fn get() -> Option<T>
  }
  
  pub struct X { pub v: int }
  
  pub struct S { pub n: int }
  
  impl S {
    fn get(self) -> Option<Ref<X>> { Some(&X { v: self.n }) }
  }
  
  fn main() {
    let c = Channel.buffered<Get<Ref<X>>>(1)
    select {
      c.send(S { n: 3 }) => fmt.Println("sent"),
    }
  }
---
package main

import (
	"fmt"

	lisette "github.com/ivov/lisette/prelude"
)

type Get[T any] interface {
	get() (T, bool)
}

type X struct {
	V int
}

type S struct {
	N int
}

func (s S) get() *X {
	return &X{V: s.N}
}

func main() {
	c := make(chan Get[*X], 1)
	select {
	case c <- _lisAdapter_S_Get_0{inner: S{N: 3}}:
		fmt.Println("sent")
	}
}

type _lisAdapter_S_Get_0 struct {
	inner S
}

func (a _lisAdapter_S_Get_0) get() (*X, bool) {
	raw := a.inner.get()
	option := lisette.OptionFromNilable[*X](raw, raw == nil)
	if option.Tag == lisette.OptionSome {
		return option.SomeVal, true
	}
	return nil, false
}
