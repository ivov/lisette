---
source: tests/fast_suite/spec/emit/partial.rs
description: |
  
  import "go:io"
  
  interface Base { fn fetch() -> Partial<int, error> }
  interface Child { embed Base }
  struct Source {}
  impl Source {
    fn fetch(self) -> Partial<int, error> { Partial.Both(0, io.EOF) }
  }
  fn main() {
    let c: Child = Source {}
    if !c.fetch().is_both() { panic("lost") }
  }
---
package main

import (
	"io"

	lisette "github.com/ivov/lisette/prelude"
)

type Base interface {
	fetch_() lisette.Partial[int, error]
}

type Child interface {
	Base
}

type Source struct{}

func (s Source) fetch_() lisette.Partial[int, error] {
	return lisette.MakePartialBoth[int, error](0, io.EOF)
}

func (s Source) fetch() (int, error) {
	res := s.fetch_()
	if res.Tag == lisette.PartialOk {
		return res.OkVal, nil
	}
	if res.Tag == lisette.PartialErr {
		return 0, res.ErrVal
	}
	return res.OkVal, res.ErrVal
}

func main() {
	var c Child = Source{}
	if !c.fetch_().IsBoth() {
		panic("lost")
	}
}
