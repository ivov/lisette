---
source: tests/fast_suite/spec/emit/expressions.rs
description: |
  
  fn double(x: int) -> int { x * 2 }
  
  fn describe() -> string {
    let f = double
    f"fn={f} {double}"
  }
---
package main

import "fmt"

func double(x int) int {
	return x * 2
}

func describe() string {
	f := double
	return fmt.Sprintf("fn=%p %p", f, double)
}
