---
package main

import (
	"example.com/dyn"
	lisette "github.com/ivov/lisette/prelude"
)

func main() {
	none := lisette.MakeOptionNone[string]()
	obj := dyn.Bag{
		Decl: "",
		Data: none,
	}
	obj.Decl = none
	_ = obj
}
