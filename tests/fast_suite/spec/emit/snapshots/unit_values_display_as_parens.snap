---
source: tests/fast_suite/spec/emit/expressions.rs
description: |
  
  import "go:fmt"
  
  type Nothing = ()
  
  fn tick(log: mut Ref<Slice<string>>, label: string) {
    log.* = log.*.append(label)
  }
  
  fn name(log: mut Ref<Slice<string>>) -> string {
    log.* = log.*.append("name")
    "n"
  }
  
  fn test() {
    let u = ()
    let n: Nothing = ()
    let r: Result<(), string> = Ok(())
    let e: Result<int, ()> = Err(())
    let o = Some(Some(()))
    let t = ((), 1)
    let k = 2
    let got = f"{u}|x{n}y|{r}|{e}|{o}|{t}|{()} {k}"
    if got != "()|x()y|Ok(())|Err(())|Some(Some(()))|((), 1)|() 2" {
      panic(got)
    }
    let mut log: Slice<string> = []
    let ordered = f"{name(&log)}{tick(&log, "a")}{name(&log)}"
    if ordered != "n()n" || fmt.Sprint(log) != "[name a name]" {
      panic(f"{ordered} {log}")
    }
  }
---
package main

import (
	"fmt"

	lisette "github.com/ivov/lisette/prelude"
)

type Nothing = struct{}

func tick(log *[]string, label string) {
	*log = append(*log, label)
}

func name(log *[]string) string {
	*log = append(*log, "name")
	return "n"
}

func test() {
	r := lisette.MakeResultOk[struct{}, string](struct{}{})
	e := lisette.MakeResultErr[int, struct{}](struct{}{})
	o := lisette.MakeOptionSome(lisette.MakeOptionSome(struct{}{}))
	t := lisette.MakeTuple2[struct{}, int](struct{}{}, 1)
	k := 2
	got := fmt.Sprintf("()|x()y|%v|%v|%v|%v|() %d", r, e, o, t, k)
	if got != "()|x()y|Ok(())|Err(())|Some(Some(()))|((), 1)|() 2" {
		panic(got)
	}
	log := []string{}
	fmtarg := name(&log)
	tick(&log, "a")
	ordered := fmtarg + "()" + name(&log)
	if ordered != "n()n" || fmt.Sprint(log) != "[name a name]" {
		panic(fmt.Sprintf("%s %v", ordered, log))
	}
}
