---
source: tests/fast_suite/spec/emit/control_flow.rs
description: |
  
  enum Event { KeyDown(int), KeyUp(int), Click }
  
  fn if_let(e: Option<Event>) -> int {
    if let Some(Event.KeyDown(c) | Event.KeyUp(c)) = e {
      c
    } else {
      0
    }
  }
  
  fn let_else(e: Option<Event>) -> int {
    let Some(Event.KeyDown(c) | Event.KeyUp(c)) = e else {
      return -1
    }
    c
  }
  
  fn while_let(xs: Slice<Option<Event>>) -> int {
    let mut total = 0
    let mut i = 0
    while let Some(Event.KeyDown(c) | Event.KeyUp(c)) = xs.get(i).flatten() {
      total += c
      i += 1
    }
    total
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

func MakeEventKeyDown(arg0 int) Event {
	return Event{Tag: EventKeyDown, KeyDown: arg0}
}

func MakeEventKeyUp(arg0 int) Event {
	return Event{Tag: EventKeyUp, KeyUp: arg0}
}

func MakeEventClick() Event {
	return Event{Tag: EventClick}
}

type EventTag uint8

const (
	EventKeyDown EventTag = iota
	EventKeyUp
	EventClick
)

type Event struct {
	Tag     EventTag
	KeyDown int
	KeyUp   int
}

func ifLet(e lisette.Option[Event]) int {
	if e.Tag == lisette.OptionSome {
		switch e.SomeVal.Tag {
		case EventKeyDown:
			return e.SomeVal.KeyDown
		case EventKeyUp:
			return e.SomeVal.KeyUp
		default:
			return 0
		}
	}
	return 0
}

func letElse(e lisette.Option[Event]) int {
	var c int
	if e.Tag == lisette.OptionSome && e.SomeVal.Tag == EventKeyDown {
		c = e.SomeVal.KeyDown
	} else if e.Tag == lisette.OptionSome && e.SomeVal.Tag == EventKeyUp {
		c = e.SomeVal.KeyUp
	} else {
		return -1
	}
	return c
}

func whileLet(xs []lisette.Option[Event]) int {
	total := 0
	i := 0
	for {
		subject := lisette.OptionFlatten(lisette.SliceGet(xs, i))
		if subject.Tag == lisette.OptionSome && subject.SomeVal.Tag == EventKeyDown {
			total += subject.SomeVal.KeyDown
			i++
		} else if subject.Tag == lisette.OptionSome && subject.SomeVal.Tag == EventKeyUp {
			total += subject.SomeVal.KeyUp
			i++
		} else {
			break
		}
	}
	return total
}
