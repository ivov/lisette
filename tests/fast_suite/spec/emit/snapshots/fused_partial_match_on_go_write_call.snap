description: |
  
  import "go:os"
  import "go:fmt"
  
  fn write_all(file: Ref<os.File>) {
    match file.Write(['h', 'i']) {
      Ok(n) => fmt.Println(n),
      Both(n, _) => fmt.Println(n),
      Err(e) => {
        fmt.Println(e)
        return
      },
    }
  }
---
package main

import (
	"fmt"
	"os"
)

func writeAll(file *os.File) {
	if n, e := file.Write([]byte{'h', 'i'}); e == nil {
		fmt.Println(n)
	} else {
		fmt.Println(n)
	}
}
