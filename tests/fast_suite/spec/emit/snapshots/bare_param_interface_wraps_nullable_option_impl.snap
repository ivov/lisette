---
source: tests/fast_suite/spec/emit/types.rs
description: |
  
  struct Thing {
    v: int,
  }
  
  interface Box<T> {
    fn get() -> T
  }
  
  struct Bar {}
  
  impl Bar {
    fn get(self) -> Option<Ref<Thing>> {
      None
    }
  }
  
  fn use_box(box: Box<Option<Ref<Thing>>>) {
    match box.get() {
      Some(t) => { let _ = t },
      None => {},
    }
  }
  
  fn main() {
    use_box(Bar {})
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

type Thing struct {
	v int
}

type Box[T any] interface {
	get_() T
}

type Bar struct{}

func (b Bar) get() *Thing {
	return nil
}

func (b Bar) get_() lisette.Option[*Thing] {
	raw := b.get()
	return lisette.OptionFromNilable[*Thing](raw, raw == nil)
}

func useBox(box Box[lisette.Option[*Thing]]) {
	subject := box.get_()
	if subject.Tag == lisette.OptionSome {
		_ = subject.SomeVal
	}
}

func main() {
	useBox(Bar{})
}
