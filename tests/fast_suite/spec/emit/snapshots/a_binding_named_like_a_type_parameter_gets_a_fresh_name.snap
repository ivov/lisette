---
source: tests/fast_suite/spec/emit/control_flow.rs
description: |
  
  import "go:strconv"
  
  fn check<t>(value: t, text: string) -> t {
    match strconv.Atoi(text) {
      Ok(t) => { if t != 4 { panic("number") } },
      Err(_) => { return value },
    }
    let later = || -> t { value }
    later()
  }
  
  fn test() {
    if check(7, "4") != 7 || check(8, "x") != 8 { panic("the renamed binding should keep the parsed number") }
  }
---
package main

import "strconv"

func check[t any](value t, text string) t {
	t2, err := strconv.Atoi(text)
	if err != nil {
		return value
	}
	if t2 != 4 {
		panic("number")
	}
	later := func() t {
		return value
	}
	return later()
}

func test() {
	if check(7, "4") != 7 || check(8, "x") != 8 {
		panic("the renamed binding should keep the parsed number")
	}
}
