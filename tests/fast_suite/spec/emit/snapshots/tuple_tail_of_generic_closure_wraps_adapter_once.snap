---
source: tests/fast_suite/spec/emit/go_interface_adapter.rs
description: |
  
  struct Thing { v: int }
  interface Box<T> { fn get() -> T }
  struct Bar {}
  impl Bar {
    fn get(self) -> Option<Ref<Thing>> { None }
  }
  fn apply<T>(f: fn() -> T) -> T { f() }
  fn main() {
    let pair = apply(|| -> (Box<Option<Ref<Thing>>>, int) { (Bar {}, 2) })
    if pair.0.get().is_some() { panic("expected None") }
    let s: Slice<(Box<Option<Ref<Thing>>>, int)> = [(Bar {}, 3)]
    let _ = s
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

type Thing struct {
	v int
}

type Box[T any] interface {
	get() T
}

type Bar struct{}

func (b Bar) get() *Thing {
	return nil
}

func apply[T any](f func() T) T {
	return f()
}

func main() {
	pair := apply(func() lisette.Tuple2[Box[lisette.Option[*Thing]], int] {
		return lisette.MakeTuple2[Box[lisette.Option[*Thing]], int](_lisAdapter_Bar_Box_0{inner: Bar{}}, 2)
	})
	if pair.First.get().IsSome() {
		panic("expected None")
	}
	tup := lisette.MakeTuple2[Bar, int](Bar{}, 3)
	s := []lisette.Tuple2[Box[lisette.Option[*Thing]], int]{lisette.MakeTuple2[Box[lisette.Option[*Thing]], int](_lisAdapter_Bar_Box_0{inner: tup.First}, tup.Second)}
	_ = s
}

type _lisAdapter_Bar_Box_0 struct {
	inner Bar
}

func (a _lisAdapter_Bar_Box_0) get() lisette.Option[*Thing] {
	raw := a.inner.get()
	return lisette.OptionFromNilable[*Thing](raw, raw == nil)
}
