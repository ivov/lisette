---
source: tests/fast_suite/spec/emit/go_interface_adapter.rs
description: |
  
  interface I<T> { fn get() -> T }
  struct S {}
  impl S { fn get(self) -> Option<int> { None } }
  fn main() {
    let (i, n): (I<Option<int>>, int) = (S {}, 1)
    let _ = i.get()
    let _ = n
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

type I[T any] interface {
	get_() T
}

type S struct{}

func (s S) get() (int, bool) {
	return 0, false
}

func (s S) get_() lisette.Option[int] {
	return lisette.OptionFromCommaOk[int](s.get())
}

func main() {
	tup := lisette.MakeTuple2[S, int](S{}, 1)
	subject := lisette.MakeTuple2[I[lisette.Option[int]], int](tup.First, tup.Second)
	i := subject.First
	i.get_()
}
