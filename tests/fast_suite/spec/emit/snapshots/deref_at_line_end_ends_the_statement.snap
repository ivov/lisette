---
source: tests/fast_suite/spec/emit/expressions.rs
description: |
  
  import "go:fmt"
  
  fn main() {
    let n = 5
    let r = &n
    let m = r.*
    (|| fmt.Println(m))()
  }
---
package main

import (
	"fmt"

	lisette "github.com/ivov/lisette/prelude"
)

func main() {
	n := 5
	r := &n
	m := *r
	func() lisette.Result[int, error] {
		return lisette.ResultFromPair[int](fmt.Println(m))
	}()
}
