---
source: tests/fast_suite/spec/emit/types.rs
description: |
  
  struct Thing { v: int }
  
  interface Box<U> {
    fn get() -> U
  }
  
  struct Bar<S> {
    m: S,
  }
  
  impl<S> Bar<S> {
    fn get(self) -> Option<S> {
      Some(self.m)
    }
  }
  
  fn consume<T>(box: Box<Option<Map<Ref<T>, int>>>) {
    if let Some(v) = box.get() {
      let _ = v
    }
  }
  
  fn pass<T>(b: Bar<Map<Ref<T>, int>>) {
    consume(b)
  }
  
  fn main() {
    let m: Map<Ref<Thing>, int> = Map.new()
    pass(Bar { m: m })
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

type Thing struct {
	v int
}

type Box[U any] interface {
	get_() U
}

type Bar[S any] struct {
	m S
}

func (b Bar[S]) get() (S, bool) {
	return b.m, true
}

func (b Bar[S]) get_() lisette.Option[S] {
	return lisette.OptionFromCommaOk[S](b.get())
}

func consume[T any](box Box[lisette.Option[map[*T]int]]) {
	subject := box.get_()
	if subject.Tag == lisette.OptionSome {
		_ = subject.SomeVal
	}
}

func pass[T any](b Bar[map[*T]int]) {
	consume(b)
}

func main() {
	m := make(map[*Thing]int)
	pass(Bar[map[*Thing]int]{m: m})
}
