---
source: tests/fast_suite/spec/emit/functions.rs
description: |
  
  fn count<arr>(_seed: arr) -> int {
    let values = Array.new<Option<arr>, 2>()
    let mut count = 0
    for value in values { if value.is_none() { count += 1 } }
    count
  }
  fn main() { if count(1) != 2 { panic("generic array helper") } }
---
package main

import lisette "github.com/ivov/lisette/prelude"

func count[arr any](_ arr) int {
	values := [2]lisette.Option[arr]{}
	count2 := 0
	for _, value := range values {
		if value.IsNone() {
			count2++
		}
	}
	return count2
}

func main() {
	if count(1) != 2 {
		panic("generic array helper")
	}
}
