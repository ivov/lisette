---
package main

import "example.com/pb"

func sizes() int {
	m := pb.New()
	f := pb.Msg.XXX_Size
	g := m.XXX_Size
	cb := m.Reset
	var adapted func() struct{}
	if cb != nil {
		adapted = func() struct{} {
			cb()
			return struct{}{}
		}
	}
	reset := adapted
	reset()
	return f(*m) + g() + m.XXX_Size()
}
