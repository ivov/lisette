---
source: tests/fast_suite/spec/emit/go_interface_adapter.rs
description: |
  
  import "go:fmt"
  
  pub interface Named {
    fn name() -> Partial<int, error>
  }
  
  pub interface Labeled {
    fn name() -> Partial<int, error>
  }
  
  type Tag = Named
  
  struct Dog {}
  
  impl Dog {
    pub fn name(self) -> Partial<int, error> {
      Partial.Both(4, fmt.Errorf("eof"))
    }
  }
  
  fn show(n: Labeled) -> Partial<int, error> {
    n.name()
  }
  
  fn label<T: Tag>(t: T) -> Partial<int, error> {
    show(t as Labeled)
  }
  
  fn main() {
    fmt.Println(label(Dog {}))
  }
---
package main

import (
	"fmt"

	lisette "github.com/ivov/lisette/prelude"
)

type Named interface {
	Name_() lisette.Partial[int, error]
}

type Labeled interface {
	Name_() lisette.Partial[int, error]
}

type Tag = Named

type Dog struct{}

func (d Dog) Name_() lisette.Partial[int, error] {
	return lisette.MakePartialBoth[int, error](4, fmt.Errorf("eof"))
}

func (d Dog) Name() (int, error) {
	res := d.Name_()
	if res.Tag == lisette.PartialOk {
		return res.OkVal, nil
	}
	if res.Tag == lisette.PartialErr {
		return 0, res.ErrVal
	}
	return res.OkVal, res.ErrVal
}

func show(n Labeled) lisette.Partial[int, error] {
	return n.Name_()
}

func label[T Named](t T) lisette.Partial[int, error] {
	return show(t)
}

func main() {
	fmt.Println(label(Dog{}))
}
