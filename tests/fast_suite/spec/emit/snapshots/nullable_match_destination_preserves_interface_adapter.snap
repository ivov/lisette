---
source: tests/fast_suite/spec/emit/go_interface_adapter.rs
description: |
  
  struct Thing {}
  
  interface Opt {
    #[go(comma_ok)]
    fn find() -> Option<Ref<Thing>>
  }
  
  struct Bar {
    x: Option<Ref<Thing>>,
  }
  
  impl Bar {
    fn find(self) -> Option<Ref<Thing>> { self.x }
  }
  
  fn maybe_bar(bar: mut Ref<Bar>) -> Option<mut Ref<Bar>> {
    Some(bar)
  }
  
  fn main() {
    let mut bar = Bar { x: Some(&Thing {}) }
    let opt: Opt = match maybe_bar(&bar) {
      Some(found) => found,
      None => { return },
    }
    if let Some(thing) = opt.find() {
      let _ = thing
    }
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

type Thing struct{}

type Opt interface {
	find() (*Thing, bool)
}

type Bar struct {
	x lisette.Option[*Thing]
}

func (b Bar) find() *Thing {
	v := b.x
	if v.Tag == lisette.OptionSome {
		return v.SomeVal
	}
	return nil
}

func maybeBar(bar *Bar) *Bar {
	return bar
}

func main() {
	bar := Bar{x: lisette.MakeOptionSome(&Thing{})}
	var opt Opt
	found := maybeBar(&bar)
	if found == nil {
		return
	}
	opt = _lisAdapter_Bar_Opt_0{inner: found}
	if thing, ok := opt.find(); ok && thing != nil {
		_ = thing
	}
}

type _lisAdapter_Bar_Opt_0 struct {
	inner *Bar
}

func (a _lisAdapter_Bar_Opt_0) find() (*Thing, bool) {
	raw := a.inner.find()
	option := lisette.OptionFromNilable[*Thing](raw, raw == nil)
	if option.Tag == lisette.OptionSome {
		return option.SomeVal, true
	}
	return nil, false
}
