---
source: tests/fast_suite/spec/emit/result_option_patterns.rs
description: |
  
  import "go:net"
  import "go:fmt"
  
  fn test(addr: string) {
    let conn = match net.Dial("tcp", addr) {
      Ok(c) => c,
      Err(e) => {
        fmt.Println("cannot dial")
        return
      },
    }
    let _ = conn
  }
---
package main

import (
	"fmt"
	"net"

	lisette "github.com/ivov/lisette/prelude"
)

func test(addr string) {
	conn, e := net.Dial("tcp", addr)
	if e != nil || lisette.IsNilInterface(conn) {
		fmt.Println("cannot dial")
		return
	}
	_ = conn
}
