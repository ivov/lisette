---
package main

import "fmt"

type Counter struct {
	n int
}

type CounterRef = *Counter

func pick(c CounterRef) CounterRef {
	return c
}

func main() {
	c := Counter{n: 1}
	pick(&c).n = 5
	fmt.Println(c.n)
}
