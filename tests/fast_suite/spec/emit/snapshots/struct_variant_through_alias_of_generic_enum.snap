---
source: tests/fast_suite/spec/emit/types.rs
description: |
  
  enum Shape<T> {
    Dot(T),
    Rect { w: T, h: T },
  }
  
  type IntShape = Shape<int>
  
  fn test() -> IntShape {
    IntShape.Rect { w: 2, h: 3 }
  }
---
package main

func MakeShapeDot[T any](arg0 T) Shape[T] {
	return Shape[T]{Tag: ShapeDot, Dot: arg0}
}

func MakeShapeRect[T any](arg0, arg1 T) Shape[T] {
	return Shape[T]{Tag: ShapeRect, W: arg0, H: arg1}
}

type ShapeTag uint8

const (
	ShapeDot ShapeTag = iota
	ShapeRect
)

type Shape[T any] struct {
	Tag ShapeTag
	Dot T
	W   T
	H   T
}

type IntShape = Shape[int]

func test() IntShape {
	return Shape[int]{
		Tag: ShapeRect,
		W:   2,
		H:   3,
	}
}
