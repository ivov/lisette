---
source: tests/fast_suite/spec/emit/prelude.rs
description: |
  
  type Nums = Slice<int>
  type NumsRef = Ref<Nums>
  fn test(r: NumsRef) -> Option<int> {
    r.get(1)
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

type Nums = []int

type NumsRef = *Nums

func test(r NumsRef) (int, bool) {
	v := lisette.SliceGet(*r, 1)
	if v.Tag == lisette.OptionSome {
		return v.SomeVal, true
	}
	return 0, false
}
