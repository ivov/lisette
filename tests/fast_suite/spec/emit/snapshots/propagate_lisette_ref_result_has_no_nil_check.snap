---
source: tests/fast_suite/spec/emit/result_option_patterns.rs
description: |
  
  struct Point { x: int }
  
  fn f() -> Result<Ref<Point>, error> {
    Ok(&Point { x: 1 })
  }
  
  fn g() -> Result<int, error> {
    let p = f()?
    Ok(p.x)
  }
  
  fn h() -> int {
    match f() {
      Ok(p) => p.x,
      Err(_) => 0,
    }
  }
  
  fn main() {
    let _ = g()
    let _ = h()
  }
---
package main

type Point struct {
	x int
}

func f() (*Point, error) {
	return &Point{x: 1}, nil
}

func g() (int, error) {
	p, err := f()
	if err != nil {
		return 0, err
	}
	return p.x, nil
}

func h() int {
	p, err := f()
	if err != nil {
		return 0
	}
	return p.x
}

func main() {
	g()
	h()
}
