---
source: tests/fast_suite/spec/emit/go_interface_adapter.rs
description: |
  
  import "go:encoding/json"
  import "go:io"
  
  interface Sized {
    embed io.Writer
    fn size() -> int
  }
  
  struct Temp { c: int }
  
  impl Temp {
    pub fn MarshalJSON(self) -> Result<Slice<byte>, error> {
      Ok(f"{self.c}" as Slice<byte>)
    }
    pub fn Write(self, p: Slice<byte>) -> Partial<int, error> {
      Partial.Ok(p.length())
    }
    fn size(self) -> int { self.c }
  }
  
  fn encode<M: json.Marshaler>(m: M) -> Result<Slice<byte>, error> {
    m.MarshalJSON()
  }
  
  fn push<W: Sized>(w: W) -> int {
    match w.Write("hello" as Slice<byte>) {
      Partial.Ok(n) => n + w.size(),
      _ => -1,
    }
  }
  
  fn main() {
    let Ok(b) = encode(Temp { c: 3 }) else { panic("encode failed") }
    if b as string != "3" { panic("wrong encoding") }
    if push(Temp { c: 100 }) != 105 { panic("wrong write count") }
  }
---
package main

import (
	"encoding/json"
	"fmt"
	"io"

	lisette "github.com/ivov/lisette/prelude"
)

type Sized interface {
	io.Writer
	size() int
}

type Temp struct {
	c int
}

func (t Temp) MarshalJSON() ([]byte, error) {
	return []byte(fmt.Sprint(t.c)), nil
}

func (t Temp) Write_(p []byte) lisette.Partial[int, error] {
	return lisette.MakePartialOk[int, error](len(p))
}

func (t Temp) Write(arg0 []byte) (int, error) {
	res := t.Write_(arg0)
	if res.Tag == lisette.PartialOk {
		return res.OkVal, nil
	}
	if res.Tag == lisette.PartialErr {
		return 0, res.ErrVal
	}
	return res.OkVal, res.ErrVal
}

func (t Temp) size() int {
	return t.c
}

func encode[M json.Marshaler](m M) ([]byte, error) {
	return m.MarshalJSON()
}

func push[W Sized](w W) int {
	n, err := w.Write([]byte("hello"))
	if err != nil {
		return -1
	}
	return n + w.size()
}

func main() {
	b, err := encode(Temp{c: 3})
	if err != nil {
		panic("encode failed")
	}
	if string(b) != "3" {
		panic("wrong encoding")
	}
	if push(Temp{c: 100}) != 105 {
		panic("wrong write count")
	}
}
