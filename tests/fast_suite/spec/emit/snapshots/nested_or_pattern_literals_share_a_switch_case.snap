---
source: tests/fast_suite/spec/emit/control_flow.rs
description: |
  
  fn size(n: Option<int>) -> string {
    match n {
      Some(1 | 2) => "small",
      Some(3) => "three",
      _ => "other",
    }
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

func size(n lisette.Option[int]) string {
	if n.Tag == lisette.OptionSome {
		switch n.SomeVal {
		case 1, 2:
			return "small"
		case 3:
			return "three"
		default:
			return "other"
		}
	}
	return "other"
}
