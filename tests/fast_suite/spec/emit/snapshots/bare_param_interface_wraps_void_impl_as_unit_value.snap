---
source: tests/fast_suite/spec/emit/types.rs
description: |
  
  interface Box<T> {
    fn get() -> T
  }
  
  struct Bar {}
  
  impl Bar {
    fn get(self) {}
  }
  
  fn consume(box: Box<()>) {
    let _ = box.get()
  }
  
  fn main() {
    consume(Bar {})
  }
---
package main

type Box[T any] interface {
	get_() T
}

type Bar struct{}

func (b Bar) get() {}

func (b Bar) get_() struct{} {
	b.get()
	return struct{}{}
}

func consume(box Box[struct{}]) {
	box.get_()
}

func main() {
	consume(Bar{})
}
