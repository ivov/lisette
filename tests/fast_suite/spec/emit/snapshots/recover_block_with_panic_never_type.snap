  }
  
  fn test() {
    let result = recover { panicky() };
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

func panicky() int {
	arr := []int{}
	return arr[0]
}

func test() {
	lisette.RecoverBlock(func() int {
		return panicky()
	})
}
