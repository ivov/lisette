---
source: tests/fast_suite/spec/emit/patterns.rs
description: |
  
  enum Shape<T> {
    Dot(T),
    Rect { w: T, h: T },
  }
  
  fn width(s: Shape<Option<int>>) -> int {
    match s {
      Shape.Rect { w: Some(w), h: _ } => w,
      Shape.Rect { w: None, h: _ } => 0,
      Shape.Dot(_) => 1,
    }
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

func MakeShapeDot[T any](arg0 T) Shape[T] {
	return Shape[T]{Tag: ShapeDot, Dot: arg0}
}

func MakeShapeRect[T any](arg0, arg1 T) Shape[T] {
	return Shape[T]{Tag: ShapeRect, W: arg0, H: arg1}
}

type ShapeTag uint8

const (
	ShapeDot ShapeTag = iota
	ShapeRect
)

type Shape[T any] struct {
	Tag ShapeTag
	Dot T
	W   T
	H   T
}

func width(s Shape[lisette.Option[int]]) int {
	if s.Tag == ShapeRect {
		if s.W.Tag == lisette.OptionSome {
			return s.W.SomeVal
		}
		return 0
	}
	return 1
}
