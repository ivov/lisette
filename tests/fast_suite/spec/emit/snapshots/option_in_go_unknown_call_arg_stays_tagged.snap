---
source: tests/fast_suite/spec/emit/types.rs
description: |
  
  import "go:example.com/dyn"
  
  fn main() {
    let none: Option<int> = None
    let _ = dyn.Store("k", none)
    let _ = dyn.Store("k", Some(1))
  }
---
package main

import (
	"example.com/dyn"
	lisette "github.com/ivov/lisette/prelude"
)

func main() {
	none := lisette.MakeOptionNone[int]()
	dyn.Store("k", none)
	dyn.Store("k", lisette.MakeOptionSome(1))
}
