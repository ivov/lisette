---
source: tests/fast_suite/spec/emit/functions.rs
description: |
  
  import "go:fmt"
  
  struct Box<T> { value: T }
  
  impl<T> Box<T> {
    fn log2(self, args: VarArgs<Unknown>) {
      fmt.Println(args...)
    }
  }
  
  fn main() {
    let bx = Box { value: 1 }
    let xs = [1, 2]
    bx.log2(xs...)
    Box.log2(bx, xs...)
    let mut ys: Slice<Unknown> = []
    ys = ys.append(xs...)
    fmt.Println(ys.length())
  }
---
package main

import (
	"fmt"

	lisette "github.com/ivov/lisette/prelude"
)

type Box[T any] struct {
	value T
}

func (b Box[T]) log2(args ...any) {
	fmt.Println(args...)
}

func main() {
	bx := Box[int]{value: 1}
	xs := []int{1, 2}
	bx.log2(lisette.SliceToAny(xs)...)
	bx.log2(lisette.SliceToAny(xs)...)
	ys := []any{}
	ys = append(ys, lisette.SliceToAny(xs)...)
	fmt.Println(len(ys))
}
