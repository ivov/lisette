---
source: tests/fast_suite/spec/emit/functions.rs
description: |
  
  import "go:runtime/debug"
  fn main(){let mut child=debug.Module{Path:"child",..};let h=debug.Module{Replace:Some(&child),..};let out=match (h,7){(debug.Module{Replace:Some(r),..},0)|(debug.Module{Replace:Some(r),..},7)=>r.Path,_=>"none"};if out!="child"{panic("or")}}
---
package main

import (
	"runtime/debug"

	lisette "github.com/ivov/lisette/prelude"
)

func main() {
	child := debug.Module{Path: "child"}
	h := debug.Module{Replace: &child}
	var out string
	subject := lisette.MakeTuple2[debug.Module, int](h, 7)
	if subject.First.Replace != nil && subject.Second == 0 {
		out = subject.First.Replace.Path
	} else if subject.First.Replace != nil && subject.Second == 7 {
		out = subject.First.Replace.Path
	} else {
		out = "none"
	}
	if out != "child" {
		panic("or")
	}
}
