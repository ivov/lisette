---
source: tests/fast_suite/spec/emit/types.rs
description: |
  
  import "go:example.com/dyn"
  
  fn main() {
    let none: Option<string> = None
    let _ = dyn.Bag {
      Decl: Some("decl"),
      Data: none,
    }
  }
---
package main

import (
	"example.com/dyn"
	lisette "github.com/ivov/lisette/prelude"
)

func main() {
	none := lisette.MakeOptionNone[string]()
	_ = dyn.Bag{
		Decl: lisette.MakeOptionSome("decl"),
		Data: none,
	}
}
