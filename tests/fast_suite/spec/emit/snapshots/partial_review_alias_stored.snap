---
source: tests/fast_suite/spec/emit/functions.rs
description: |
  
  import "go:io"
  
  type Answer = Partial<int, error>
  interface Base { fn fetch(fail: bool) -> Answer }
  interface Child { embed Base }
  type Face = Child
  struct Source {}
  impl Source {
    fn fetch(self, fail: bool) -> Answer {
      if fail { Partial.Err(io.EOF) } else { Partial.Both(0, io.EOF) }
    }
  }
  fn capture<T: Face>(source: T, fail: bool) -> Answer {
    let fetch = source.fetch
    fetch(fail)
  }
  fn main() {
    let both = capture(Source {}, false)
    if !both.is_both() { panic("lost Both tag") }
    let err = capture(Source {}, true)
    if !err.is_err() { panic("Err through a method lost its tag") }
  }
---
package main

import (
	"io"

	lisette "github.com/ivov/lisette/prelude"
)

type Answer = lisette.Partial[int, error]

type Base interface {
	fetch_(bool) Answer
}

type Child interface {
	Base
}

type Face = Child

type Source struct{}

func (s Source) fetch_(fail bool) Answer {
	if fail {
		return lisette.MakePartialErr[int, error](io.EOF)
	}
	return lisette.MakePartialBoth[int, error](0, io.EOF)
}

func (s Source) fetch(arg0 bool) (int, error) {
	res := s.fetch_(arg0)
	if res.Tag == lisette.PartialOk {
		return res.OkVal, nil
	}
	if res.Tag == lisette.PartialErr {
		return 0, res.ErrVal
	}
	return res.OkVal, res.ErrVal
}

func capture[T Child](source T, fail bool) Answer {
	fetch := source.fetch_
	return fetch(fail)
}

func main() {
	both := capture(Source{}, false)
	if !both.IsBoth() {
		panic("lost Both tag")
	}
	err := capture(Source{}, true)
	if !err.IsErr() {
		panic("Err through a method lost its tag")
	}
}
