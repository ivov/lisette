---
source: tests/fast_suite/spec/emit/expressions.rs
description: |
  import "go:fmt"
  struct Data { n: int }
  fn inspect(value: Ref<Data>) -> int { value.n }
  fn bump(value: mut Ref<Data>) -> int { value.n += 1; value.n }
  fn main() {
      let mut data = Data { n: 1 }
      let triple = (inspect(&data), data, bump(&data))
      fmt.Println(triple.0, triple.1.n, triple.2)
  }
---
package main

import (
	"fmt"

	lisette "github.com/ivov/lisette/prelude"
)

type Data struct {
	n int
}

func inspect(value *Data) int {
	return value.n
}

func bump(value *Data) int {
	value.n++
	return value.n
}

func main() {
	data := Data{n: 1}
	v := inspect(&data)
	v2 := data
	triple := lisette.MakeTuple3[int, Data, int](v, v2, bump(&data))
	fmt.Println(triple.First, triple.Second.n, triple.Third)
}
