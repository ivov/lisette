---
source: tests/fast_suite/spec/emit/functions.rs
description: |
  
  import "go:fmt"
  
  interface Getter<T> {
    fn get() -> T
  }
  
  struct Box {
    n: int,
  }
  
  type Crate = Box
  
  impl Box {
    fn get(self) -> Result<int, error> {
      Ok(self.n)
    }
  }
  
  fn use_getter<G: Getter<Result<int, error>>>(g: G) -> Result<int, error> {
    g.get()
  }
  
  fn take(f: fn() -> Result<int, error>) -> Result<int, error> {
    f()
  }
  
  fn main() {
    let b: Crate = Box { n: 1 }
    let _ = use_getter(b)
    let g = b.get
    fmt.Println(take(g))
  }
---
package main

import (
	"fmt"

	lisette "github.com/ivov/lisette/prelude"
)

type Getter[T any] interface {
	get_() T
}

type Box struct {
	n int
}

type Crate = Box

func (b Box) get() (int, error) {
	return b.n, nil
}

func (b Box) get_() lisette.Result[int, error] {
	return lisette.ResultFromPair[int](b.get())
}

func useGetter[G Getter[lisette.Result[int, error]]](g G) (int, error) {
	v := g.get_()
	if v.Tag == lisette.ResultOk {
		return v.OkVal, nil
	}
	return 0, v.ErrVal
}

func take(f func() lisette.Result[int, error]) (int, error) {
	v := f()
	if v.Tag == lisette.ResultOk {
		return v.OkVal, nil
	}
	return 0, v.ErrVal
}

func main() {
	b := Box{n: 1}
	useGetter(b)
	g := b.get_
	fmt.Println(lisette.ResultFromPair[int](take(g)))
}
