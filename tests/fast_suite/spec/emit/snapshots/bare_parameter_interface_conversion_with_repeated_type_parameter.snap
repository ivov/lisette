---
source: tests/fast_suite/spec/emit/types.rs
description: |
  
  interface Box<U> {
    fn get() -> U
  }
  
  struct Pair<A, B> {
    a: A,
    b: B,
  }
  
  impl<A, B> Pair<A, B> {
    fn get(self) -> Option<A> {
      Some(self.a)
    }
  }
  
  fn consume<T>(box: Box<Option<T>>) {
    if let Some(v) = box.get() {
      let _ = v
    }
  }
  
  fn pass<T>(p: Pair<T, T>) {
    consume(p)
  }
  
  fn main() {
    pass(Pair { a: 1, b: 2 })
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

type Box[U any] interface {
	get_() U
}

type Pair[A any, B any] struct {
	a A
	b B
}

func (p Pair[A, B]) get() (A, bool) {
	return p.a, true
}

func (p Pair[A, B]) get_() lisette.Option[A] {
	return lisette.OptionFromCommaOk[A](p.get())
}

func consume[T any](box Box[lisette.Option[T]]) {
	subject := box.get_()
	if subject.Tag == lisette.OptionSome {
		_ = subject.SomeVal
	}
}

func pass[T any](p Pair[T, T]) {
	consume(p)
}

func main() {
	pass(Pair[int, int]{
		a: 1,
		b: 2,
	})
}
