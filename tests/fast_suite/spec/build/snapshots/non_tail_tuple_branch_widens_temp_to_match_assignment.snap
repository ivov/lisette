// === main.go ===
package main

import (
	"io"

	lisette "github.com/ivov/lisette/prelude"
)

type Reader1 struct{}

type Reader2 struct{}

func (r Reader1) Read_(_ []uint8) lisette.Partial[int, error] {
	return lisette.MakePartialOk[int, error](0)
}

func (r Reader1) Read(arg0 []uint8) (int, error) {
	res := r.Read_(arg0)
	if res.Tag == lisette.PartialOk {
		return res.OkVal, nil
	}
	if res.Tag == lisette.PartialErr {
		return 0, res.ErrVal
	}
	return res.OkVal, res.ErrVal
}

func (r Reader2) Read_(_ []uint8) lisette.Partial[int, error] {
	return lisette.MakePartialOk[int, error](1)
}

func (r Reader2) Read(arg0 []uint8) (int, error) {
	res := r.Read_(arg0)
	if res.Tag == lisette.PartialOk {
		return res.OkVal, nil
	}
	if res.Tag == lisette.PartialErr {
		return 0, res.ErrVal
	}
	return res.OkVal, res.ErrVal
}

func pick(flag bool) (io.Reader, int) {
	var result lisette.Tuple2[io.Reader, int]
	if flag {
		tup := lisette.MakeTuple2[Reader1, int](Reader1{}, 1)
		result = lisette.MakeTuple2[io.Reader, int](tup.First, tup.Second)
	} else {
		tup2 := lisette.MakeTuple2[Reader2, int](Reader2{}, 2)
		result = lisette.MakeTuple2[io.Reader, int](tup2.First, tup2.Second)
	}
	tup3 := result
	return tup3.First, tup3.Second
}

func main() {
	pick(true)
}
