// === main.go ===
package main

import (
	"io"

	lisette "github.com/ivov/lisette/prelude"
)

type Reader struct{}

func (r Reader) Read_(_ []uint8) lisette.Partial[int, error] {
	return lisette.MakePartialBoth[int, error](0, io.EOF)
}

func (r Reader) Read(arg0 []uint8) (int, error) {
	res := r.Read_(arg0)
	if res.Tag == lisette.PartialOk {
		return res.OkVal, nil
	}
	if res.Tag == lisette.PartialErr {
		return 0, res.ErrVal
	}
	return res.OkVal, res.ErrVal
}

func useReader(r io.Reader) int {
	_ = r
	return 0
}

func main() {
	r := Reader{}
	useReader(r)
}
