  ✕ Non-exhaustive select expression
    ╭─[test.lis:8:13]
  7 │       }
  8 │ ╭─▶   let got = select {
  9 │ │       let Some(v) = rx.receive() => v,
 10 │ ├─▶   }
    · ╰──── may not produce a value
 11 │       let _ = got
