  ▲ Float equality without `abs`
   ╭─[test.lis:6:11]
 5 │   let b: Score = 2.0
 6 │   let _ = (a - b) < 0.001
   ·           ───────┬───────
   ·                  ╰── difference is not wrapped in `math.Abs`
 7 │ }
