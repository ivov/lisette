
import "go:fmt"

fn make() -> Result<Slice<Option<string>>, error> {
  Ok([Some("hi"), None])
}

fn main() {
  let r = make()
  match r {
    Ok(xs) => {
      for x in xs {
        match None {
          Some(v) => fmt.Println(v),
          None => fmt.Println(1),
        }
      }
    },
    Err(e) => { let _ = e },
  }
}
