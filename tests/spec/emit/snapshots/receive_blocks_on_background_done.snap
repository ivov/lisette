---
source: tests/spec/emit/concurrency.rs
description: |
  
  import "go:context"
  import "go:time"
  
  fn test() {
    let started = Channel.buffered<bool>(1)
    let ended = Channel.buffered<bool>(1)
    task {
      started.send(true)
      let _ = context.Background().Done().receive()
      ended.send(true)
    }
    let _ = started.receive()
    time.Sleep(100 * time.Millisecond)
    select {
      ended.receive() => panic("Background().Done() can never deliver, so receive must block"),
      _ => {},
    }
  }
---
package main

import (
	"context"
	"time"

	lisette "github.com/ivov/lisette/prelude"
)

func test() {
	started := make(chan bool, 1)
	ended := make(chan bool, 1)
	go func() {
		lisette.ChannelSend(started, true)
		lisette.ReceiverReceive(context.Background().Done())
		lisette.ChannelSend(ended, true)
	}()
	lisette.ChannelReceive(started)
	time.Sleep(100 * time.Millisecond)
	select {
	case <-ended:
		panic("Background().Done() can never deliver, so receive must block")
	default:
	}
}
