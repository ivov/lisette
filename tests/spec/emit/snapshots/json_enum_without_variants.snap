package main

import (
	"errors"
	"fmt"
)

type NothingTag uint8
type Nothing struct {
	Tag NothingTag
}

func (n Nothing) MarshalJSON() ([]byte, error) {
	switch n.Tag {
	default:
		return nil, fmt.Errorf("unknown Nothing tag: %d", n.Tag)
	}
}

func (n *Nothing) UnmarshalJSON(data []byte) error {
	return errors.New("invalid Nothing JSON")
}
