---
source: tests/spec/emit/partial.rs
description: |
  
  import "go:io"
  import "go:strings"
  
  fn read(s: string) -> Result<int, error> {
    let body = s
    let body = match io.ReadAll(strings.NewReader(body)) {
      Partial.Ok(b) => b,
      Partial.Both(_, e) | Partial.Err(e) => return Err(e),
    }
    Ok(body.length())
  }
---
package main

import (
	"io"
	"strings"
)

func read(s string) (int, error) {
	body := s
	body2, e := io.ReadAll(strings.NewReader(body))
	if e != nil {
		return 0, e
	}
	return len(body2), nil
}
