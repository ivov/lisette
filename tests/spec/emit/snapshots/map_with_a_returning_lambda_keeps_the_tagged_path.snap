---
source: tests/spec/emit/result_option_patterns.rs
description: |
  
  import "go:fmt"
  import "go:os"
  
  fn main() {
    let shown = os.LookupEnv("HOME").map(|h| { return "home=" + h }).unwrap_or("unset")
    fmt.Println(shown)
  }
---
package main

import (
	"fmt"
	"os"

	lisette "github.com/ivov/lisette/prelude"
)

func main() {
	shown := lisette.OptionMap(lisette.OptionFromCommaOk[string](os.LookupEnv("HOME")), func(h string) string {
		return "home=" + h
	}).UnwrapOr("unset")
	fmt.Println(shown)
}
