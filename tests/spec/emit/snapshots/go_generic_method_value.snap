---
package main

import (
	"encoding/json"
	"fmt"
	lisette "github.com/ivov/lisette/prelude"
	"strings"
)

func main() {
	decoder := json.NewDecoder(strings.NewReader("1"))
	cb := decoder.Decode
	var adapted func(*int) lisette.Result[struct{}, error]
	if cb != nil {
		adapted = func(arg0 *int) lisette.Result[struct{}, error] {
			ret := cb(arg0)
			if ret != nil {
				return lisette.MakeResultErr[struct{}, error](ret)
			}
			return lisette.MakeResultOk[struct{}, error](struct{}{})
		}
	}
	decode := adapted
	n := 0
	result := decode(&n)
	fmt.Println(result.IsOk(), n)
}
