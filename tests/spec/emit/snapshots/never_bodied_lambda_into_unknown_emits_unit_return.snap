---
source: tests/spec/emit/functions.rs
description: |
  
  fn take_any(x: Unknown) {}
  
  fn test() {
    take_any(|| { panic("boom") })
  }
---
package main

func takeAny(_ any) {}

func test() {
	cb := func() struct{} {
		panic("boom")
	}
	var adapted func()
	if cb != nil {
		adapted = func() {
			cb()
		}
	}
	takeAny(adapted)
}
