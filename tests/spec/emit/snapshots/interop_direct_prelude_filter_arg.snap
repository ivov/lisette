---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:unicode"
  
  fn main() {
    let cs: Slice<rune> = ['a', '1']
    let letters = cs.filter(unicode.IsLetter)
    let _ = letters
  }
---
package main

import "unicode"

func main() {
	cs := []rune{'a', '1'}
	var letters []rune
	for _, v := range cs {
		if unicode.IsLetter(v) {
			letters = append(letters, v)
		}
	}
	_ = letters
}
