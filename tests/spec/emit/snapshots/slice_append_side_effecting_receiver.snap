---
source: tests/spec/emit/expressions.rs
description: |
  
  fn make_i() -> int { 0 }
  
  fn main() {
    let mut outer = [[1], [2], [3]]
    outer[make_i()] = outer[make_i()].append(4)
  }
---
package main

import "slices"

func makeI() int {
	return 0
}

func main() {
	outer := [][]int{{1}, {2}, {3}}
	base := outer
	idx := makeI()
	recv := outer[makeI()]
	base[idx] = append(slices.Clip(recv), 4)
}
