---
package main

import (
	"example.com/idx"
	lisette "github.com/ivov/lisette/prelude"
)

func makeFinder() func(string, string) lisette.Option[int] {
	return func(arg0, arg1 string) lisette.Option[int] {
		ret := idx.Find(arg0, arg1)
		return lisette.OptionFromCommaOk[int](ret, ret != -1)
	}
}

func main() {
	f := makeFinder()
	r := f("hello", "ll")
	if r.Tag == lisette.OptionSome {
		_ = r.SomeVal
	} else {
		_ = -2
	}
}
