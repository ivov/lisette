---
package main

import "example.com/idx"

func makeFinder() func(string, string) (int, bool) {
	return func(arg0, arg1 string) (int, bool) {
		ret := idx.Find(arg0, arg1)
		return ret, ret != -1
	}
}

func main() {
	f := makeFinder()
	r, ok := f("hello", "ll")
	v := r
	if ok {
		_ = v
	} else {
		_ = -2
	}
}
