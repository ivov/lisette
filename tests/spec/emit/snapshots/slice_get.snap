---
source: tests/spec/emit/prelude.rs
description: |
  
  fn test(s: Slice<int>, i: int) -> Option<int> {
    s.get(i)
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

func test(s []int, i int) (int, bool) {
	v := lisette.SliceGet(s, i)
	if v.Tag == lisette.OptionSome {
		return v.SomeVal, true
	}
	return 0, false
}
