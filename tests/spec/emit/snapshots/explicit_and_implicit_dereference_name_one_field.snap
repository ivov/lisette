---
source: tests/spec/emit/expressions.rs
description: |
  
  struct Counter { value: int }
  
  impl Counter {
    fn increment(self: mut Ref<Counter>) {
      self.*.value = self.value + 1
    }
  }
---
package main

type Counter struct {
	value int
}

func (c *Counter) increment() {
	c.value++
}
