---
source: tests/spec/emit/functions.rs
description: |
  
  import "go:fmt"
  import "go:strconv"
  
  fn main() {
    let cond = true
    let f = if cond { strconv.Atoi } else { strconv.Atoi }
    let r = f("99")
    fmt.Println(r)
  }
---
package main

import (
	"fmt"
	lisette "github.com/ivov/lisette/prelude"
	"strconv"
)

func main() {
	cond := true
	var f func(string) lisette.Result[int, error]
	if cond {
		f = func(arg0 string) lisette.Result[int, error] {
			return lisette.ResultFromPair[int](strconv.Atoi(arg0))
		}
	} else {
		f = func(arg0 string) lisette.Result[int, error] {
			return lisette.ResultFromPair[int](strconv.Atoi(arg0))
		}
	}
	r := f("99")
	fmt.Println(r)
}
