---
source: tests/spec/emit/concurrency.rs
description: |
  
  fn test() {
    let ch = Channel.buffered<int>(5)
    ch.send(1)
    ch.send(-1)
    ch.send(2)
    ch.send(-2)
    ch.send(4)
    ch.close()
    let mut total = 0
    for v in ch {
      if v == -1 { continue }
      if v == -2 { break }
      total += v
    }
    if total != 3 {
      panic(f"expected 3, got {total}")
    }
  }
---
package main

import (
	"fmt"
	lisette "github.com/ivov/lisette/prelude"
)

func test() {
	ch := make(chan int, 5)
	_ = lisette.ChannelSend(ch, 1)
	_ = lisette.ChannelSend(ch, -1)
	_ = lisette.ChannelSend(ch, 2)
	_ = lisette.ChannelSend(ch, -2)
	_ = lisette.ChannelSend(ch, 4)
	lisette.ChannelClose(ch)
	total := 0
	if ch != nil {
		for v := range ch {
			if v == -1 {
				continue
			}
			if v == -2 {
				break
			}
			total += v
		}
	}
	if total != 3 {
		panic(fmt.Sprintf("expected 3, got %d", total))
	}
}
