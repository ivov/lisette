---
source: tests/spec/emit/functions.rs
description: |
  
  fn count<s>(_seed: s) -> int { Slice.make<Option<s>>(2).length() }
  fn count_index<i>(_seed: i) -> int { Slice.make<Option<i>>(3).length() }
  fn main() { if count(1) != 2 || count_index(1) != 3 { panic("generic slice helper") } }
---
package main

import lisette "github.com/ivov/lisette/prelude"

func count[s any](_ s) int {
	return len(func() []lisette.Option[s] {
		s_1 := make([]lisette.Option[s], 2)
		for i := range s_1 {
			s_1[i] = lisette.MakeOptionNone[s]()
		}
		return s_1
	}())
}

func countIndex[i any](_ i) int {
	return len(func() []lisette.Option[i] {
		s := make([]lisette.Option[i], 3)
		for i_1 := range s {
			s[i_1] = lisette.MakeOptionNone[i]()
		}
		return s
	}())
}

func main() {
	if count(1) != 2 || countIndex(1) != 3 {
		panic("generic slice helper")
	}
}
