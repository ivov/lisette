---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:os"
  
  fn make_lookup() -> fn(string) -> Option<string> {
    os.LookupEnv
  }
  
  fn main() {
    let f = make_lookup()
    let r = f("HOME")
    match r {
      Some(v) => { let _ = v },
      None => { let _ = "" },
    }
  }
---
package main

import (
	lisette "github.com/ivov/lisette/prelude"
	"os"
)

func makeLookup() func(string) lisette.Option[string] {
	return func(arg0 string) lisette.Option[string] {
		return lisette.OptionFromCommaOk[string](os.LookupEnv(arg0))
	}
}

func main() {
	f := makeLookup()
	r := f("HOME")
	if r.Tag == lisette.OptionSome {
		_ = r.SomeVal
	}
}
