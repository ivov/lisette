  }
---
package main

import "strings"

func parts(s string) []string {
	return strings.Split(s, ",")
}

func first(topic string) string {
	return strings.SplitN(topic, "?", 2)[0]
}

func at(s string, i int) string {
	return parts(s)[i]
}

func moving(s string) string {
	i := 0
	bump := func() int {
		i++
		return i
	}
	base := parts(s)
	x := base[i]
	base_1 := parts(s)
	return x + base_1[bump()]
}

func splitAt(s string, a, b int) string {
	base := parts(s)
	return base[a/b]
}
