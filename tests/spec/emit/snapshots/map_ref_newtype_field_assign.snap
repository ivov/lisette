---
source: tests/spec/emit/expressions.rs
description: |
  
  struct Wrap(int)
  
  fn main() {
    let mut w = Wrap(1)
    let mut m = Map.new<string, Ref<Wrap>>()
    m["a"] = &w
    let Some(r) = m.get("a") else { return; };
    r.* = Wrap(2)
    let _ = w
  }
---
package main

type Wrap int

func main() {
	w := Wrap(1)
	m := make(map[string]*Wrap)
	m["a"] = &w
	r, ok_1 := m["a"]
	if !ok_1 {
		return
	}
	*r = Wrap(2)
	_ = w
}
