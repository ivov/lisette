---
source: tests/spec/emit/functions.rs
description: |
  
  import "go:mime"
  
  fn use_fn(f: fn(string) -> Partial<(string, Map<string, string>), error>) {
    let _ = f("text/plain")
  }
  
  fn main() {
    use_fn(mime.ParseMediaType)
  }
---
package main

import (
	lisette "github.com/ivov/lisette/prelude"
	"mime"
)

func useFn(f func(string) lisette.Partial[lisette.Tuple2[string, map[string]string], error]) {
	f("text/plain")
}

func main() {
	cb := mime.ParseMediaType
	var adapted func(string) lisette.Partial[lisette.Tuple2[string, map[string]string], error]
	if cb != nil {
		adapted = func(arg0 string) lisette.Partial[lisette.Tuple2[string, map[string]string], error] {
			ret, ret_1, ret_2 := cb(arg0)
			tup := lisette.MakeTuple2(ret, ret_1)
			if ret_2 != nil {
				return lisette.MakePartialBoth[lisette.Tuple2[string, map[string]string], error](tup, ret_2)
			}
			return lisette.MakePartialOk[lisette.Tuple2[string, map[string]string], error](tup)
		}
	}
	useFn(adapted)
}
