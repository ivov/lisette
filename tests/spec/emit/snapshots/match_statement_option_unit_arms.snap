---
source: tests/spec/emit/result_option_patterns.rs
description: |
  
  fn noop() {}
  
  fn maybe(b: bool) -> Option<int> {
    if b { Some(42) } else { None }
  }
  
  fn test() {
    match maybe(true) {
      Some(_) => noop(),
      None => noop(),
    }
  }
---
package main

func noop() {}

func maybe(b bool) (int, bool) {
	if b {
		return 42, true
	}
	return 0, false
}

func test() {
	_, ok_1 := maybe(true)
	if ok_1 {
		noop()
	} else {
		noop()
	}
}
