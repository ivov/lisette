---
source: tests/spec/emit/result_option_patterns.rs
description: |
  
  fn pick(n: int) -> Option<int> { if n < 0 { None } else { Some(n) } }
  
  fn test() -> int {
    match pick(3) {
      Some(0) | None => 0,
      Some(v) => v,
    }
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

func pick(n int) (int, bool) {
	if n < 0 {
		return 0, false
	}
	return n, true
}

func test() int {
	option := lisette.OptionFromCommaOk[int](pick(3))
	if option.Tag == lisette.OptionSome && option.SomeVal == 0 || option.Tag == lisette.OptionNone {
		return 0
	}
	return option.SomeVal
}
