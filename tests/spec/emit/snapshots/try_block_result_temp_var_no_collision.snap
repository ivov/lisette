---
source: tests/spec/emit/result_option_patterns.rs
description: |
  
  fn foo() -> Result<int, string> {
    let result = try {
      Ok(1)?
    }
    let tryResult_1 = 7
    let _ = tryResult_1
    Ok(0)
  }
  
  fn main() {
    let _ = foo()
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

func foo() lisette.Result[int, string] {
	tryResult := func() lisette.Result[int, any] {
		check := lisette.MakeResultOk[int, any](1)
		if check.Tag != lisette.ResultOk {
			return check
		}
		return lisette.MakeResultOk[int, any](check.OkVal)
	}()
	_ = tryResult
	return lisette.MakeResultOk[int, string](0)
}

func main() {
	foo()
}
