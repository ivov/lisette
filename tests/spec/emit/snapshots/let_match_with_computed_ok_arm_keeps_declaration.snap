---
source: tests/spec/emit/result_option_patterns.rs
description: |
  
  import "go:os"
  import "go:fmt"
  
  fn test(name: string) {
    let label = match os.Open(name) {
      Ok(f) => f.Name(),
      Err(e) => {
        fmt.Println("cannot open")
        return
      },
    }
    fmt.Println(label)
  }
---
package main

import (
	"fmt"
	"os"
)

func test(name string) {
	var label string
	f, err := os.Open(name)
	if err != nil || f == nil {
		fmt.Println("cannot open")
		return
	}
	label = f.Name()
	fmt.Println(label)
}
