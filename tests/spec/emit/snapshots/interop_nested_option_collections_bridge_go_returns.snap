---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:example.com/nested"
  
  fn main() {
    let values = nested.Values()
    let maybe_values = nested.MaybeValues()
    let _ = values
    let _ = maybe_values
  }
---
package main

import (
	"example.com/nested"
	lisette "github.com/ivov/lisette/prelude"
)

func main() {
	src := nested.Values()
	wrapped := make([]lisette.Option[int], len(src))
	for i, v := range src {
		if v != nil {
			wrapped[i] = lisette.MakeOptionSome[int](*v)
		} else {
			wrapped[i] = lisette.MakeOptionNone[int]()
		}
	}
	ret, ret2 := nested.MaybeValues()
	var maybeValues lisette.Option[[]lisette.Option[int]]
	if ret2 {
		wrapped2 := make([]lisette.Option[int], len(ret))
		for i2, v2 := range ret {
			if v2 != nil {
				wrapped2[i2] = lisette.MakeOptionSome[int](*v2)
			} else {
				wrapped2[i2] = lisette.MakeOptionNone[int]()
			}
		}
		maybeValues = lisette.MakeOptionSome[[]lisette.Option[int]](wrapped2)
	} else {
		maybeValues = lisette.MakeOptionNone[[]lisette.Option[int]]()
	}
	_ = maybeValues
}
