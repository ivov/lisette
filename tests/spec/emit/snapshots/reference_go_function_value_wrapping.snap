source: tests/spec/emit/expressions.rs
description: |
  
  import "go:strconv"
  
  fn main() {
    let r: Ref<fn(string) -> Result<int, error>> = &strconv.Atoi
    let _ = r
  }
---
package main

import (
	"strconv"

	lisette "github.com/ivov/lisette/prelude"
)

func main() {
	ref := func(arg0 string) lisette.Result[int, error] {
		return lisette.ResultFromPair[int](strconv.Atoi(arg0))
	}
	r := &ref
	_ = r
}
