---
source: tests/spec/emit/partial.rs
description: |
  
  import "go:fmt"
  import "go:io"
  import "go:strings"
  
  fn size(s: string) -> int {
    match io.ReadAll(strings.NewReader(s)) {
      Partial.Ok(e) => e.length(),
      Partial.Both(_, e) | Partial.Err(e) => {
        fmt.Println(e)
        0
      },
    }
  }
---
package main

import (
	"fmt"
	"io"
	"strings"
)

func size(s string) int {
	e, e2 := io.ReadAll(strings.NewReader(s))
	if e2 != nil {
		fmt.Println(e2)
		return 0
	}
	return len(e)
}
