---
source: tests/spec/emit/expressions.rs
description: |
  
  import "go:fmt"
  
  struct Box { x: int }
  
  fn make_i() -> int {
    fmt.Println("i")
    0
  }
  
  fn main() {
    let mut inner = Map.new<string, Box>()
    inner["k"] = Box { x: 0 }
    let mut maps: mut Slice<mut Map<string, Box>> = [inner]
    let i = make_i()
    let mut entry = maps[i]["k"]
    entry.x = 1
    maps[i]["k"] = entry
  }
---
package main

import "fmt"

type Box struct {
	x int
}

func makeI() int {
	fmt.Println("i")
	return 0
}

func main() {
	inner := make(map[string]Box)
	inner["k"] = Box{x: 0}
	maps_ := []map[string]Box{inner}
	i := makeI()
	entry := maps_[i]["k"]
	entry.x = 1
	maps_[i]["k"] = entry
}
