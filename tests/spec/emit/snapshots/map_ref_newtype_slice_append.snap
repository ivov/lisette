---
source: tests/spec/emit/expressions.rs
description: |
  
  struct Wrap(Slice<int>)
  
  fn main() {
    let mut w = Wrap([1])
    let mut m = Map.new<string, mut Ref<Wrap>>()
    m["a"] = &w
    let Some(r) = m.get("a") else { return; };
    r.* = Wrap(r.0.append(2))
    let _ = w
  }
---
package main

type Wrap []int

func main() {
	w := Wrap([]int{1})
	m := make(map[string]*Wrap)
	m["a"] = &w
	r, ok_1 := m["a"]
	if !ok_1 {
		return
	}
	ref_3 := r
	recv_2 := []int(*r)
	*ref_3 = Wrap(append(recv_2[:len(recv_2):len(recv_2)], 2))
	_ = w
}
