---
source: tests/spec/emit/expressions.rs
description: |
  
  fn make_int() -> int { 1 }
  fn read_ref(r: Ref<int>) -> int { r.* }
  fn side_effect() -> int { 1 }
  
  fn test() -> int {
    side_effect() + read_ref(&make_int())
  }
---
package main

func makeInt() int {
	return 1
}

func readRef(r *int) int {
	return *r
}

func sideEffect() int {
	return 1
}

func test() int {
	_left_2 := sideEffect()
	ref_1 := makeInt()
	return _left_2 + readRef(&ref_1)
}
