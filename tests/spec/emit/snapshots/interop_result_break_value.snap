---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:strconv"
  
  fn make() -> fn(string) -> Result<int, error> {
    loop {
      break strconv.Atoi
    }
  }
  
  fn main() {
    let f = make()
    let r = f("1")
    match r {
      Ok(v) => { let _ = v },
      Err(_) => { let _ = 0 },
    }
  }
---
package main

import (
	lisette "github.com/ivov/lisette/prelude"
	"strconv"
)

func make_() func(string) (int, error) {
	var tmp func(string) (int, error)
	for {
		tmp = strconv.Atoi
		break
	}
	return tmp
}

func main() {
	f := make_()
	ret, ret_1 := f("1")
	var r lisette.Result[int, error]
	if ret_1 != nil {
		r = lisette.MakeResultErr[int, error](ret_1)
	} else {
		r = lisette.MakeResultOk[int, error](ret)
	}
	if r.Tag == lisette.ResultOk {
		_ = r.OkVal
	}
}
