---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:strconv"
  
  fn make() -> fn(string) -> Result<int, error> {
    loop {
      break strconv.Atoi
    }
  }
  
  fn main() {
    let f = make()
    let r = f("1")
    match r {
      Ok(v) => { let _ = v },
      Err(_) => { let _ = 0 },
    }
  }
---
package main

import (
	lisette "github.com/ivov/lisette/prelude"
	"strconv"
)

func make_() func(string) lisette.Result[int, error] {
	var tmp func(string) lisette.Result[int, error]
	for {
		tmp = func(arg0 string) lisette.Result[int, error] {
			return lisette.ResultFromPair[int](strconv.Atoi(arg0))
		}
		break
	}
	return tmp
}

func main() {
	f := make_()
	r := f("1")
	if r.Tag == lisette.ResultOk {
		_ = r.OkVal
	}
}
