---
package main

import "fmt"

type Interval struct {
	lo int
	hi int
}

func (i Interval) bounds() (int, int) {
	return i.lo, i.hi
}

func main() {
	r := Interval{
		lo: 1,
		hi: 9,
	}
	low, high := r.bounds()
	fmt.Println(low, high)
}
