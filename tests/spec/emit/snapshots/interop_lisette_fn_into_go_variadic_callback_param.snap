---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:example.com/aws"
  
  fn main() {
    aws.UseOne(Ok)
    aws.UseMany(Ok, Ok)
  }
---
package main

import (
	"example.com/aws"
	lisette "github.com/ivov/lisette/prelude"
)

func main() {
	aws.UseOne(func(arg0 int) (int, error) {
		res := lisette.MakeResultOk[int, error](arg0)
		if res.Tag == lisette.ResultOk {
			return res.OkVal, nil
		}
		return 0, res.ErrVal
	})
	aws.UseMany(func(arg0 int) (int, error) {
		res2 := lisette.MakeResultOk[int, error](arg0)
		if res2.Tag == lisette.ResultOk {
			return res2.OkVal, nil
		}
		return 0, res2.ErrVal
	}, func(arg0 int) (int, error) {
		res3 := lisette.MakeResultOk[int, error](arg0)
		if res3.Tag == lisette.ResultOk {
			return res3.OkVal, nil
		}
		return 0, res3.ErrVal
	})
}
