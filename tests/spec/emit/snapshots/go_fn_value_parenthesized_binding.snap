---
source: tests/spec/emit/functions.rs
description: |
  
  import "go:strconv"
  
  fn main() {
    let f: fn(string) -> Result<int, error> = (strconv.Atoi)
    let r = f("1")
    match r {
      Ok(v) => { let _ = v },
      Err(_) => { let _ = 0 },
    }
  }
---
package main

import (
	lisette "github.com/ivov/lisette/prelude"
	"strconv"
)

func main() {
	f := strconv.Atoi
	ret, ret_1 := f("1")
	var r lisette.Result[int, error]
	if ret_1 != nil {
		r = lisette.MakeResultErr[int, error](ret_1)
	} else {
		r = lisette.MakeResultOk[int, error](ret)
	}
	if r.Tag == lisette.ResultOk {
		_ = r.OkVal
	}
}
