---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:os"
  
  fn apply(f: fn(string) -> Option<string>, key: string) -> string {
    match f(key) {
      Some(v) => v,
      None => "unset",
    }
  }
  
  fn main() {
    let r = apply(os.LookupEnv, "HOME")
    let _ = r
  }
---
package main

import "os"

func apply(f func(string) (string, bool), key string) string {
	ret_1, ok_2 := f(key)
	if ok_2 {
		v := ret_1
		return v
	} else {
		return "unset"
	}
}

func main() {
	r := apply(os.LookupEnv, "HOME")
	_ = r
}
