---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:os"
  
  fn apply(f: fn(string) -> Option<string>, key: string) -> string {
    match f(key) {
      Some(v) => v,
      None => "unset",
    }
  }
  
  fn main() {
    let r = apply(os.LookupEnv, "HOME")
    let _ = r
  }
---
package main

import (
	lisette "github.com/ivov/lisette/prelude"
	"os"
)

func apply(f func(string) lisette.Option[string], key string) string {
	subject := f(key)
	if subject.Tag == lisette.OptionSome {
		return subject.SomeVal
	}
	return "unset"
}

func main() {
	cb := os.LookupEnv
	var adapted func(string) lisette.Option[string]
	if cb != nil {
		adapted = func(arg0 string) lisette.Option[string] {
			return lisette.OptionFromCommaOk[string](cb(arg0))
		}
	}
	r := apply(adapted, "HOME")
	_ = r
}
