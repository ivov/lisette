---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:example.com/aws"
  
  fn apply(f: fn() -> Slice<Option<string>>) -> Slice<Option<string>> {
    f()
  }
  
  fn main() {
    let xs = apply(aws.Make)
    for x in xs {
      match x {
        Some(v) => { let _ = v },
        None => {},
      }
    }
  }
---
package main

import (
	"example.com/aws"
	lisette "github.com/ivov/lisette/prelude"
)

func apply(f func() []lisette.Option[string]) []lisette.Option[string] {
	return f()
}

func main() {
	cb := aws.Make
	xs := apply(func() []lisette.Option[string] {
		src := cb()
		wrapped := make([]lisette.Option[string], len(src))
		for i, v_1 := range src {
			if v_1 != nil {
				wrapped[i] = lisette.MakeOptionSome[string](*v_1)
			} else {
				wrapped[i] = lisette.MakeOptionNone[string]()
			}
		}
		return wrapped
	})
	for _, x := range xs {
		if x.Tag == lisette.OptionSome {
			_ = x.SomeVal
		}
	}
}
