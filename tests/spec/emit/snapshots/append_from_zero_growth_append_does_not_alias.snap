---
source: tests/spec/emit/prelude.rs
description: |
  
  fn main() {
    let mut s = [1, 2]
    s = s.append(3)
    let u1 = s.append().append(7)
    let u2 = s.append().append(8)
    if u1.get(3).unwrap_or(-1) != 7 {
      panic("zero-growth append chains must not share storage")
    }
    if u2.get(3).unwrap_or(-1) != 8 {
      panic("zero-growth append chains must not share storage")
    }
  }
---
package main

import "slices"

func main() {
	s := []int{1, 2}
	s = append(s, 3)
	u1 := append(slices.Clone(s), 7)
	u2 := append(slices.Clone(s), 8)
	ret := -1
	if len(u1) > 3 {
		ret = u1[3]
	}
	if ret != 7 {
		panic("zero-growth append chains must not share storage")
	}
	ret2 := -1
	if len(u2) > 3 {
		ret2 = u2[3]
	}
	if ret2 != 8 {
		panic("zero-growth append chains must not share storage")
	}
}
