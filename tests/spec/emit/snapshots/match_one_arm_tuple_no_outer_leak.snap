---
source: tests/spec/emit/patterns.rs
description: |
  
  fn test() -> string {
    let n = 50;
    let s = "original";
    let pair = (100, "replaced");
    let r = match pair {
      (n, s) => f"{n}-{s}",
    };
    f"{n} {s} {r}"
  }
---
package main

import (
	"fmt"
	lisette "github.com/ivov/lisette/prelude"
)

func test() string {
	n := 50
	s := "original"
	pair := lisette.MakeTuple2[int, string](100, "replaced")
	var r string
	r = fmt.Sprintf("%d-%s", pair.First, pair.Second)
	return fmt.Sprintf("%d %s %s", n, s, r)
}
