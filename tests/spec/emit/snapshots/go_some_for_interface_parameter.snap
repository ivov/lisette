---
source: tests/spec/emit/functions.rs
description: |
  
  import "go:net/http"
  import "go:strings"
  import "go:fmt"
  
  fn main() {
    let mut body = strings.NewReader("hello")
    let req = http.NewRequest("POST", "https://example.com", Some(body))
    fmt.Println(req)
  }
---
package main

import (
	"errors"
	"fmt"
	lisette "github.com/ivov/lisette/prelude"
	"net/http"
	"strings"
)

func main() {
	body := strings.NewReader("hello")
	ret_1, ret_2 := http.NewRequest("POST", "https://example.com", body)
	var req lisette.Result[*http.Request, error]
	if ret_2 != nil {
		req = lisette.MakeResultErr[*http.Request, error](ret_2)
	} else if ret_1 == nil {
		req = lisette.MakeResultErr[*http.Request, error](errors.New("unexpected nil"))
	} else {
		req = lisette.MakeResultOk[*http.Request, error](ret_1)
	}
	fmt.Println(req)
}
