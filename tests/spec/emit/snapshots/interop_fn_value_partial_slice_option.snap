---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:fmt"
  import "go:example.com/aws"
  
  fn main() {
    let f = aws.Read
    match f() {
      Ok(xs) => fmt.Println("ok", Slice.length(xs)),
      Both(xs, e) => fmt.Println("both", Slice.length(xs), e),
      Err(e) => fmt.Println("err", e),
    }
  }
---
package main

import (
	"example.com/aws"
	"fmt"
	lisette "github.com/ivov/lisette/prelude"
)

func main() {
	f := func() lisette.Partial[[]lisette.Option[string], error] {
		ret, ret2 := aws.Read()
		if ret2 != nil {
			if ret == nil {
				return lisette.MakePartialErr[[]lisette.Option[string], error](ret2)
			}
			wrapped := make([]lisette.Option[string], len(ret))
			for i, v := range ret {
				if v != nil {
					wrapped[i] = lisette.MakeOptionSome[string](*v)
				} else {
					wrapped[i] = lisette.MakeOptionNone[string]()
				}
			}
			return lisette.MakePartialBoth[[]lisette.Option[string], error](wrapped, ret2)
		}
		wrapped2 := make([]lisette.Option[string], len(ret))
		for i2, v2 := range ret {
			if v2 != nil {
				wrapped2[i2] = lisette.MakeOptionSome[string](*v2)
			} else {
				wrapped2[i2] = lisette.MakeOptionNone[string]()
			}
		}
		return lisette.MakePartialOk[[]lisette.Option[string], error](wrapped2)
	}
	subject := f()
	switch subject.Tag {
	case lisette.PartialOk:
		fmt.Println("ok", len(subject.OkVal))
	case lisette.PartialBoth:
		e := subject.ErrVal
		fmt.Println("both", len(subject.OkVal), e)
	default:
		fmt.Println("err", subject.ErrVal)
	}
}
