---
source: tests/spec/emit/functions.rs
description: |
  
  fn run(x: Option<int>) -> int {
    let f = |k: int| {
      let x = match x {
        Some(v) => v + k,
        None => 0,
      }
      x * 2
    }
    f(1)
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

func run(x lisette.Option[int]) int {
	f := func(k int) int {
		var x2 int
		if x.Tag == lisette.OptionSome {
			x2 = x.SomeVal + k
		} else {
			x2 = 0
		}
		return x2 * 2
	}
	return f(1)
}
