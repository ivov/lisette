---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:strconv"
  
  type F = fn(string) -> Result<int, error>
  struct Pair(F, int)
  
  fn main() {
    let p = Pair(strconv.Atoi, 1)
    let r = p.0("1")
    match r {
      Ok(v) => { let _ = v },
      Err(_) => { let _ = 0 },
    }
  }
---
package main

import (
	lisette "github.com/ivov/lisette/prelude"
	"strconv"
)

type F func(string) lisette.Result[int, error]

type Pair struct {
	F0 F
	F1 int
}

func main() {
	p := Pair{
		F0: func(arg0 string) lisette.Result[int, error] {
			return lisette.ResultFromPair[int](strconv.Atoi(arg0))
		},
		F1: 1,
	}
	r := p.F0("1")
	if r.Tag == lisette.ResultOk {
		_ = r.OkVal
	}
}
