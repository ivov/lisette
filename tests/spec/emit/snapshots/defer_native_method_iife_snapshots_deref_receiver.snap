---
source: tests/spec/emit/concurrency.rs
description: |
  
  fn run(out: mut Ref<mut Slice<int>>) {
    defer out.copy_from([1, 2, 3])
    out.* = [7, 7, 7, 7, 7]
  }
---
package main

func run(out *[]int) {
	arg := *out
	arg_1 := []int{1, 2, 3}
	defer func() {
		_ = copy(arg, arg_1)
	}()
	*out = []int{7, 7, 7, 7, 7}
}
