---
source: tests/spec/emit/functions.rs
description: |
  
  fn pair<T>(x: T) -> (T, T) { (x, x) }
  fn main() {
    let x = 3
    let stored: fn(Option<Ref<int>>) -> (Option<Ref<int>>, Option<Ref<int>>) = pair
    let (Some(first), Some(second)) = stored(Some(&x)) else { panic("stored generic tuple") }
    let inferred = pair
    let Some((Some(third), Some(fourth))) = Option.map(Some(Some(&x)), inferred) else { panic("inferred generic tuple") }
    if first != &x || second != &x || third != &x || fourth != &x { panic("generic tuple payloads") }
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

func pair[T any](x T) (T, T) {
	return x, x
}

func main() {
	x := 3
	stored := func(arg0 lisette.Option[*int]) lisette.Tuple2[lisette.Option[*int], lisette.Option[*int]] {
		ret, ret_1 := pair[lisette.Option[*int]](arg0)
		tup := lisette.MakeTuple2(ret, ret_1)
		return tup
	}
	subject := stored(lisette.MakeOptionSome(&x))
	if !(subject.First.Tag == lisette.OptionSome && subject.Second.Tag == lisette.OptionSome) {
		panic("stored generic tuple")
	}
	first := subject.First.SomeVal
	second := subject.Second.SomeVal
	inferred := func(arg0 lisette.Option[*int]) lisette.Tuple2[lisette.Option[*int], lisette.Option[*int]] {
		ret_2, ret_3 := pair[lisette.Option[*int]](arg0)
		tup_1 := lisette.MakeTuple2(ret_2, ret_3)
		return tup_1
	}
	subject_1 := lisette.OptionMap(lisette.MakeOptionSome(lisette.MakeOptionSome(&x)), inferred)
	if !(subject_1.Tag == lisette.OptionSome && subject_1.SomeVal.First.Tag == lisette.OptionSome && subject_1.SomeVal.Second.Tag == lisette.OptionSome) {
		panic("inferred generic tuple")
	}
	third := subject_1.SomeVal.First.SomeVal
	fourth := subject_1.SomeVal.Second.SomeVal
	if first != &x || second != &x || third != &x || fourth != &x {
		panic("generic tuple payloads")
	}
}
