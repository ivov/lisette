---
source: tests/spec/emit/functions.rs
description: |
  
  fn main(){let mut n=0;let mut fs:mut Slice<fn(int)> = [|x|{n+=x}];let mut r=&fs[0];r.* = |x|{n+=10*x};fs[0](3);if n!=30{panic("index storage")}}
---
package main

func main() {
	n := 0
	fs := []func(int) struct{}{func(x int) struct{} {
		n += x
		return struct{}{}
	}}
	r := &fs[0]
	*r = func(x int) struct{} {
		n += 10 * x
		return struct{}{}
	}
	fs[0](3)
	if n != 30 {
		panic("index storage")
	}
}
