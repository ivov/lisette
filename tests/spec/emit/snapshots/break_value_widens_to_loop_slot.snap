---
source: tests/spec/emit/go_interface_adapter.rs
description: |
  
  struct Boom {}
  
  impl Boom {
    fn Error(self) -> string {
      "boom"
    }
  }
  
  fn unit() {}
  
  fn returned() -> Array<error, 1> {
    let booms: Array<Boom, 1> = [Boom {}]
    loop {
      break booms
    }
  }
  
  fn test() -> (Unknown, Option<int>) {
    let concrete = (Boom {}, 1)
    let booms: Array<Boom, 1> = [Boom {}]
    let in_block: (error, int) = {
      loop {
        break concrete
      }
    }
    let mut reassigned: Array<error, 1> = [Boom {}]
    reassigned = loop {
      break booms
    }
    let element: ((error, int), int) = ({ loop { break concrete } }, 2)
    let from_block: (error, int) = loop {
      break { concrete }
    }
    let from_paren: Array<error, 1> = loop {
      break ({ booms })
    }
    let payload: Option<Array<error, 1>> = loop {
      break Some(booms)
    }
    let callback: Unknown = loop {
      break { unit }
    }
    let fallible = loop {
      break Some(1)
    }
    let _ = in_block
    let _ = reassigned
    let _ = element
    let _ = from_block
    let _ = from_paren
    let _ = payload
    let _ = returned()
    (callback, fallible)
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

type Boom struct{}

func (b Boom) Error() string {
	return "boom"
}

func unit() {}

func returned() [1]error {
	booms := [1]Boom{{}}
	var tmp [1]error
	for {
		var boxed [1]error
		for i := range booms {
			boxed[i] = booms[i]
		}
		tmp = boxed
		break
	}
	return tmp
}

func test() (any, lisette.Option[int]) {
	concrete := lisette.MakeTuple2[Boom, int](Boom{}, 1)
	booms := [1]Boom{{}}
	var inBlock lisette.Tuple2[error, int]
	var tmp lisette.Tuple2[error, int]
	for {
		tmp = lisette.MakeTuple2[error, int](concrete.First, concrete.Second)
		break
	}
	inBlock = tmp
	reassigned := [1]error{Boom{}}
	var tmp2 [1]error
	for {
		var boxed [1]error
		for i := range booms {
			boxed[i] = booms[i]
		}
		tmp2 = boxed
		break
	}
	reassigned = tmp2
	var tmp3 lisette.Tuple2[error, int]
	var tmp4 lisette.Tuple2[error, int]
	for {
		tmp4 = lisette.MakeTuple2[error, int](concrete.First, concrete.Second)
		break
	}
	tmp3 = tmp4
	element := lisette.MakeTuple2[lisette.Tuple2[error, int], int](tmp3, 2)
	var fromBlock lisette.Tuple2[error, int]
	for {
		fromBlock = lisette.MakeTuple2[error, int](concrete.First, concrete.Second)
		break
	}
	var fromParen [1]error
	for {
		var boxed2 [1]error
		for i2 := range booms {
			boxed2[i2] = booms[i2]
		}
		fromParen = boxed2
		break
	}
	var payload lisette.Option[[1]error]
	var tmp5 lisette.Option[[1]error]
	for {
		var boxed3 [1]error
		for i3 := range booms {
			boxed3[i3] = booms[i3]
		}
		tmp5 = lisette.MakeOptionSome[[1]error](boxed3)
		break
	}
	payload = tmp5
	var callback any
	for {
		cb := func() struct{} {
			unit()
			return struct{}{}
		}
		callback = func() {
			cb()
		}
		break
	}
	var fallible lisette.Option[int]
	var tmp6 lisette.Option[int]
	for {
		tmp6 = lisette.MakeOptionSome[int](1)
		break
	}
	fallible = tmp6
	_ = inBlock
	_ = reassigned
	_ = element
	_ = fromBlock
	_ = fromParen
	_ = payload
	returned()
	return callback, fallible
}
