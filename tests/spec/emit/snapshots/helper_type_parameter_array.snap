---
source: tests/spec/emit/functions.rs
description: |
  
  fn count<arr>(_seed: arr) -> int {
    let values = Array.new<Option<arr>, 2>()
    let mut count = 0
    for value in values { if value.is_none() { count += 1 } }
    count
  }
  fn main() { if count(1) != 2 { panic("generic array helper") } }
---
package main

import lisette "github.com/ivov/lisette/prelude"

func count[arr any](_ arr) int {
	values := func() [2]lisette.Option[arr] {
		var arr2 [2]lisette.Option[arr]
		for i := range arr2 {
			arr2[i] = lisette.MakeOptionNone[arr]()
		}
		return arr2
	}()
	count := 0
	for _, value := range values {
		if value.IsNone() {
			count++
		}
	}
	return count
}

func main() {
	if count(1) != 2 {
		panic("generic array helper")
	}
}
