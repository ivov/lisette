---
source: tests/spec/emit/expressions.rs
description: |
  
  import "go:fmt"
  import "go:strconv"
  
  fn main() {
    let n = strconv.Atoi("42")
    let ret2 = 7
    fmt.Println(n)
    fmt.Println(ret2)
  }
---
package main

import (
	"fmt"
	"strconv"

	lisette "github.com/ivov/lisette/prelude"
)

func main() {
	n := lisette.ResultFromPair[int](strconv.Atoi("42"))
	ret2 := 7
	fmt.Println(n)
	fmt.Println(ret2)
}
