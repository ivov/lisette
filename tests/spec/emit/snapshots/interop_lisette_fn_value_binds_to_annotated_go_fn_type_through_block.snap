---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:bufio"
  
  fn split_words(data: mut Slice<byte>, at_eof: bool) -> Result<(int, Slice<byte>), error> {
    bufio.ScanWords(data, at_eof)
  }
  
  fn main() {
    let annotated: bufio.SplitFunc = { split_words }
    let staged: bufio.SplitFunc = {
      let f = split_words
      f
    }
    let literal: bufio.SplitFunc = { |data, at_eof| bufio.ScanWords(data, at_eof) }
    let _ = annotated
    let _ = staged
    let _ = literal
  }
---
package main

import (
	"bufio"
	lisette "github.com/ivov/lisette/prelude"
)

func splitWords(data []byte, at_eof bool) (lisette.Tuple2[int, []byte], error) {
	ret, ret_1, ret_2 := bufio.ScanWords(data, at_eof)
	tup := lisette.MakeTuple2(ret, ret_1)
	var result lisette.Result[lisette.Tuple2[int, []byte], error]
	if ret_2 != nil {
		result = lisette.MakeResultErr[lisette.Tuple2[int, []byte], error](ret_2)
	} else {
		result = lisette.MakeResultOk[lisette.Tuple2[int, []byte], error](tup)
	}
	if result.Tag == lisette.ResultOk {
		return result.OkVal, nil
	}
	return lisette.Tuple2[int, []byte]{}, result.ErrVal
}

func main() {
	var annotated bufio.SplitFunc
	cb := func(arg0 []byte, arg1 bool) lisette.Result[lisette.Tuple2[int, []byte], error] {
		return lisette.ResultFromPair[lisette.Tuple2[int, []byte]](splitWords(arg0, arg1))
	}
	annotated = func(arg0 []byte, arg1 bool) (int, []byte, error) {
		res := cb(arg0, arg1)
		if res.Tag == lisette.ResultOk {
			tup := res.OkVal
			return tup.First, tup.Second, nil
		}
		return 0, nil, res.ErrVal
	}
	var staged bufio.SplitFunc
	{
		f := func(arg0 []byte, arg1 bool) lisette.Result[lisette.Tuple2[int, []byte], error] {
			return lisette.ResultFromPair[lisette.Tuple2[int, []byte]](splitWords(arg0, arg1))
		}
		cb_1 := f
		var adapted func([]byte, bool) (int, []byte, error)
		if cb_1 != nil {
			adapted = func(arg0 []byte, arg1 bool) (int, []byte, error) {
				res_1 := cb_1(arg0, arg1)
				if res_1.Tag == lisette.ResultOk {
					tup_1 := res_1.OkVal
					return tup_1.First, tup_1.Second, nil
				}
				return 0, nil, res_1.ErrVal
			}
		}
		staged = adapted
	}
	var literal bufio.SplitFunc
	literal = func(data []byte, at_eof bool) (int, []byte, error) {
		return bufio.ScanWords(data, at_eof)
	}
	_ = annotated
	_ = staged
	_ = literal
}
