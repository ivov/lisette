---
source: tests/spec/emit/concurrency.rs
description: |
  
  fn process(v: int) {}
  
  fn test() {
    let ch = Channel.new<int>();
    for v in ch {
      process(v);
    }
  }
---
package main

func process(_ int) {}

func test() {
	ch := make(chan int)
	if ch != nil {
		for v := range ch {
			process(v)
		}
	}
}
