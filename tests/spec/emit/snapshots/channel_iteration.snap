---
source: tests/spec/emit/concurrency.rs
description: |
  
  fn process(v: int) {}
  
  fn test() {
    let ch = Channel.new<int>();
    for v in ch {
      process(v);
    }
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

func process(_ int) {}

func test() {
	ch := make(chan int)
	for v := range lisette.ChannelRange(ch) {
		process(v)
	}
}
