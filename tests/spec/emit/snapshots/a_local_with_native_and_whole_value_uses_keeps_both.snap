---
source: tests/spec/emit/result_option_patterns.rs
description: |
  
  import "go:fmt"
  
  fn takes(o: Option<int>) -> int {
    o.unwrap_or(0)
  }
  
  fn mixed(m: Map<string, int>, key: string) -> int {
    let found = m.get(key)
    if found.is_some() {
      fmt.Println("present")
    }
    takes(found)
  }
  
  fn reassigned(m: Map<string, int>, key: string) -> int {
    let mut found = m.get(key)
    found = Some(5)
    found.unwrap_or(0)
  }
  
  fn test() {
    let mut m = Map.new<string, int>()
    m["a"] = 1
    if mixed(m, "a") != 1 { panic("a present key should reach the wrapper") }
    if mixed(m, "b") != 0 { panic("a missing key should reach the default") }
    if reassigned(m, "b") != 5 { panic("a reassigned local should keep its wrapper") }
  }
---
package main

import (
	"fmt"
	lisette "github.com/ivov/lisette/prelude"
)

func takes(o lisette.Option[int]) int {
	return o.UnwrapOr(0)
}

func mixed(m map[string]int, key string) int {
	found, ok := m[key]
	if ok {
		fmt.Println("present")
	}
	return takes(lisette.OptionFromCommaOk[int](found, ok))
}

func reassigned(m map[string]int, key string) int {
	found := lisette.MapGet(m, key)
	found = lisette.MakeOptionSome(5)
	return found.UnwrapOr(0)
}

func test() {
	m := make(map[string]int)
	m["a"] = 1
	if mixed(m, "a") != 1 {
		panic("a present key should reach the wrapper")
	}
	if mixed(m, "b") != 0 {
		panic("a missing key should reach the default")
	}
	if reassigned(m, "b") != 5 {
		panic("a reassigned local should keep its wrapper")
	}
}
