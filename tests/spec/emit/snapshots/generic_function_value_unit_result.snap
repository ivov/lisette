---
source: tests/spec/emit/functions.rs
description: |
  
  fn okay<T>(x: T) -> Result<T, error> { Ok(x) }
  fn consume(f: fn(()) -> Result<(), error>) -> bool { f(()).is_ok() }
  fn main() {
    if !consume(okay) { panic("generic callback unit result") }
    let stored: fn(()) -> Result<(), error> = okay
    if stored(()).is_err() { panic("stored generic unit result") }
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

func okay[T any](x T) (T, error) {
	return x, nil
}

func consume(f func(struct{}) lisette.Result[struct{}, error]) bool {
	return f(struct{}{}).IsOk()
}

func main() {
	cb := okay[struct{}]
	var adapted func(struct{}) lisette.Result[struct{}, error]
	if cb != nil {
		adapted = func(arg0 struct{}) lisette.Result[struct{}, error] {
			return lisette.ResultFromPair[struct{}](cb(arg0))
		}
	}
	if !consume(adapted) {
		panic("generic callback unit result")
	}
	cb_1 := okay[struct{}]
	var adapted_1 func(struct{}) lisette.Result[struct{}, error]
	if cb_1 != nil {
		adapted_1 = func(arg0 struct{}) lisette.Result[struct{}, error] {
			return lisette.ResultFromPair[struct{}](cb_1(arg0))
		}
	}
	stored := adapted_1
	if stored(struct{}{}).IsErr() {
		panic("stored generic unit result")
	}
}
