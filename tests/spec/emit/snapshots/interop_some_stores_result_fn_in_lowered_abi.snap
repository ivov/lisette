---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import ext "go:example.com/ext"
  
  fn configure(conf: Ref<ext.Config>) {
    let mut wrapped: Slice<Option<fn(ext.Config) -> Result<ext.Listener, error>>> = []
    for listener in ext.WrapListeners(conf.Listeners) {
      wrapped = wrapped.append(Some(listener))
    }
  }
---
package main

import (
	"errors"

	"example.com/ext"
	lisette "github.com/ivov/lisette/prelude"
)

func configure(conf *ext.Config) {
	wrapped := []lisette.Option[func(ext.Config) lisette.Result[ext.Listener, error]]{}
	raw := conf.Listeners
	adapted := make([]func(ext.Config) lisette.Result[ext.Listener, error], len(raw))
	for i, v := range raw {
		cb := v
		var adapted2 func(ext.Config) lisette.Result[ext.Listener, error]
		if cb != nil {
			adapted2 = func(arg0 ext.Config) lisette.Result[ext.Listener, error] {
				ret, ret2 := cb(arg0)
				if ret2 != nil {
					return lisette.MakeResultErr[ext.Listener, error](ret2)
				} else if lisette.IsNilInterface(ret) {
					return lisette.MakeResultErr[ext.Listener, error](errors.New("unexpected nil"))
				}
				return lisette.MakeResultOk[ext.Listener, error](ret)
			}
		}
		adapted[i] = adapted2
	}
	adapted3 := make([]func(ext.Config) (ext.Listener, error), len(adapted))
	for i2, v2 := range adapted {
		cb2 := v2
		var adapted4 func(ext.Config) (ext.Listener, error)
		if cb2 != nil {
			adapted4 = func(arg0 ext.Config) (ext.Listener, error) {
				res := cb2(arg0)
				if res.Tag == lisette.ResultOk {
					return res.OkVal, nil
				}
				return nil, res.ErrVal
			}
		}
		adapted3[i2] = adapted4
	}
	src := ext.WrapListeners(adapted3)
	adapted5 := make([]func(ext.Config) lisette.Result[ext.Listener, error], len(src))
	for i3, v3 := range src {
		cb3 := v3
		var adapted6 func(ext.Config) lisette.Result[ext.Listener, error]
		if cb3 != nil {
			adapted6 = func(arg0 ext.Config) lisette.Result[ext.Listener, error] {
				ret3, ret4 := cb3(arg0)
				if ret4 != nil {
					return lisette.MakeResultErr[ext.Listener, error](ret4)
				} else if lisette.IsNilInterface(ret3) {
					return lisette.MakeResultErr[ext.Listener, error](errors.New("unexpected nil"))
				}
				return lisette.MakeResultOk[ext.Listener, error](ret3)
			}
		}
		adapted5[i3] = adapted6
	}
	for _, listener := range adapted5 {
		wrapped = append(wrapped, lisette.MakeOptionSome(listener))
	}
}
