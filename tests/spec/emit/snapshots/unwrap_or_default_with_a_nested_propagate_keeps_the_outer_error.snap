---
source: tests/spec/emit/result_option_patterns.rs
description: |
  
  import "go:strconv"
  
  fn one() -> Result<int, error> {
    Ok(strconv.Atoi("bad").unwrap_or(strconv.Atoi("7")?))
  }
---
package main

import "strconv"

func one() (int, error) {
	ret, err := strconv.Atoi("bad")
	ret2, err2 := strconv.Atoi("7")
	if err2 != nil {
		return 0, err2
	}
	if err != nil {
		ret = ret2
	}
	return ret, nil
}
