---
source: tests/spec/emit/result_option_patterns.rs
description: |
  
  import "go:strconv"
  
  fn one() -> Result<int, error> {
    Ok(strconv.Atoi("bad").unwrap_or(strconv.Atoi("7")?))
  }
---
package main

import "strconv"

func one() (int, error) {
	ret, err := strconv.Atoi("bad")
	ret_1, err_1 := strconv.Atoi("7")
	if err_1 != nil {
		return 0, err_1
	}
	if err != nil {
		ret = ret_1
	}
	return ret, nil
}
