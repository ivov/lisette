---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:fmt"
  import "go:example.com/migrate"
  
  fn main() {
    let (src, db) = migrate.Close()
    match src {
      Some(e) => fmt.Println("source:", e),
      None => {},
    }
    match db {
      Some(e) => fmt.Println("db:", e),
      None => {},
    }
  }
---
package main

import (
	"fmt"

	"example.com/migrate"
	lisette "github.com/ivov/lisette/prelude"
)

func main() {
	ret, ret2 := migrate.Close()
	option := lisette.OptionFromNilable[error](ret, lisette.IsNilInterface(ret))
	option2 := lisette.OptionFromNilable[error](ret2, lisette.IsNilInterface(ret2))
	tup := lisette.MakeTuple2(option, option2)
	src := tup.First
	db := tup.Second
	if src.Tag == lisette.OptionSome {
		fmt.Println("source:", src.SomeVal)
	}
	if db.Tag == lisette.OptionSome {
		fmt.Println("db:", db.SomeVal)
	}
}
