---
source: tests/spec/emit/result_option_patterns.rs
description: |
  
  import "go:fmt"
  
  fn next_item(counter: int) -> Option<int> {
    if counter < 5 { Some(counter) } else { None }
  }
  
  fn test() {
    let mut i = 0;
    while let Some(x) = next_item(i) {
      fmt.Print(f"Got: {x}\n");
      i = i + 1;
    }
  }
---
package main

import "fmt"

func nextItem(counter int) (int, bool) {
	if counter < 5 {
		return counter, true
	}
	return 0, false
}

func test() {
	i := 0
	for {
		ret_1, ok_2 := nextItem(i)
		if !ok_2 {
			break
		}
		x := ret_1
		fmt.Printf("Got: %d\n", x)
		i++
	}
}
