---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:path"
  
  fn main() {
    let f = path.Split
    let r = f("/foo/bar.txt")
    let _ = r
  }
---
package main

import (
	lisette "github.com/ivov/lisette/prelude"
	"path"
)

func main() {
	f := func(arg0 string) lisette.Tuple2[string, string] {
		ret, ret_1 := path.Split(arg0)
		tup := lisette.MakeTuple2(ret, ret_1)
		return tup
	}
	r := f("/foo/bar.txt")
	_ = r
}
