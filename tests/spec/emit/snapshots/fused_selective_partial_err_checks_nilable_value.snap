---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:fmt"
  import "go:example.com/aws"
  
  fn main() {
    match aws.Read() {
      Partial.Err(e) => fmt.Println("err", e),
      _ => {},
    }
  }
---
package main

import (
	"example.com/aws"
	"fmt"
)

func main() {
	ret_1, e := aws.Read()
	if e != nil && ret_1 == nil {
		fmt.Println("err", e)
	}
}
