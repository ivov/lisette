description: |
  
  fn track(flag: mut Ref<bool>) -> Result<int, error> {
    flag.* = true
    Ok(1)
  }
  
  fn test() {
    let mut ran = false
    if true {
      let _ = 1
    } else if track(&ran).is_ok() {
      let _ = 2
    } else {
      let _ = 3
    }
  }
---
package main

