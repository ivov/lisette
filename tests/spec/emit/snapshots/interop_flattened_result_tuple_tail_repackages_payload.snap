source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:example.com/multi"
  
  fn load() -> Result<(string, int), error> {
    multi.Load()
  }
---
package main

import (
	"example.com/multi"
	lisette "github.com/ivov/lisette/prelude"
)

func load() (lisette.Tuple2[string, int], error) {
	ret, ret2, ret3 := multi.Load()
	tup := lisette.MakeTuple2(ret, ret2)
	var result lisette.Result[lisette.Tuple2[string, int], error]
	if ret3 != nil {
		result = lisette.MakeResultErr[lisette.Tuple2[string, int], error](ret3)
	} else {
		result = lisette.MakeResultOk[lisette.Tuple2[string, int], error](tup)
	}
	if result.Tag == lisette.ResultOk {
		return result.OkVal, nil
	}
	return lisette.Tuple2[string, int]{}, result.ErrVal
}
