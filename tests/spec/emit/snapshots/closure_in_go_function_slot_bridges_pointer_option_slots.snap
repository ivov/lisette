---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:example.com/cb"
  
  fn named() -> Result<Option<int>, error> {
    Ok(Some(2))
  }
  
  fn main() {
    cb.Run(|| Ok(Some(1)))
    cb.Run(named)
    cb.Each(|v| { let _ = v })
  }
---
package main

import (
	"example.com/cb"
	lisette "github.com/ivov/lisette/prelude"
)

func named() (lisette.Option[int], error) {
	return lisette.MakeOptionSome(2), nil
}

func main() {
	cb_1 := func() (lisette.Option[int], error) {
		return lisette.MakeOptionSome(1), nil
	}
	cb.Run(func() (*int, error) {
		ret, ret_1 := cb_1()
		var ptr *int
		if ret.Tag == lisette.OptionSome {
			ptr = &ret.SomeVal
		}
		return ptr, ret_1
	})
	cb_2 := named
	cb.Run(func() (*int, error) {
		ret_2, ret_3 := cb_2()
		var ptr_1 *int
		if ret_2.Tag == lisette.OptionSome {
			ptr_1 = &ret_2.SomeVal
		}
		return ptr_1, ret_3
	})
	cb_3 := func(v lisette.Option[int]) {
		_ = v
	}
	cb.Each(func(arg0 *int) {
		option := lisette.OptionFromPointer[int](arg0)
		cb_3(option)
	})
}
