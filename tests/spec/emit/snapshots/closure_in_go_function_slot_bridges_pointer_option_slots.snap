---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:example.com/cb"
  
  fn named() -> Result<Option<int>, error> {
    Ok(Some(2))
  }
  
  fn main() {
    cb.Run(|| Ok(Some(1)))
    cb.Run(named)
    cb.Each(|v| { let _ = v })
  }
---
package main

import (
	"example.com/cb"
	lisette "github.com/ivov/lisette/prelude"
)

func named() (lisette.Option[int], error) {
	return lisette.MakeOptionSome(2), nil
}

func main() {
	cb2 := func() lisette.Result[lisette.Option[int], error] {
		return lisette.MakeResultOk[lisette.Option[int], error](lisette.MakeOptionSome(1))
	}
	cb.Run(func() (*int, error) {
		ret, ret2 := func() (lisette.Option[int], error) {
			res := cb2()
			if res.Tag == lisette.ResultOk {
				return res.OkVal, nil
			}
			return lisette.Option[int]{}, res.ErrVal
		}()
		var ptr *int
		if ret.Tag == lisette.OptionSome {
			ptr = &ret.SomeVal
		}
		return ptr, ret2
	})
	cb3 := func() lisette.Result[lisette.Option[int], error] {
		return lisette.ResultFromPair[lisette.Option[int]](named())
	}
	cb.Run(func() (*int, error) {
		ret3, ret4 := func() (lisette.Option[int], error) {
			res2 := cb3()
			if res2.Tag == lisette.ResultOk {
				return res2.OkVal, nil
			}
			return lisette.Option[int]{}, res2.ErrVal
		}()
		var ptr2 *int
		if ret3.Tag == lisette.OptionSome {
			ptr2 = &ret3.SomeVal
		}
		return ptr2, ret4
	})
	cb4 := func(v lisette.Option[int]) struct{} {
		_ = v
		return struct{}{}
	}
	cb.Each(func(arg0 *int) {
		option := lisette.OptionFromPointer[int](arg0)
		cb4(option)
	})
}
