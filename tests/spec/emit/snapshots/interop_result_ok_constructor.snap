---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:strconv"
  
  fn make() -> Result<fn(string) -> Result<int, error>, error> {
    Ok(strconv.Atoi)
  }
  
  fn main() {
    let r = make()
    match r {
      Ok(f) => {
        let r2 = f("1")
        match r2 {
          Ok(v) => { let _ = v },
          Err(_) => { let _ = 0 },
        }
      },
      Err(_) => { let _ = 0 },
    }
  }
---
package main

import (
	lisette "github.com/ivov/lisette/prelude"
	"strconv"
)

func make_() (func(string) (int, error), error) {
	return strconv.Atoi, nil
}

func main() {
	ret, ret_1 := make_()
	var r lisette.Result[func(string) (int, error), error]
	if ret_1 != nil {
		r = lisette.MakeResultErr[func(string) (int, error), error](ret_1)
	} else {
		r = lisette.MakeResultOk[func(string) (int, error), error](ret)
	}
	if r.Tag == lisette.ResultOk {
		ret_2, ret_3 := r.OkVal("1")
		var r2 lisette.Result[int, error]
		if ret_3 != nil {
			r2 = lisette.MakeResultErr[int, error](ret_3)
		} else {
			r2 = lisette.MakeResultOk[int, error](ret_2)
		}
		if r2.Tag == lisette.ResultOk {
			_ = r2.OkVal
		}
	}
}
