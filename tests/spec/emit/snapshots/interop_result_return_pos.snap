description: |
  
  import "go:strconv"
  
  fn make_parser() -> fn(string) -> Result<int, error> {
    strconv.Atoi
  }
  
  fn main() {
    let f = make_parser()
    let r = f("42")
    match r {
      Ok(v) => { let _ = v },
      Err(_) => { let _ = 0 },
    }
