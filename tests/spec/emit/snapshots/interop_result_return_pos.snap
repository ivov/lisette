---
package main

import (
	lisette "github.com/ivov/lisette/prelude"
	"strconv"
)

func makeParser() func(string) lisette.Result[int, error] {
	return func(arg0 string) lisette.Result[int, error] {
		return lisette.ResultFromPair[int](strconv.Atoi(arg0))
	}
}

func main() {
	f := makeParser()
	r := f("42")
	if r.Tag == lisette.ResultOk {
		_ = r.OkVal
	}
}
