source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:strconv"
  
  fn make_parser() -> fn(string) -> Result<int, error> {
    strconv.Atoi
  }
  
  fn main() {
    let f = make_parser()
    let r = f("42")
    match r {
      Ok(v) => { let _ = v },
      Err(_) => { let _ = 0 },
    }
  }
---
package main

import (
	lisette "github.com/ivov/lisette/prelude"
	"strconv"
)

func makeParser() func(string) (int, error) {
	return strconv.Atoi
}

func main() {
	f := makeParser()
	ret, ret_1 := f("42")
	var r lisette.Result[int, error]
	if ret_1 != nil {
		r = lisette.MakeResultErr[int, error](ret_1)
	} else {
		r = lisette.MakeResultOk[int, error](ret)
	}
	if r.Tag == lisette.ResultOk {
		_ = r.OkVal
	}
}
