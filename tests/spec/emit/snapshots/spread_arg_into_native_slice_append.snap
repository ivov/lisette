---
source: tests/spec/emit/functions.rs
description: |
  
  fn test(s: Slice<int>, more: Slice<int>) -> Slice<int> {
    s.append(more...)
  }
---
package main

import "slices"

func test(s, more []int) []int {
	return func() []int {
		if len(more) == 0 {
			return slices.Clone(s)
		}
		return append(s[:len(s):len(s)], more...)
	}()
}
