---
source: tests/spec/emit/expressions.rs
description: |

  fn bump_and_make(i: mut Ref<int>) -> Slice<int> {
    i.* = 1
    [99]
  }

  fn test() -> int {
    let xss = [[10], [20]]
    let mut i = 0
    let ys = xss[i].append(bump_and_make(&i)...)
    ys[0]
  }
---
package main

import "slices"

func bumpAndMake(i *int) []int {
	*i = 1
	return []int{99}
}

func test() int {
	xss := [][]int{{10}, {20}}
	i := 0
	recv := xss[i]
	added := bumpAndMake(&i)
	ys := func() []int {
		if len(added) == 0 {
			return slices.Clone(recv)
		}
		return append(slices.Clip(recv), added...)
	}()
	return ys[0]
}
