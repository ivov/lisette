---
source: tests/spec/emit/functions.rs
description: |
  
  fn apply(f: fn(mut Slice<int>) -> (), xs: mut Slice<int>) {
    f(xs)
  }
  
  fn test() {
    let bump = |xs: mut Slice<int>| {
      xs[0] += 1
    }
    let mut data = [41]
    apply(bump, data)
  }
---
package main

func apply(f func([]int) struct{}, xs []int) {
	f(xs)
}

func test() {
	bump := func(xs []int) struct{} {
		xs[0]++
		return struct{}{}
	}
	data := []int{41}
	apply(bump, data)
}
