---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:flag"
  
  fn main() {
    let f = flag.Lookup
    let r = f("verbose")
    match r {
      Some(v) => { let _ = v },
      None => {},
    }
  }
---
package main

import (
	"flag"
	lisette "github.com/ivov/lisette/prelude"
)

func main() {
	f := func(arg0 string) lisette.Option[*flag.Flag] {
		raw := flag.Lookup(arg0)
		return lisette.OptionFromNilable[*flag.Flag](raw, raw == nil)
	}
	r := f("verbose")
	if r.Tag == lisette.OptionSome {
		_ = r.SomeVal
	}
}
