---
source: tests/spec/emit/prelude.rs
description: |
  
  fn is_positive(x: int) -> bool { x > 0 }
  
  fn test(xs: Slice<int>) -> bool {
    xs.all(is_positive)
  }
---
package main

func isPositive(x int) bool {
	return x > 0
}

func test(xs []int) bool {
	result := true
	for _, v := range xs {
		if !isPositive(v) {
			result = false
			break
		}
	}
	return result
}
