package main

import lisette "github.com/ivov/lisette/prelude"

func test() {
	items := []lisette.Tuple2[int, int]{
		lisette.MakeTuple2[int, int](1, 2),
		lisette.MakeTuple2[int, int](3, 4),
	}
	for key, value := range items {
		_ = value
		_ = key
	}
}
