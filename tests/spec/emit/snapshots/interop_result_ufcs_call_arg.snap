---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:strconv"
  
  struct Box {}
  
  impl Box {
    fn apply(self, f: fn(string) -> Result<int, error>) -> Result<int, error> {
      f("1")
    }
  }
  
  fn main() {
    let b = Box {}
    let r = Box.apply(b, strconv.Atoi)
    match r {
      Ok(v) => { let _ = v },
      Err(_) => { let _ = 0 },
    }
  }
---
package main

import (
	lisette "github.com/ivov/lisette/prelude"
	"strconv"
)

type Box struct{}

func (b Box) apply(f func(string) lisette.Result[int, error]) (int, error) {
	v := f("1")
	if v.Tag == lisette.ResultOk {
		return v.OkVal, nil
	}
	return 0, v.ErrVal
}

func main() {
	b := Box{}
	cb := strconv.Atoi
	var adapted func(string) lisette.Result[int, error]
	if cb != nil {
		adapted = func(arg0 string) lisette.Result[int, error] {
			return lisette.ResultFromPair[int](cb(arg0))
		}
	}
	r, err := b.apply(adapted)
	if err == nil {
		_ = r
	}
}
