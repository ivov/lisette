---
source: tests/spec/emit/functions.rs
description: |
  
  import sc "go:strconv"
  
  fn make<sc>(x: sc) -> fn() -> sc {
    || -> sc {
      let sc2 = 1
      let _ = sc.Itoa(sc2)
      let mut opt = None
      opt = Some(x)
      match opt {
        Some(v) => v,
        None => x,
      }
    }
  }
  
  fn test() -> int {
    let f = make(7)
    f()
  }
---
package main

import (
	sc "strconv"

	lisette "github.com/ivov/lisette/prelude"
)

func make_[sc2 any](x sc2) func() sc2 {
	return func() sc2 {
		sc2_2 := 1
		sc.Itoa(sc2_2)
		opt := lisette.MakeOptionNone[sc2]()
		opt = lisette.MakeOptionSome(x)
		if opt.Tag == lisette.OptionSome {
			return opt.SomeVal
		}
		return x
	}
}

func test() int {
	f := make_(7)
	return f()
}
