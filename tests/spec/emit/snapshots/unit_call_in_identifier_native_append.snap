---
source: tests/spec/emit/expressions.rs
description: |
  
  fn noop() {}
  
  fn main() {
    let xs: Slice<()> = []
    let y = Slice.append(xs, noop())
    let _ = y
  }
---
package main

import "slices"

func noop() {}

func main() {
	xs := []struct{}{}
	noop()
	y := append(slices.Clip(xs), struct{}{})
	_ = y
}
