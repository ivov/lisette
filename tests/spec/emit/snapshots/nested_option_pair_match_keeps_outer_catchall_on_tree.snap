---
source: tests/spec/emit/result_option_patterns.rs
description: |
  
  fn pick(n: int) -> Option<int> { if n < 0 { None } else { Some(n) } }
  
  fn test() -> string {
    match pick(3) {
      Some(0) => "zero",
      _ => "other",
    }
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

func pick(n int) (int, bool) {
	if n < 0 {
		return 0, false
	}
	return n, true
}

func test() string {
	option := lisette.OptionFromCommaOk[int](pick(3))
	if option.Tag == lisette.OptionSome {
		if option.SomeVal == 0 {
			return "zero"
		}
		return "other"
	}
	return "other"
}
