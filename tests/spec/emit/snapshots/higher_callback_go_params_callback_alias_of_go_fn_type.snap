source: tests/spec/emit/functions.rs
description: |
  
  import "go:path/filepath"
  
  type Walker = filepath.WalkFunc
  
  fn give<T>(
    f: fn(string, filepath.WalkFunc) -> T,
  ) -> fn(string, filepath.WalkFunc) -> T {
