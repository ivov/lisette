---
source: tests/spec/emit/functions.rs
description: |
  
  struct Item { value: int, marker: int }
  fn main() {
    let base = Item { value: 7, marker: 3 }
    let out = base
    let read = || out.value
    let f = || {
      let out = Item { value: read() + 1, ..out }
      let read = || out.value + out.marker
      read()
    }
    let mut total = 0
    for out in [1, 2] { total += f() + out }
    if total != 25 || read() != 7 { panic("updated temp identity") }
  }
---
package main

type Item struct {
	value  int
	marker int
}

func main() {
	base := Item{
		value:  7,
		marker: 3,
	}
	out := base
	read := func() int {
		return out.value
	}
	f := func() int {
		out2 := out
		out2.value = read() + 1
		read2 := func() int {
			return out2.value + out2.marker
		}
		return read2()
	}
	total := 0
	for _, out3 := range []int{1, 2} {
		total += f() + out3
	}
	if total != 25 || read() != 7 {
		panic("updated temp identity")
	}
}
