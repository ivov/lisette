---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:path"
  
  fn make_splitter() -> fn(string) -> (string, string) {
    path.Split
  }
  
  fn main() {
    let f = make_splitter()
    let r = f("/foo/bar.txt")
    let _ = r
  }
---
package main

import (
	lisette "github.com/ivov/lisette/prelude"
	"path"
)

func makeSplitter() func(string) lisette.Tuple2[string, string] {
	return func(arg0 string) lisette.Tuple2[string, string] {
		ret, ret_1 := path.Split(arg0)
		tup := lisette.MakeTuple2(ret, ret_1)
		return tup
	}
}

func main() {
	f := makeSplitter()
	r := f("/foo/bar.txt")
	_ = r
}
