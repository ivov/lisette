---
source: tests/spec/emit/result_option_patterns.rs
description: |
  
  fn pair<A, B>(a: A, b: B) -> Result<(A, B), error> {
    Ok((a, b))
  }
  
  fn test() {
    match pair<int, string>(1, "x") {
      Ok((first, second)) => {
        let _ = first
        let _ = second
      },
      Err(e) => {
        let _ = e
      },
    }
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

func pair[A any, B any](a A, b B) (lisette.Tuple2[A, B], error) {
	return lisette.MakeTuple2[A, B](a, b), nil
}

func test() {
	ret_1, ret_2 := pair[int, string](1, "x")
	var result_3 lisette.Result[lisette.Tuple2[int, string], error]
	if ret_2 != nil {
		result_3 = lisette.MakeResultErr[lisette.Tuple2[int, string], error](ret_2)
	} else {
		result_3 = lisette.MakeResultOk[lisette.Tuple2[int, string], error](ret_1)
	}
	if result_3.Tag == lisette.ResultOk {
		_ = result_3.OkVal.First
		_ = result_3.OkVal.Second
	} else {
		_ = result_3.ErrVal
	}
}
