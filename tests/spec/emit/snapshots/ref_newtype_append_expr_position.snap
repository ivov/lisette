---
source: tests/spec/emit/expressions.rs
description: |
  
  struct Wrap(Slice<int>)
  
  fn main() {
    let mut w = Wrap([1])
    let r = &w
    let _ = r.0.append(2)
  }
---
package main

import "slices"

type Wrap []int

func main() {
	w := Wrap([]int{1})
	r := &w
	recv := ([]int)(*r)
	_ = append(slices.Clip(recv), 2)
}
