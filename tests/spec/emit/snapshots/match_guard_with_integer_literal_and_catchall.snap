---
source: tests/spec/emit/control_flow.rs
description: |
  
  import "go:fmt"
  
  fn main() {
    for i in 0..10 {
      match i {
        d if d < 5 => fmt.Println("low"),
        5 =>          fmt.Println("five"),
        d =>          fmt.Println("high"),
      }
    }
  }
---
package main

import "fmt"

func main() {
	for i := range 10 {
		switch {
		case i < 5:
			fmt.Println("low")
		case i == 5:
			fmt.Println("five")
		default:
			fmt.Println("high")
		}
	}
}
