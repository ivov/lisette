source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:example.com/legacy"
  
  fn main() {
    match legacy.Close() {
      Ok(stored) => { let _ = stored },
      Err(_) => { let _ = 0 },
    }
  }
---
package main

import "example.com/legacy"

func main() {
	if stored, err := legacy.Close(); err == nil {
		_ = stored
	}
}
