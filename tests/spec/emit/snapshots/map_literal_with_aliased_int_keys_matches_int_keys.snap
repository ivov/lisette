description: |
  
  type K = int
  
  fn test() -> (Map<int, string>, Map<K, string>) {
    let a: Map<int, string> = Map.from([(1, "a"), (2, "b")])
    let b: Map<K, string> = Map.from([(1, "a"), (2, "b")])
