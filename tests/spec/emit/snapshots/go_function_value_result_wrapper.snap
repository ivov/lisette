---
source: tests/spec/emit/expressions.rs
description: |
  
  import "go:fmt"
  import "go:strconv"
  
  fn parse_with(f: fn(string) -> Result<int, error>, s: string) -> int {
    match f(s) {
      Ok(n) => n,
      Err(_) => 0,
    }
  }
  
  fn main() {
    let n = parse_with(strconv.Atoi, "42")
    fmt.Println(n)
  }
---
package main

import (
	"fmt"
	lisette "github.com/ivov/lisette/prelude"
	"strconv"
)

func parseWith(f func(string) lisette.Result[int, error], s string) int {
	subject := f(s)
	if subject.Tag == lisette.ResultOk {
		return subject.OkVal
	}
	return 0
}

func main() {
	cb := strconv.Atoi
	var adapted func(string) lisette.Result[int, error]
	if cb != nil {
		adapted = func(arg0 string) lisette.Result[int, error] {
			return lisette.ResultFromPair[int](cb(arg0))
		}
	}
	n := parseWith(adapted, "42")
	fmt.Println(n)
}
