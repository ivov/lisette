---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:os"
  
  fn main() {
    let f = os.LookupEnv
    let r = f("HOME")
    match r {
      Some(v) => { let _ = v },
      None => { let _ = "" },
    }
  }
---
package main

import (
	lisette "github.com/ivov/lisette/prelude"
	"os"
)

func main() {
	f := func(arg0 string) lisette.Option[string] {
		return lisette.OptionFromCommaOk[string](os.LookupEnv(arg0))
	}
	r := f("HOME")
	if r.Tag == lisette.OptionSome {
		_ = r.SomeVal
	}
}
