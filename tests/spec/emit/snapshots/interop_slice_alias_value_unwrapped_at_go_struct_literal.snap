---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:crypto/x509"
  import "go:net/url"
  
  type URLs = Slice<Option<Ref<url.URL>>>
  
  fn certificate() -> x509.Certificate {
    let u = url.URL {
      Scheme: "https",
      Host: "example.com",
      ..,
    }
    let urls: URLs = [Some(&u), None]
    x509.Certificate {
      URIs: urls,
      PublicKey: 0,
      ..,
    }
  }
---
package main

import (
	"crypto/x509"
	lisette "github.com/ivov/lisette/prelude"
	"net/url"
)

type URLs = []lisette.Option[*url.URL]

func certificate() x509.Certificate {
	u := url.URL{
		Scheme: "https",
		Host:   "example.com",
	}
	urls := []lisette.Option[*url.URL]{
		lisette.MakeOptionSome(&u),
		lisette.MakeOptionNone[*url.URL](),
	}
	unwrapped := make([]*url.URL, len(urls))
	for i, v := range urls {
		if v.Tag == lisette.OptionSome {
			unwrapped[i] = v.SomeVal
		}
	}
	return x509.Certificate{
		URIs:      unwrapped,
		PublicKey: 0,
	}
}
