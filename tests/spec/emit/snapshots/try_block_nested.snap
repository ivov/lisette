---
source: tests/spec/emit/control_flow.rs
description: |
  
  fn risky_a() -> Result<int, string> { Ok(1) }
  fn risky_b() -> Result<int, string> { Ok(2) }
  
  fn test() -> int {
    let outer = try {
      let inner: Result<int, string> = try {
        risky_a()?
      };
      let inner_val = match inner {
        Ok(x) => x,
        Err(_) => 0,
      };
      inner_val + risky_b()?
    };
    match outer {
      Ok(x) => x,
      Err(_) => -1,
    }
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

func riskyA() lisette.Result[int, string] {
	return lisette.MakeResultOk[int, string](1)
}

func riskyB() lisette.Result[int, string] {
	return lisette.MakeResultOk[int, string](2)
}

func test() int {
	outer := func() lisette.Result[int, string] {
		inner := func() lisette.Result[int, string] {
			check := riskyA()
			if check.Tag != lisette.ResultOk {
				return check
			}
			return lisette.MakeResultOk[int, string](check.OkVal)
		}()
		var innerVal int
		if inner.Tag == lisette.ResultOk {
			innerVal = inner.OkVal
		} else {
			innerVal = 0
		}
		check2 := riskyB()
		if check2.Tag != lisette.ResultOk {
			return check2
		}
		return lisette.MakeResultOk[int, string](innerVal + check2.OkVal)
	}()
	if outer.Tag == lisette.ResultOk {
		return outer.OkVal
	}
	return -1
}
