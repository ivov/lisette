---
source: tests/spec/emit/functions.rs
description: |
  
  import "go:bytes"
  
  fn main() {
    let f = bytes.Buffer.ReadString
    let mut buf = bytes.Buffer {}
    let _ = f(&buf, 10)
  }
---
package main

import (
	"bytes"

	lisette "github.com/ivov/lisette/prelude"
)

func main() {
	cb := (*bytes.Buffer).ReadString
	var adapted func(*bytes.Buffer, byte) lisette.Partial[string, error]
	if cb != nil {
		adapted = func(arg0 *bytes.Buffer, arg1 byte) lisette.Partial[string, error] {
			ret, ret2 := cb(arg0, arg1)
			if ret2 != nil {
				return lisette.MakePartialBoth[string, error](ret, ret2)
			}
			return lisette.MakePartialOk[string, error](ret)
		}
	}
	f := adapted
	buf := bytes.Buffer{}
	f(&buf, 10)
}
