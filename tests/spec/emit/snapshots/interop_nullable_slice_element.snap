---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:flag"
  
  fn main() {
    let arr: Slice<fn(string) -> Option<Ref<flag.Flag>>> = [flag.Lookup]
    let r = arr[0]("verbose")
    match r {
      Some(v) => { let _ = v },
      None => {},
    }
  }
---
package main

import (
	"flag"
	lisette "github.com/ivov/lisette/prelude"
)

func main() {
	arr := []func(string) lisette.Option[*flag.Flag]{func(arg0 string) lisette.Option[*flag.Flag] {
		raw := flag.Lookup(arg0)
		return lisette.OptionFromNilable[*flag.Flag](raw, raw == nil)
	}}
	r := arr[0]("verbose")
	if r.Tag == lisette.OptionSome {
		_ = r.SomeVal
	}
}
