---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:example.com/nested"
  
  fn main() {
    let values: Option<Slice<Option<int>>> = Some([Some(1), None])
    let container = nested.Container { Values: values }
    let roundtrip = container.Values
    let _ = roundtrip
  }
---
package main

import (
	"example.com/nested"
	lisette "github.com/ivov/lisette/prelude"
)

func main() {
	values := lisette.MakeOptionSome([]lisette.Option[int]{lisette.MakeOptionSome(1), lisette.MakeOptionNone[int]()})
	var ptr *[]*int
	if values.Tag == lisette.OptionSome {
		src := values.SomeVal
		unwrapped := make([]*int, len(src))
		for i, v := range src {
			if v.Tag == lisette.OptionSome {
				unwrapped[i] = &v.SomeVal
			} else {
				unwrapped[i] = nil
			}
		}
		ptr = &unwrapped
	}
	container := nested.Container{Values: ptr}
	raw := container.Values
	var option lisette.Option[[]lisette.Option[int]]
	if raw != nil {
		src2 := *raw
		wrapped := make([]lisette.Option[int], len(src2))
		for i2, v2 := range src2 {
			if v2 != nil {
				wrapped[i2] = lisette.MakeOptionSome[int](*v2)
			} else {
				wrapped[i2] = lisette.MakeOptionNone[int]()
			}
		}
		option = lisette.MakeOptionSome[[]lisette.Option[int]](wrapped)
	} else {
		option = lisette.MakeOptionNone[[]lisette.Option[int]]()
	}
	roundtrip := option
	_ = roundtrip
}
