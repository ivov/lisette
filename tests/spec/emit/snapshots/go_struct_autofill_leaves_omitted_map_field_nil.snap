---
source: tests/spec/emit/imports.rs
description: |
  
  import "go:encoding/pem"
  
  fn test() -> string {
    let b = pem.Block { Type: "X", .. }
    match b.Headers {
      Some(headers) => headers["key"],
      None => "",
    }
  }
---
package main

import (
	"encoding/pem"
	lisette "github.com/ivov/lisette/prelude"
)

func test() string {
	b := pem.Block{Type: "X"}
	raw := b.Headers
	option := lisette.OptionFromNilable[map[string]string](raw, raw == nil)
	if option.Tag == lisette.OptionSome {
		return option.SomeVal["key"]
	}
	return ""
}
