---
source: tests/spec/emit/imports.rs
description: |
  
  import "go:encoding/pem"
  
  fn test() -> string {
    let b = pem.Block { Type: "X", .. }
    match b.Headers {
      Some(headers) => headers["key"],
      None => "",
    }
  }
---
package main

import "encoding/pem"

func test() string {
	b := pem.Block{Type: "X"}
	if headers := b.Headers; headers != nil {
		return headers["key"]
	} else {
		return ""
	}
}
