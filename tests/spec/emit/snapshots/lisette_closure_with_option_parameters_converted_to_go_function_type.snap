    let w = walker(1)
    let _ = filepath.Walk(".", w)
  }
---
package main

import (
	"fmt"
	"io/fs"
	"path/filepath"

	lisette "github.com/ivov/lisette/prelude"
)

func walker(n int) filepath.WalkFunc {
	cb := func(p string, info lisette.Option[fs.FileInfo], err lisette.Option[error]) lisette.Result[struct{}, error] {
		fmt.Println(n, p, info.IsSome(), err.IsNone())
		return lisette.MakeResultOk[struct{}, error](struct{}{})
	}
	return filepath.WalkFunc(func(arg0 string, arg1 fs.FileInfo, arg2 error) error {
		option := lisette.OptionFromNilable[fs.FileInfo](arg1, lisette.IsNilInterface(arg1))
		option2 := lisette.OptionFromNilable[error](arg2, lisette.IsNilInterface(arg2))
		res := cb(arg0, option, option2)
		if res.Tag == lisette.ResultOk {
			return nil
		}
		return res.ErrVal
	})
}

func main() {
	w := walker(1)
	filepath.Walk(".", filepath.WalkFunc(w))
}
