---
source: tests/spec/emit/result_option_patterns.rs
description: |
  
  import "go:fmt"
  
  fn five(xs: Slice<int>) -> int {
    if let Some(x) = xs.find(|n| n > 1) {
      fmt.Println(x)
    }
    if let Some(x) = xs.find(|n| n > 2) {
      fmt.Println(x)
    }
    0
  }
---
package main

import "fmt"

func five(xs []int) int {
	var x int
	found_1 := false
	for _, n := range xs {
		if n > 1 {
			x = n
			found_1 = true
			break
		}
	}
	if found_1 {
		fmt.Println(x)
	}
	var x_2 int
	found_3 := false
	for _, n := range xs {
		if n > 2 {
			x_2 = n
			found_3 = true
			break
		}
	}
	if found_3 {
		fmt.Println(x_2)
	}
	return 0
}
