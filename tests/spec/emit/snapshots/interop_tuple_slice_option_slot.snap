---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:fmt"
  import "go:example.com/aws"
  
  fn main() {
    let (xs, n) = aws.Make()
    fmt.Println(n)
    for x in xs {
      match x {
        Some(v) => fmt.Println(v),
        None => fmt.Println("none"),
      }
    }
  }
---
package main

import (
	"example.com/aws"
	"fmt"
	lisette "github.com/ivov/lisette/prelude"
)

func main() {
	ret_1, ret_2 := aws.Make()
	wrapped_3 := make([]lisette.Option[string], len(ret_1))
	for i_4, v_5 := range ret_1 {
		if v_5 != nil {
			wrapped_3[i_4] = lisette.MakeOptionSome[string](*v_5)
		} else {
			wrapped_3[i_4] = lisette.MakeOptionNone[string]()
		}
	}
	tup_6 := lisette.MakeTuple2(wrapped_3, ret_2)
	xs := tup_6.First
	n := tup_6.Second
	fmt.Println(n)
	for _, x := range xs {
		if x.Tag == lisette.OptionSome {
			fmt.Println(x.SomeVal)
		} else {
			fmt.Println("none")
		}
	}
}
