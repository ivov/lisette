---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:example.com/lib"
  import "go:errors"
  import "go:strconv"
  
  fn lookup(path: string) -> Result<string, error> {
    if path == "" {
      return Err(errors.New("empty"))
    }
    Ok(path)
  }
  
  fn find(key: string) -> Option<Ref<lib.Item>> {
    if key == "" {
      return None
    }
    Some(&lib.Item { Name: key })
  }
  
  fn split(s: string) -> (int, string) {
    (s.length(), s)
  }
  
  fn main() {
    let _ = lib.UseLookup(Some(lookup))
    let _ = lib.UseLookup(Some(|p| Ok(p)))
    let _ = lib.UseLookup(None)
    let _ = lib.UseFind(Some(find))
    let _ = lib.UseSplit(Some(split))
    let _ = lib.UseAtoi(Some(strconv.Atoi))
  }
---
package main

import (
	"errors"
	"example.com/lib"
	lisette "github.com/ivov/lisette/prelude"
	"strconv"
)

func lookup(path string) (string, error) {
	if path == "" {
		return "", errors.New("empty")
	}
	return path, nil
}

func find(key string) *lib.Item {
	if key == "" {
		return nil
	}
	return &lib.Item{Name: key}
}

func split(s string) (int, string) {
	return len(s), s
}

func main() {
	cb := func(arg0 string) lisette.Result[string, error] {
		return lisette.ResultFromPair[string](lookup(arg0))
	}
	lib.UseLookup(func(arg0 string) (string, error) {
		res := cb(arg0)
		if res.Tag == lisette.ResultOk {
			return res.OkVal, nil
		}
		return "", res.ErrVal
	})
	lib.UseLookup(func(p string) (string, error) {
		return p, nil
	})
	lib.UseLookup(nil)
	cb_1 := func(arg0 string) lisette.Option[*lib.Item] {
		raw := find(arg0)
		option := lisette.OptionFromNilable[*lib.Item](raw, raw == nil)
		return option
	}
	lib.UseFind(func(arg0 string) *lib.Item {
		res_1 := cb_1(arg0)
		if res_1.Tag == lisette.OptionSome {
			return res_1.SomeVal
		}
		return nil
	})
	cb_2 := func(arg0 string) lisette.Tuple2[int, string] {
		ret, ret_1 := split(arg0)
		tup := lisette.MakeTuple2(ret, ret_1)
		return tup
	}
	lib.UseSplit(func(arg0 string) (int, string) {
		res_2 := cb_2(arg0)
		return res_2.First, res_2.Second
	})
	lib.UseAtoi(strconv.Atoi)
}
