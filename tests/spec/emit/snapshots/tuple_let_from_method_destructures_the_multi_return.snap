---
package main

import "fmt"

type Store struct {
	count int
}

func (s Store) split() (int, int) {
	return s.count / 2, s.count - s.count/2
}

func main() {
	store := Store{count: 7}
	left, right := store.split()
	fmt.Println(left, right)
}
