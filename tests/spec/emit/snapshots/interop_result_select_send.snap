---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:strconv"
  
  fn main() {
    let ch = Channel.new<fn(string) -> Result<int, error>>()
    select {
      ch.send(strconv.Atoi) => { let _ = 0 },
      _ => { let _ = 1 },
    }
  }
---
package main

import (
	lisette "github.com/ivov/lisette/prelude"
	"strconv"
)

func main() {
	ch := make(chan func(string) lisette.Result[int, error])
	select {
	case ch <- func(arg0 string) lisette.Result[int, error] {
		return lisette.ResultFromPair[int](strconv.Atoi(arg0))
	}:
	default:
	}
}
