---
package main

import (
	"encoding/json"
	"net/url"
	"strings"
)

func hasUser(u *url.URL) bool {
	return u.Host == "" || u.User != nil
}

func decodes(text string, items *[]int) bool {
	return strings.HasPrefix(text, "[") && json.Unmarshal(([]byte)(text), items) == nil
}
