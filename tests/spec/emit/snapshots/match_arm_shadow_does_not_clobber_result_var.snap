---
source: tests/spec/emit/control_flow.rs
description: |
  
  fn test(x: int) -> string {
    let result = match x {
      n if n < 10 => {
        let result = n * n
        f"small({result})"
      },
      _ => "other",
    }
    result
  }
---
package main

import "fmt"

func test(x int) string {
	var result string
match_1:
	for {
		{
			n := x
			if n < 10 {
				result_2 := n * n
				result = fmt.Sprintf("small(%d)", result_2)
				break match_1
			}
		}
		{
			result = "other"
			break match_1
		}
	}
	return result
}
