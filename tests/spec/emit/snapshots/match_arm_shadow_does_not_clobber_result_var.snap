---
source: tests/spec/emit/control_flow.rs
description: |
  
  fn test(x: int) -> string {
    let result = match x {
      n if n < 10 => {
        let result = n * n
        f"small({result})"
      },
      _ => "other",
    }
    result
  }
---
package main

import "fmt"

func test(x int) string {
	var result string
	switch {
	case x < 10:
		n := x
		result_1 := n * n
		result = fmt.Sprintf("small(%d)", result_1)
	default:
		result = "other"
	}
	return result
}
