---
source: tests/spec/emit/result_option_patterns.rs
description: |
  
  import "go:os"
  import "go:fmt"
  
  fn test() {
    match os.Remove("f") {
      Ok(x) => { fmt.Println(x) },
      Err(e) => { fmt.Println(e) },
    }
  }
---
package main

import (
	"fmt"
	"os"
)

func test() {
	if e := os.Remove("f"); e == nil {
		x := struct{}{}
		fmt.Println(x)
	} else {
		fmt.Println(e)
	}
}
