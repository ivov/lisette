---
source: tests/spec/emit/functions.rs
description: |
  
  fn main(){let mut n=0;let mut f:fn(int)=|x|{n+=x};let r=&f;f=|x|{n+=10*x};r.*(3);if n!=30{panic("read storage")}}
---
package main

func main() {
	n := 0
	f := func(x int) struct{} {
		n += x
		return struct{}{}
	}
	r := &f
	f = func(x int) struct{} {
		n += 10 * x
		return struct{}{}
	}
	(*r)(3)
	if n != 30 {
		panic("read storage")
	}
}
