---
source: tests/spec/emit/prelude.rs
description: |
  
  fn test() {
    let x = 7
    let f = || {
      let x = { [x, x + 1].fold(0, |x, y| x + y) }
      x
    }
    if f() != 15 { panic("the receiver should read the captured x") }
    let range = 7
    let g = || {
      let range = { [range, range + 1].fold(0, |range, y| range + y) }
      range
    }
    if g() != 15 { panic("the receiver should read the captured range") }
  }
---
package main

func test() {
	x := 7
	f := func() int {
		var x2 int
		x3 := 0
		for _, y := range []int{x, x + 1} {
			x3 += y
		}
		x2 = x3
		return x2
	}
	if f() != 15 {
		panic("the receiver should read the captured x")
	}
	range_ := 7
	g := func() int {
		var range2 int
		range3 := 0
		for _, y := range []int{range_, range_ + 1} {
			range3 += y
		}
		range2 = range3
		return range2
	}
	if g() != 15 {
		panic("the receiver should read the captured range")
	}
}
