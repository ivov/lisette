---
source: tests/spec/emit/types.rs
description: |
  
  type Res<T> = Result<T, error>
  
  fn make(x: int) -> Result<int, error> {
    Ok(x)
  }
  
  fn apply(f: fn(int) -> Res<int>) -> Res<int> {
    f(1)
  }
  
  fn main() {
    let _ = apply(make)
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

type Res[T any] = lisette.Result[T, error]

func make_(x int) (int, error) {
	return x, nil
}

func apply(f func(int) Res[int]) (int, error) {
	v := f(1)
	if v.Tag == lisette.ResultOk {
		return v.OkVal, nil
	}
	return 0, v.ErrVal
}

func main() {
	cb := make_
	var adapted func(int) lisette.Result[int, error]
	if cb != nil {
		adapted = func(arg0 int) lisette.Result[int, error] {
			return lisette.ResultFromPair[int](cb(arg0))
		}
	}
	cb_1 := adapted
	var adapted_1 func(int) Res[int]
	if cb_1 != nil {
		adapted_1 = func(arg0 int) Res[int] {
			return cb_1(arg0)
		}
	}
	apply(adapted_1)
}
