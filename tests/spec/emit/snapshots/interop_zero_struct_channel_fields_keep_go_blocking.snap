package main

import (
	"example.com/nilchan"
	lisette "github.com/ivov/lisette/prelude"
)

func main() {
	box := nilchan.Empty()
	lisette.SenderSend(box.Tx, 1)
	lisette.ChannelReceive(box.Ch)
	for range box.Rx {
	}
}
