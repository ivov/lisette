---
source: tests/spec/emit/result_option_patterns.rs
description: |
  
  import "go:strconv"
  
  fn parse(text: string) -> int {
    let parsed = strconv.Atoi(text)
    match parsed { Ok(value) => value, Err(_) => -1 }
  }
  
  fn parse_or_default(text: string) -> int {
    let parsed = strconv.Atoi(text)
    parsed.unwrap_or(7)
  }
  
  fn failed(text: string) -> bool {
    let parsed = strconv.Atoi(text)
    parsed.is_err()
  }
  
  fn test() {
    if parse("41") != 41 { panic("a parsed number should come back") }
    if parse("x") != -1 { panic("a failed parse should return minus one") }
    if parse_or_default("x") != 7 { panic("a failed parse should take the default") }
    if !failed("x") { panic("a failed parse should report failure") }
    if failed("2") { panic("a parsed number should not report failure") }
  }
---
package main

import "strconv"

func parse(text string) int {
	parsed, err := strconv.Atoi(text)
	value := parsed
	if err == nil {
		return value
	}
	return -1
}

func parseOrDefault(text string) int {
	parsed, err := strconv.Atoi(text)
	if err != nil {
		parsed = 7
	}
	return parsed
}

func failed(text string) bool {
	_, err := strconv.Atoi(text)
	return err != nil
}

func test() {
	if parse("41") != 41 {
		panic("a parsed number should come back")
	}
	if parse("x") != -1 {
		panic("a failed parse should return minus one")
	}
	if parseOrDefault("x") != 7 {
		panic("a failed parse should take the default")
	}
	if !failed("x") {
		panic("a failed parse should report failure")
	}
	if failed("2") {
		panic("a parsed number should not report failure")
	}
}
