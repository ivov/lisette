---
source: tests/spec/emit/functions.rs
description: |
  
  fn double(x: int) -> Option<int> { Some(x + x) }
  
  fn run() -> Option<int> {
    Option.and_then(Some(2), double)
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

func double(x int) (int, bool) {
	return x + x, true
}

func run() (int, bool) {
	cb := double
	tagged := func(arg0 int) lisette.Option[int] {
		return lisette.OptionFromCommaOk[int](cb(arg0))
	}
	v := lisette.OptionAndThen(lisette.MakeOptionSome(2), tagged)
	if v.Tag == lisette.OptionSome {
		return v.SomeVal, true
	}
	return 0, false
}
