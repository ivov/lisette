---
source: tests/spec/emit/partial.rs
description: |
  
  import "go:errors"
  
  fn attempt(ok: bool) -> Partial<int, error> {
    if ok { Partial.Ok(1) } else { Partial.Err(errors.New("nope")) }
  }
  
  fn test() -> int {
    match attempt(true) {
      Partial.Ok(n) => n,
      Partial.Both(n, _) => n,
      Partial.Err(_) => 0,
    }
  }
---
package main

import (
	"errors"
	lisette "github.com/ivov/lisette/prelude"
)

func attempt(ok bool) lisette.Partial[int, error] {
	if ok {
		return lisette.MakePartialOk[int, error](1)
	}
	return lisette.MakePartialErr[int, error](errors.New("nope"))
}

func test() int {
	subject := attempt(true)
	switch subject.Tag {
	case lisette.PartialOk:
		return subject.OkVal
	case lisette.PartialBoth:
		return subject.OkVal
	default:
		return 0
	}
}
