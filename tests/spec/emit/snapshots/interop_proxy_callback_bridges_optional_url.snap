---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:net/http"
  import "go:net/url"
  
  fn main() {
    let Ok(req) = http.NewRequest("GET", "http://localhost", None) else { panic("request") }
    let Ok(None) = http.ProxyFromEnvironment(req) else { panic("localhost is never proxied") }
  
    let env = http.Transport { Proxy: Some(http.ProxyFromEnvironment), .. }
    let Some(proxy) = env.Proxy else { panic("no environment callback") }
    let Ok(None) = proxy(req) else { panic("environment callback found a proxy") }
  
    let none = http.Transport { Proxy: Some(|_| Ok(None)), .. }
    let Some(proxy) = none.Proxy else { panic("no closure callback") }
    let Ok(None) = proxy(req) else { panic("closure callback lost None") }
  
    let Ok(u) = url.Parse("http://proxy.example:8080") else { panic("url") }
    let fixed = http.Transport { Proxy: http.ProxyURL(u), .. }
    let Some(proxy) = fixed.Proxy else { panic("no fixed callback") }
    let Ok(Some(found)) = proxy(req) else { panic("fixed callback lost the url") }
    if found.String() != "http://proxy.example:8080" { panic("fixed callback changed the url") }
  }
---
package main

import (
	lisette "github.com/ivov/lisette/prelude"
	"net/http"
	"net/url"
)

func main() {
	req, err := http.NewRequest("GET", "http://localhost", nil)
	if err != nil || req == nil {
		panic("request")
	}
	ret, ret_1 := http.ProxyFromEnvironment(req)
	var result lisette.Result[lisette.Option[*url.URL], error]
	if ret_1 != nil {
		result = lisette.MakeResultErr[lisette.Option[*url.URL], error](ret_1)
	} else {
		option := lisette.OptionFromNilable[*url.URL](ret, ret == nil)
		result = lisette.MakeResultOk[lisette.Option[*url.URL], error](option)
	}
	if !(result.Tag == lisette.ResultOk && result.OkVal.Tag == lisette.OptionNone) {
		panic("localhost is never proxied")
	}
	cb := func(arg0 *http.Request) lisette.Result[lisette.Option[*url.URL], error] {
		ret_2, ret_3 := http.ProxyFromEnvironment(arg0)
		if ret_3 != nil {
			return lisette.MakeResultErr[lisette.Option[*url.URL], error](ret_3)
		}
		option_1 := lisette.OptionFromNilable[*url.URL](ret_2, ret_2 == nil)
		return lisette.MakeResultOk[lisette.Option[*url.URL], error](option_1)
	}
	env := http.Transport{Proxy: func(arg0 *http.Request) (*url.URL, error) {
		ret_4, ret_5 := func() (lisette.Option[*url.URL], error) {
			res := cb(arg0)
			if res.Tag == lisette.ResultOk {
				return res.OkVal, nil
			}
			return lisette.Option[*url.URL]{}, res.ErrVal
		}()
		var unwrap *url.URL
		if ret_4.Tag == lisette.OptionSome {
			unwrap = ret_4.SomeVal
		}
		return unwrap, ret_5
	}}
	raw := env.Proxy
	var option_2 lisette.Option[func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]]
	if raw != nil {
		cb_1 := raw
		var adapted func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]
		if cb_1 != nil {
			adapted = func(arg0 *http.Request) lisette.Result[lisette.Option[*url.URL], error] {
				ret_6, ret_7 := cb_1(arg0)
				if ret_7 != nil {
					return lisette.MakeResultErr[lisette.Option[*url.URL], error](ret_7)
				}
				option_3 := lisette.OptionFromNilable[*url.URL](ret_6, ret_6 == nil)
				return lisette.MakeResultOk[lisette.Option[*url.URL], error](option_3)
			}
		}
		option_2 = lisette.MakeOptionSome[func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]](adapted)
	} else {
		option_2 = lisette.MakeOptionNone[func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]]()
	}
	if option_2.Tag != lisette.OptionSome {
		panic("no environment callback")
	}
	proxy := option_2.SomeVal
	subject := proxy(req)
	if !(subject.Tag == lisette.ResultOk && subject.OkVal.Tag == lisette.OptionNone) {
		panic("environment callback found a proxy")
	}
	cb_2 := func(_ *http.Request) lisette.Result[lisette.Option[*url.URL], error] {
		return lisette.MakeResultOk[lisette.Option[*url.URL], error](lisette.MakeOptionNone[*url.URL]())
	}
	none := http.Transport{Proxy: func(arg0 *http.Request) (*url.URL, error) {
		ret_8, ret_9 := func() (lisette.Option[*url.URL], error) {
			res_1 := cb_2(arg0)
			if res_1.Tag == lisette.ResultOk {
				return res_1.OkVal, nil
			}
			return lisette.Option[*url.URL]{}, res_1.ErrVal
		}()
		var unwrap_1 *url.URL
		if ret_8.Tag == lisette.OptionSome {
			unwrap_1 = ret_8.SomeVal
		}
		return unwrap_1, ret_9
	}}
	raw_1 := none.Proxy
	var option_4 lisette.Option[func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]]
	if raw_1 != nil {
		cb_3 := raw_1
		var adapted_1 func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]
		if cb_3 != nil {
			adapted_1 = func(arg0 *http.Request) lisette.Result[lisette.Option[*url.URL], error] {
				ret_10, ret_11 := cb_3(arg0)
				if ret_11 != nil {
					return lisette.MakeResultErr[lisette.Option[*url.URL], error](ret_11)
				}
				option_5 := lisette.OptionFromNilable[*url.URL](ret_10, ret_10 == nil)
				return lisette.MakeResultOk[lisette.Option[*url.URL], error](option_5)
			}
		}
		option_4 = lisette.MakeOptionSome[func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]](adapted_1)
	} else {
		option_4 = lisette.MakeOptionNone[func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]]()
	}
	if option_4.Tag != lisette.OptionSome {
		panic("no closure callback")
	}
	proxy_1 := option_4.SomeVal
	subject_1 := proxy_1(req)
	if !(subject_1.Tag == lisette.ResultOk && subject_1.OkVal.Tag == lisette.OptionNone) {
		panic("closure callback lost None")
	}
	u, err_1 := url.Parse("http://proxy.example:8080")
	if err_1 != nil || u == nil {
		panic("url")
	}
	raw_2 := http.ProxyURL(u)
	var option_6 lisette.Option[func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]]
	if raw_2 != nil {
		cb_4 := raw_2
		var adapted_2 func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]
		if cb_4 != nil {
			adapted_2 = func(arg0 *http.Request) lisette.Result[lisette.Option[*url.URL], error] {
				ret_12, ret_13 := cb_4(arg0)
				if ret_13 != nil {
					return lisette.MakeResultErr[lisette.Option[*url.URL], error](ret_13)
				}
				option_7 := lisette.OptionFromNilable[*url.URL](ret_12, ret_12 == nil)
				return lisette.MakeResultOk[lisette.Option[*url.URL], error](option_7)
			}
		}
		option_6 = lisette.MakeOptionSome[func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]](adapted_2)
	} else {
		option_6 = lisette.MakeOptionNone[func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]]()
	}
	var unwrap_2 func(*http.Request) (*url.URL, error)
	if option_6.Tag == lisette.OptionSome {
		cb_5 := option_6.SomeVal
		var adapted_3 func(*http.Request) (*url.URL, error)
		if cb_5 != nil {
			adapted_3 = func(arg0 *http.Request) (*url.URL, error) {
				ret_14, ret_15 := func() (lisette.Option[*url.URL], error) {
					res_2 := cb_5(arg0)
					if res_2.Tag == lisette.ResultOk {
						return res_2.OkVal, nil
					}
					return lisette.Option[*url.URL]{}, res_2.ErrVal
				}()
				var unwrap_3 *url.URL
				if ret_14.Tag == lisette.OptionSome {
					unwrap_3 = ret_14.SomeVal
				}
				return unwrap_3, ret_15
			}
		}
		unwrap_2 = adapted_3
	}
	fixed := http.Transport{Proxy: unwrap_2}
	raw_3 := fixed.Proxy
	var option_8 lisette.Option[func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]]
	if raw_3 != nil {
		cb_6 := raw_3
		var adapted_4 func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]
		if cb_6 != nil {
			adapted_4 = func(arg0 *http.Request) lisette.Result[lisette.Option[*url.URL], error] {
				ret_16, ret_17 := cb_6(arg0)
				if ret_17 != nil {
					return lisette.MakeResultErr[lisette.Option[*url.URL], error](ret_17)
				}
				option_9 := lisette.OptionFromNilable[*url.URL](ret_16, ret_16 == nil)
				return lisette.MakeResultOk[lisette.Option[*url.URL], error](option_9)
			}
		}
		option_8 = lisette.MakeOptionSome[func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]](adapted_4)
	} else {
		option_8 = lisette.MakeOptionNone[func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]]()
	}
	if option_8.Tag != lisette.OptionSome {
		panic("no fixed callback")
	}
	proxy_2 := option_8.SomeVal
	subject_2 := proxy_2(req)
	if !(subject_2.Tag == lisette.ResultOk && subject_2.OkVal.Tag == lisette.OptionSome) {
		panic("fixed callback lost the url")
	}
	found := subject_2.OkVal.SomeVal
	if found.String() != "http://proxy.example:8080" {
		panic("fixed callback changed the url")
	}
}
