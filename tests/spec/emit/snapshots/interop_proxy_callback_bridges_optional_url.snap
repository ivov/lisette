---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:net/http"
  import "go:net/url"
  
  fn main() {
    let Ok(req) = http.NewRequest("GET", "http://localhost", None) else { panic("request") }
    let Ok(None) = http.ProxyFromEnvironment(req) else { panic("localhost is never proxied") }
  
    let env = http.Transport { Proxy: Some(http.ProxyFromEnvironment), .. }
    let Some(proxy) = env.Proxy else { panic("no environment callback") }
    let Ok(None) = proxy(req) else { panic("environment callback found a proxy") }
  
    let none = http.Transport { Proxy: Some(|_| Ok(None)), .. }
    let Some(proxy) = none.Proxy else { panic("no closure callback") }
    let Ok(None) = proxy(req) else { panic("closure callback lost None") }
  
    let Ok(u) = url.Parse("http://proxy.example:8080") else { panic("url") }
    let fixed = http.Transport { Proxy: http.ProxyURL(u), .. }
    let Some(proxy) = fixed.Proxy else { panic("no fixed callback") }
    let Ok(Some(found)) = proxy(req) else { panic("fixed callback lost the url") }
    if found.String() != "http://proxy.example:8080" { panic("fixed callback changed the url") }
  }
---
package main

import (
	lisette "github.com/ivov/lisette/prelude"
	"net/http"
	"net/url"
)

func main() {
	req, err := http.NewRequest("GET", "http://localhost", nil)
	if err != nil || req == nil {
		panic("request")
	}
	ret, ret2 := http.ProxyFromEnvironment(req)
	var result lisette.Result[lisette.Option[*url.URL], error]
	if ret2 != nil {
		result = lisette.MakeResultErr[lisette.Option[*url.URL], error](ret2)
	} else {
		option := lisette.OptionFromNilable[*url.URL](ret, ret == nil)
		result = lisette.MakeResultOk[lisette.Option[*url.URL], error](option)
	}
	if !(result.Tag == lisette.ResultOk && result.OkVal.Tag == lisette.OptionNone) {
		panic("localhost is never proxied")
	}
	cb := func(arg0 *http.Request) lisette.Result[lisette.Option[*url.URL], error] {
		ret3, ret4 := http.ProxyFromEnvironment(arg0)
		if ret4 != nil {
			return lisette.MakeResultErr[lisette.Option[*url.URL], error](ret4)
		}
		option2 := lisette.OptionFromNilable[*url.URL](ret3, ret3 == nil)
		return lisette.MakeResultOk[lisette.Option[*url.URL], error](option2)
	}
	env := http.Transport{Proxy: func(arg0 *http.Request) (*url.URL, error) {
		ret5, ret6 := func() (lisette.Option[*url.URL], error) {
			res := cb(arg0)
			if res.Tag == lisette.ResultOk {
				return res.OkVal, nil
			}
			return lisette.Option[*url.URL]{}, res.ErrVal
		}()
		var unwrap *url.URL
		if ret5.Tag == lisette.OptionSome {
			unwrap = ret5.SomeVal
		}
		return unwrap, ret6
	}}
	raw := env.Proxy
	var option3 lisette.Option[func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]]
	if raw != nil {
		cb2 := raw
		var adapted func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]
		if cb2 != nil {
			adapted = func(arg0 *http.Request) lisette.Result[lisette.Option[*url.URL], error] {
				ret7, ret8 := cb2(arg0)
				if ret8 != nil {
					return lisette.MakeResultErr[lisette.Option[*url.URL], error](ret8)
				}
				option4 := lisette.OptionFromNilable[*url.URL](ret7, ret7 == nil)
				return lisette.MakeResultOk[lisette.Option[*url.URL], error](option4)
			}
		}
		option3 = lisette.MakeOptionSome[func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]](adapted)
	} else {
		option3 = lisette.MakeOptionNone[func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]]()
	}
	if option3.Tag != lisette.OptionSome {
		panic("no environment callback")
	}
	proxy := option3.SomeVal
	subject := proxy(req)
	if !(subject.Tag == lisette.ResultOk && subject.OkVal.Tag == lisette.OptionNone) {
		panic("environment callback found a proxy")
	}
	cb3 := func(_ *http.Request) lisette.Result[lisette.Option[*url.URL], error] {
		return lisette.MakeResultOk[lisette.Option[*url.URL], error](lisette.MakeOptionNone[*url.URL]())
	}
	none := http.Transport{Proxy: func(arg0 *http.Request) (*url.URL, error) {
		ret9, ret10 := func() (lisette.Option[*url.URL], error) {
			res2 := cb3(arg0)
			if res2.Tag == lisette.ResultOk {
				return res2.OkVal, nil
			}
			return lisette.Option[*url.URL]{}, res2.ErrVal
		}()
		var unwrap2 *url.URL
		if ret9.Tag == lisette.OptionSome {
			unwrap2 = ret9.SomeVal
		}
		return unwrap2, ret10
	}}
	raw2 := none.Proxy
	var option5 lisette.Option[func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]]
	if raw2 != nil {
		cb4 := raw2
		var adapted2 func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]
		if cb4 != nil {
			adapted2 = func(arg0 *http.Request) lisette.Result[lisette.Option[*url.URL], error] {
				ret11, ret12 := cb4(arg0)
				if ret12 != nil {
					return lisette.MakeResultErr[lisette.Option[*url.URL], error](ret12)
				}
				option6 := lisette.OptionFromNilable[*url.URL](ret11, ret11 == nil)
				return lisette.MakeResultOk[lisette.Option[*url.URL], error](option6)
			}
		}
		option5 = lisette.MakeOptionSome[func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]](adapted2)
	} else {
		option5 = lisette.MakeOptionNone[func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]]()
	}
	if option5.Tag != lisette.OptionSome {
		panic("no closure callback")
	}
	proxy2 := option5.SomeVal
	subject2 := proxy2(req)
	if !(subject2.Tag == lisette.ResultOk && subject2.OkVal.Tag == lisette.OptionNone) {
		panic("closure callback lost None")
	}
	u, err2 := url.Parse("http://proxy.example:8080")
	if err2 != nil || u == nil {
		panic("url")
	}
	raw3 := http.ProxyURL(u)
	var option7 lisette.Option[func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]]
	if raw3 != nil {
		cb5 := raw3
		var adapted3 func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]
		if cb5 != nil {
			adapted3 = func(arg0 *http.Request) lisette.Result[lisette.Option[*url.URL], error] {
				ret13, ret14 := cb5(arg0)
				if ret14 != nil {
					return lisette.MakeResultErr[lisette.Option[*url.URL], error](ret14)
				}
				option8 := lisette.OptionFromNilable[*url.URL](ret13, ret13 == nil)
				return lisette.MakeResultOk[lisette.Option[*url.URL], error](option8)
			}
		}
		option7 = lisette.MakeOptionSome[func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]](adapted3)
	} else {
		option7 = lisette.MakeOptionNone[func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]]()
	}
	var unwrap3 func(*http.Request) (*url.URL, error)
	if option7.Tag == lisette.OptionSome {
		cb6 := option7.SomeVal
		var adapted4 func(*http.Request) (*url.URL, error)
		if cb6 != nil {
			adapted4 = func(arg0 *http.Request) (*url.URL, error) {
				ret15, ret16 := func() (lisette.Option[*url.URL], error) {
					res3 := cb6(arg0)
					if res3.Tag == lisette.ResultOk {
						return res3.OkVal, nil
					}
					return lisette.Option[*url.URL]{}, res3.ErrVal
				}()
				var unwrap4 *url.URL
				if ret15.Tag == lisette.OptionSome {
					unwrap4 = ret15.SomeVal
				}
				return unwrap4, ret16
			}
		}
		unwrap3 = adapted4
	}
	fixed := http.Transport{Proxy: unwrap3}
	raw4 := fixed.Proxy
	var option9 lisette.Option[func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]]
	if raw4 != nil {
		cb7 := raw4
		var adapted5 func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]
		if cb7 != nil {
			adapted5 = func(arg0 *http.Request) lisette.Result[lisette.Option[*url.URL], error] {
				ret17, ret18 := cb7(arg0)
				if ret18 != nil {
					return lisette.MakeResultErr[lisette.Option[*url.URL], error](ret18)
				}
				option10 := lisette.OptionFromNilable[*url.URL](ret17, ret17 == nil)
				return lisette.MakeResultOk[lisette.Option[*url.URL], error](option10)
			}
		}
		option9 = lisette.MakeOptionSome[func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]](adapted5)
	} else {
		option9 = lisette.MakeOptionNone[func(*http.Request) lisette.Result[lisette.Option[*url.URL], error]]()
	}
	if option9.Tag != lisette.OptionSome {
		panic("no fixed callback")
	}
	proxy3 := option9.SomeVal
	subject3 := proxy3(req)
	if !(subject3.Tag == lisette.ResultOk && subject3.OkVal.Tag == lisette.OptionSome) {
		panic("fixed callback lost the url")
	}
	found := subject3.OkVal.SomeVal
	if found.String() != "http://proxy.example:8080" {
		panic("fixed callback changed the url")
	}
}
