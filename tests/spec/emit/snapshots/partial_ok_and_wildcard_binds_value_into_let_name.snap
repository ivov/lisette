---
package main

import (
	"io"
	"strings"
)

func sizes(items []string) int {
	total := 0
	for _, s := range items {
		body, err := io.ReadAll(strings.NewReader(s))
		if err != nil {
			continue
		}
		total += len(body)
	}
	return total
}
