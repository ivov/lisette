---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:iter"
  import "go:slices"
  
  fn main() {
    let s: Option<iter.Seq<int>> = Some(slices.Values([1, 2, 3]))
    let _ = s.map(iter.Pull)
  }
---
package main

import (
	lisette "github.com/ivov/lisette/prelude"
	"iter"
	"slices"
)

func main() {
	s := lisette.MakeOptionSome[iter.Seq[int]](slices.Values([]int{1, 2, 3}))
	lisette.OptionMap(s, func(arg0 iter.Seq[int]) lisette.Tuple2[lisette.Option[func() lisette.Option[int]], lisette.Option[func() struct{}]] {
		ret, ret2 := iter.Pull[int](arg0)
		var option lisette.Option[func() lisette.Option[int]]
		if ret != nil {
			cb := ret
			var adapted func() lisette.Option[int]
			if cb != nil {
				adapted = func() lisette.Option[int] {
					return lisette.OptionFromCommaOk[int](cb())
				}
			}
			option = lisette.MakeOptionSome[func() lisette.Option[int]](adapted)
		} else {
			option = lisette.MakeOptionNone[func() lisette.Option[int]]()
		}
		var option2 lisette.Option[func() struct{}]
		if ret2 != nil {
			cb2 := ret2
			var adapted2 func() struct{}
			if cb2 != nil {
				adapted2 = func() struct{} {
					cb2()
					return struct{}{}
				}
			}
			option2 = lisette.MakeOptionSome[func() struct{}](adapted2)
		} else {
			option2 = lisette.MakeOptionNone[func() struct{}]()
		}
		tup := lisette.MakeTuple2(option, option2)
		return tup
	})
}
