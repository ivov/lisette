package main

import (
	"crypto/tls"
	"net/http"
)

type Wrapper struct {
	srv http.Server
}

func test() Wrapper {
	return Wrapper{srv: http.Server{TLSNextProto: map[string]func(*http.Server, *tls.Conn, http.Handler){}}}
}
