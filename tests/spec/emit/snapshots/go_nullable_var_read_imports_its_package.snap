---
package main

import (
	"io"

	"example.com/vars"
	lisette "github.com/ivov/lisette/prelude"
)

func hasOutput() bool {
	raw := vars.Output
	output := lisette.OptionFromNilable[io.Writer](raw, lisette.IsNilInterface(raw))
	return output.IsSome()
}
