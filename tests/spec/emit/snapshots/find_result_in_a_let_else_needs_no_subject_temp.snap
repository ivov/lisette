---
source: tests/spec/emit/result_option_patterns.rs
description: |
  
  import "go:fmt"
  
  fn main() {
    let nums = [1, 2, 3]
    let Some(even) = nums.find(|n| n % 2 == 0) else { return }
    fmt.Println(even)
  }
---
package main

import "fmt"

func main() {
	nums := []int{1, 2, 3}
	var even int
	found_1 := false
	for _, n := range nums {
		if n%2 == 0 {
			even = n
			found_1 = true
			break
		}
	}
	if !found_1 {
		return
	}
	fmt.Println(even)
}
