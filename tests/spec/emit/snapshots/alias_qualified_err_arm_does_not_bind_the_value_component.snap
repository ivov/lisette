---
source: tests/spec/emit/result_option_patterns.rs
description: |
  
  import "go:fmt"
  import "go:strconv"
  
  type Res = Result<int, error>
  
  fn parse(text: string) -> int {
    let r = strconv.Atoi(text)
    match r {
      Ok(_) => 1,
      Res.Err(e) => {
        fmt.Println(e)
        0
      },
    }
  }
---
package main

import (
	"fmt"
	"strconv"

	lisette "github.com/ivov/lisette/prelude"
)

type Res = lisette.Result[int, error]

func parse(text string) int {
	_, err := strconv.Atoi(text)
	if err != nil {
		fmt.Println(err)
		return 0
	}
	return 1
}
