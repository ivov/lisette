---
source: tests/spec/emit/functions.rs
description: |
  
  struct Holder<T, U> { f: fn(T) -> U }
  fn some<T>(x: T) -> Option<T> { Some(x) }
  fn main() {
    let x = 3
    let mut holder: Holder<Ref<int>, Option<Ref<int>>> = Holder { f: some }
    let Some(a) = holder.f(&x) else { panic("field call") }
    let stored = holder.f
    let Some(b) = stored(&x) else { panic("stored field") }
    holder.f = some
    let Some(c) = holder.f(&x) else { panic("assigned field") }
    if a != &x || b != &x || c != &x { panic("field payloads") }
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

type Holder[T any, U any] struct {
	f func(T) U
}

func some[T any](x T) (T, bool) {
	return x, true
}

func main() {
	x := 3
	holder := Holder[*int, lisette.Option[*int]]{f: func(arg0 *int) lisette.Option[*int] {
		ret, ret2 := some[*int](arg0)
		if ret2 && ret != nil {
			return lisette.MakeOptionSome[*int](ret)
		}
		return lisette.MakeOptionNone[*int]()
	}}
	subject := holder.f(&x)
	if subject.Tag != lisette.OptionSome {
		panic("field call")
	}
	a := subject.SomeVal
	stored := holder.f
	subject2 := stored(&x)
	if subject2.Tag != lisette.OptionSome {
		panic("stored field")
	}
	b := subject2.SomeVal
	holder.f = func(arg0 *int) lisette.Option[*int] {
		ret3, ret4 := some[*int](arg0)
		if ret4 && ret3 != nil {
			return lisette.MakeOptionSome[*int](ret3)
		}
		return lisette.MakeOptionNone[*int]()
	}
	subject3 := holder.f(&x)
	if subject3.Tag != lisette.OptionSome {
		panic("assigned field")
	}
	c := subject3.SomeVal
	if a != &x || b != &x || c != &x {
		panic("field payloads")
	}
}
