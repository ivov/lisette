---
source: tests/spec/emit/expressions.rs
description: |
  
  struct Outer { items: Ref<Slice<int>> }
  
  fn main() {
    let mut items = [1]
    let mut m = Map.new<string, Outer>()
    m["a"] = Outer { items: &items }
    let Some(o) = m.get("a") else { return; };
    let _ = { o.items.*.append(2) }
    let _ = items
  }
---
package main

type Outer struct {
	items *[]int
}

func main() {
	items := []int{1}
	m := make(map[string]Outer)
	m["a"] = Outer{items: &items}
	o, ok := m["a"]
	if !ok {
		return
	}
	var tmp_1 []int
	recv_2 := *o.items
	tmp_1 = append(recv_2[:len(recv_2):len(recv_2)], 2)
	_ = tmp_1
	_ = items
}
