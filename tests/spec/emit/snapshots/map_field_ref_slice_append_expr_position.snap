---
source: tests/spec/emit/expressions.rs
description: |
  
  struct Outer { items: Ref<Slice<int>> }
  
  fn main() {
    let mut items = [1]
    let mut m = Map.new<string, Outer>()
    m["a"] = Outer { items: &items }
    let Some(o) = m.get("a") else { return; };
    let _ = { o.items.*.append(2) }
    let _ = items
  }
---
package main

type Outer struct {
	items *[]int
}

func main() {
	items := []int{1}
	m := make(map[string]Outer)
	m["a"] = Outer{items: &items}
	o, ok_1 := m["a"]
	if !ok_1 {
		return
	}
	var tmp_2 []int
	recv_3 := *o.items
	tmp_2 = append(recv_3[:len(recv_3):len(recv_3)], 2)
	_ = tmp_2
	_ = items
}
