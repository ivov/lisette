---
source: tests/spec/emit/concurrency.rs
description: |
  
  fn drain(ch: Ref<Channel<int>>) {
    let (tx, rx) = ch.split();
    tx.send(42);
    let _ = rx.receive();
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

func drain(ch *chan int) {
	ch2 := *ch
	var tx chan<- int = ch2
	var rx <-chan int = ch2
	lisette.SenderSend(tx, 42)
	lisette.ReceiverReceive(rx)
}
