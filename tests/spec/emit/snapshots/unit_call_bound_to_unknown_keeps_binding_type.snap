---
source: tests/spec/emit/types.rs
description: |
  
  type U = ()
  
  fn id<T>(v: T) -> T {
    v
  }
  
  fn test() {
    let mut a: Unknown = id<U>(())
    a = 1
    let mut b: Unknown = id<()>(())
    b = 2
    let _ = a
    let _ = b
  }
---
package main

type U = struct{}

func id[T any](v T) T {
	return v
}

func test() {
	id[U](struct{}{})
	var a any = struct{}{}
	a = 1
	id[struct{}](struct{}{})
	var b any = struct{}{}
	b = 2
	_ = a
	_ = b
}
