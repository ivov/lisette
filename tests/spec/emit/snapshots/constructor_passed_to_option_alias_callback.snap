---
source: tests/spec/emit/types.rs
description: |
  
  type MyOpt = Option<int>
  
  fn apply(f: fn(int) -> MyOpt) -> MyOpt {
    f(1)
  }
  
  fn main() {
    let _ = apply(Some)
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

type MyOpt = lisette.Option[int]

func apply(f func(int) MyOpt) (int, bool) {
	v := f(1)
	if v.Tag == lisette.OptionSome {
		return v.SomeVal, true
	}
	return 0, false
}

func main() {
	cb := lisette.MakeOptionSome[int]
	var adapted func(int) MyOpt
	if cb != nil {
		adapted = func(arg0 int) MyOpt {
			return cb(arg0)
		}
	}
	apply(adapted)
}
