---
source: tests/spec/emit/prelude.rs
description: |
  
  fn test(r: Ref<string>, range: Range<int>) -> string {
    r.substring(range)
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

func test(r *string, rng lisette.Range[int]) string {
	return lisette.Substring(*r, rng.Start, rng.End)
}
