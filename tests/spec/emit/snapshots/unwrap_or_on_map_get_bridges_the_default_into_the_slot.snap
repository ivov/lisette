---
source: tests/spec/emit/result_option_patterns.rs
description: |
  
  import "go:fmt"
  
  struct Thing { n: int }
  interface Opt { fn find() -> Option<Ref<Thing>> }
  
  struct Holder<T> { value: Option<T> }
  impl<T> Holder<T> {
    fn find(self) -> Option<T> { self.value }
  }
  
  fn seven() -> Option<int> { Some(7) }
  
  fn main() {
    let m = Map.new<string, Unknown>()
    let value = m.get("k").unwrap_or(seven)
    match assert_type<fn() -> Option<int>>(value) {
      Some(f) => fmt.Println(f().unwrap_or(0)),
      None => panic("wrong function type"),
    }
    let opts = Map.new<string, Opt>()
    let fallback: Holder<Ref<Thing>> = Holder { value: None }
    let chosen = opts.get("k").unwrap_or(fallback)
    fmt.Println(chosen.find().is_none())
  }
---
package main

import (
	"fmt"

	lisette "github.com/ivov/lisette/prelude"
)

type Thing struct {
	n int
}

type Opt interface {
	find() *Thing
}

type Holder[T any] struct {
	value lisette.Option[T]
}

func (h Holder[T]) find() (T, bool) {
	v := h.value
	if v.Tag == lisette.OptionSome {
		return v.SomeVal, true
	}
	var zero T
	return zero, false
}

func seven() (int, bool) {
	return 7, true
}

func main() {
	m := make(map[string]any)
	value, ok := m["k"]
	cb := func() lisette.Option[int] {
		return lisette.OptionFromCommaOk[int](seven())
	}
	if !ok {
		value = func() (int, bool) {
			res := cb()
			if res.Tag == lisette.OptionSome {
				return res.SomeVal, true
			}
			return 0, false
		}
	}
	src := lisette.AssertType[func() (int, bool)](value)
	var adapted lisette.Option[func() lisette.Option[int]]
	adapted.Tag = src.Tag
	if src.Tag == lisette.OptionSome {
		cb2 := src.SomeVal
		var adapted2 func() lisette.Option[int]
		if cb2 != nil {
			adapted2 = func() lisette.Option[int] {
				return lisette.OptionFromCommaOk[int](cb2())
			}
		}
		adapted.SomeVal = adapted2
	}
	if adapted.Tag == lisette.OptionNone {
		panic("wrong function type")
	}
	fmt.Println(adapted.SomeVal().UnwrapOr(0))
	opts := make(map[string]Opt)
	fallback := Holder[*Thing]{}
	chosen, ok2 := opts["k"]
	if !ok2 {
		chosen = _lisAdapter_Holder_Opt_0{inner: fallback}
	}
	ret := chosen.find()
	fmt.Println(ret == nil)
}

type _lisAdapter_Holder_Opt_0 struct {
	inner Holder[*Thing]
}

func (a _lisAdapter_Holder_Opt_0) find() *Thing {
	ret, ret2 := a.inner.find()
	var option lisette.Option[*Thing]
	if ret2 && ret != nil {
		option = lisette.MakeOptionSome[*Thing](ret)
	} else {
		option = lisette.MakeOptionNone[*Thing]()
	}
	if option.Tag == lisette.OptionSome {
		return option.SomeVal
	}
	return nil
}
