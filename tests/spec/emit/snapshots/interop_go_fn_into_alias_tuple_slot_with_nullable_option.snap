---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:encoding/pem"
  
  type Decoded = (Option<Ref<pem.Block>>, Slice<byte>)
  
  fn apply(f: fn(Slice<byte>) -> Decoded, data: Slice<byte>) -> bool {
    let (block, _) = f(data)
    block.is_some()
  }
  
  fn main() {
    let _ = apply(pem.Decode, [])
  }
---
package main

import (
	"encoding/pem"
	lisette "github.com/ivov/lisette/prelude"
)

type Decoded = lisette.Tuple2[lisette.Option[*pem.Block], []byte]

func apply(f func([]byte) Decoded, data []byte) bool {
	tmp := f(data)
	block := tmp.First
	return block.IsSome()
}

func main() {
	cb := pem.Decode
	var adapted func([]byte) Decoded
	if cb != nil {
		adapted = func(arg0 []byte) Decoded {
			ret, ret_1 := cb(arg0)
			option := lisette.OptionFromNilable[*pem.Block](ret, ret == nil)
			tup := lisette.MakeTuple2(option, ret_1)
			return tup
		}
	}
	apply(adapted, []byte{})
}
