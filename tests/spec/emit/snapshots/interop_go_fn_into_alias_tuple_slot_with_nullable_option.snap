---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:encoding/pem"
  
  type Decoded = (Option<Ref<pem.Block>>, Slice<byte>)
  
  fn apply(f: fn(Slice<byte>) -> Decoded, data: Slice<byte>) -> bool {
    let (block, _) = f(data)
    block.is_some()
  }
  
  fn main() {
    let _ = apply(pem.Decode, [])
  }
---
package main

import (
	"encoding/pem"

	lisette "github.com/ivov/lisette/prelude"
)

type Decoded = lisette.Tuple2[lisette.Option[*pem.Block], []byte]

func apply(f func([]byte) Decoded, data []byte) bool {
	tmp := f(data)
	block := tmp.First
	return block.IsSome()
}

func main() {
	apply(func(arg0 []byte) Decoded {
		ret, ret2 := pem.Decode(arg0)
		option := lisette.OptionFromNilable[*pem.Block](ret, ret == nil)
		tup := lisette.MakeTuple2(option, ret2)
		return tup
	}, []byte{})
}
