---
source: tests/spec/emit/functions.rs
description: |
  
  fn first<T>(fs: VarArgs<fn(fn(int) -> T) -> T>) -> fn(fn(int) -> T) -> T { fs[0] }
  fn invoke(f: fn(int) -> (int, int)) -> (int, int) { f(4) }
  fn main() {
   let f = first<(int, int)>([invoke]...)
   let (a,b) = f(|x| (x,x+1))
   if a != 4 || b != 5 { panic("tuple") }
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

func first[T any](fs ...func(func(int) T) T) func(func(int) T) T {
	return fs[0]
}

func invoke(f func(int) lisette.Tuple2[int, int]) (int, int) {
	tup := f(4)
	return tup.First, tup.Second
}

func main() {
	cb := invoke
	var adapted func(func(int) lisette.Tuple2[int, int]) lisette.Tuple2[int, int]
	if cb != nil {
		adapted = func(arg0 func(int) lisette.Tuple2[int, int]) lisette.Tuple2[int, int] {
			ret, ret_1 := cb(arg0)
			tup := lisette.MakeTuple2(ret, ret_1)
			return tup
		}
	}
	f := first[lisette.Tuple2[int, int]]([]func(func(int) lisette.Tuple2[int, int]) lisette.Tuple2[int, int]{adapted}...)
	tmp := f(func(x int) lisette.Tuple2[int, int] {
		return lisette.MakeTuple2[int, int](x, x+1)
	})
	a := tmp.First
	b := tmp.Second
	if a != 4 || b != 5 {
		panic("tuple")
	}
}
