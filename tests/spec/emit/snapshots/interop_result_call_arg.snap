---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:strconv"
  
  fn apply(f: fn(string) -> Result<int, error>, s: string) -> Result<int, error> {
    f(s)
  }
  
  fn main() {
    let r = apply(strconv.Atoi, "42")
    match r {
      Ok(v) => { let _ = v },
      Err(_) => { let _ = 0 },
    }
  }
---
package main

import (
	lisette "github.com/ivov/lisette/prelude"
	"strconv"
)

func apply(f func(string) (int, error), s string) (int, error) {
	return f(s)
}

func main() {
	ret, ret_1 := apply(strconv.Atoi, "42")
	var r lisette.Result[int, error]
	if ret_1 != nil {
		r = lisette.MakeResultErr[int, error](ret_1)
	} else {
		r = lisette.MakeResultOk[int, error](ret)
	}
	if r.Tag == lisette.ResultOk {
		_ = r.OkVal
	}
}
