---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:example.com/evts"
  import "go:fmt"
  
  fn main() {
    match evts.Peek() {
      Some(e) => fmt.Println(e),
      None => fmt.Println("none"),
    }
  }
---
package main

import (
	"example.com/evts"
	"fmt"
	lisette "github.com/ivov/lisette/prelude"
)

func main() {
	ret_1 := evts.Peek()
	if !lisette.IsNilInterface(ret_1) {
		e := ret_1
		fmt.Println(e)
	} else {
		fmt.Println("none")
	}
}
