---
source: tests/spec/emit/expressions.rs
description: |
  
  import "go:fmt"
  
  fn get() -> Slice<int> { [1] }
  fn arg() -> int { let _ = fmt.Println(1); 2 }
  
  fn main() {
    get().append(arg())
  }
---
package main

import (
	"fmt"
	"slices"
)

func get() []int {
	return []int{1}
}

func arg() int {
	fmt.Println(1)
	return 2
}

func main() {
	recv := get()
	_ = append(slices.Clip(recv), arg())
}
