---
source: tests/spec/emit/expressions.rs
description: |
  
  struct Wrap(Slice<int>)
  
  fn main() {
    let mut m = Map.new<string, Wrap>()
    m["a"] = Wrap([])
    m["a"] = Wrap(m["a"].0.append(1))
  }
---
package main

import "slices"

type Wrap []int

func main() {
	m := make(map[string]Wrap)
	m["a"] = Wrap([]int{})
	base := m
	recv := ([]int)(m["a"])
	base["a"] = Wrap(append(slices.Clip(recv), 1))
}
