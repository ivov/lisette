description: |
  
  fn pick(x12: int, x_1: int, x1: int) -> int {
    x12 + x_1 * 10 + x1 * 100
  }
  
  fn main() {
    if pick(1, 2, 3) != 321 { panic("a parameter read the wrong value") }
