---
package main

import "fmt"

func pick(n int) int {
	var total int
	if n > 0 {
		f := func(k int) int {
			total := k * 2
			fmt.Println(total)
			return total + 1
		}
		total = f(n)
	} else {
		total = 0
	}
	fmt.Println(total)
	return total
}
