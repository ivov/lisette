package main

import (
	"example.com/reg"
	lisette "github.com/ivov/lisette/prelude"
)

func main() {
	raw_2 := reg.Events()
	option_3 := lisette.OptionFromNilable[chan int](raw_2, raw_2 == nil)
	if option_3.Tag == lisette.OptionSome {
		_ = lisette.ChannelReceive(option_3.SomeVal)
	} else {
	}
}
