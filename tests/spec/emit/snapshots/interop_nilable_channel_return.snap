---
package main

import (
	"example.com/reg"
	lisette "github.com/ivov/lisette/prelude"
)

func main() {
	ret_1 := reg.Events()
	if ret_1 != nil {
		ch := ret_1
		_ = lisette.ChannelReceive(ch)
	}
}
