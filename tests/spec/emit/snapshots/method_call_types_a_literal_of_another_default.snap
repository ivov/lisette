---
source: tests/spec/emit/functions.rs
description: |
  
  struct Box { label: string }
  
  impl Box {
    fn scale<T>(self, v: T) -> T { v }
  }
  
  fn test() -> byte {
    let b = Box { label: "x" }
    let widened: float32 = b.scale(1)
    let letter: byte = b.scale('a')
    letter + widened as byte
  }
---
package main

type Box struct {
	label string
}

func boxScale[T any](_ Box, v T) T {
	return v
}

func test() byte {
	b := Box{label: "x"}
	widened := boxScale(b, float32(1))
	letter := boxScale(b, byte('a'))
	return letter + byte(widened)
}
