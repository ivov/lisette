---
source: tests/spec/emit/functions.rs
description: |
  
  fn main(){let mut n=0;let mut f:fn(int)=|x|{n+=x};let mut r=&f;r.* = |x|{n+=10*x};f(3);if n!=30{panic("local storage")}}
---
package main

func main() {
	n := 0
	f := func(x int) struct{} {
		n += x
		return struct{}{}
	}
	r := &f
	*r = func(x int) struct{} {
		n += 10 * x
		return struct{}{}
	}
	f(3)
	if n != 30 {
		panic("local storage")
	}
}
