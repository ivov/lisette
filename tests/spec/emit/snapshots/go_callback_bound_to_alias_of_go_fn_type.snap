---
package main

import (
	"io/fs"
	"path/filepath"

	lisette "github.com/ivov/lisette/prelude"
)

type Walker = filepath.WalkFunc

func main() {
	cb := func(_ string, _ lisette.Option[fs.FileInfo], _ lisette.Option[error]) error {
		return nil
	}
	var walker Walker = func(arg0 string, arg1 fs.FileInfo, arg2 error) error {
		option := lisette.OptionFromNilable[fs.FileInfo](arg1, lisette.IsNilInterface(arg1))
		option_1 := lisette.OptionFromNilable[error](arg2, lisette.IsNilInterface(arg2))
		return cb(arg0, option, option_1)
	}
	filepath.Walk("/tmp", filepath.WalkFunc(walker))
}
