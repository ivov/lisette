source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:example.com/ext"
  
  fn enqueue(ch: Channel<fn(int) -> Result<string, error>>) {
    let _ = ch.send(ext.MakeParser())
  }
---
package main

import (
	"example.com/ext"
	lisette "github.com/ivov/lisette/prelude"
)

func enqueue(ch chan func(int) lisette.Result[string, error]) {
	cb := ext.MakeParser()
	var adapted func(int) lisette.Result[string, error]
	if cb != nil {
		adapted = func(arg0 int) lisette.Result[string, error] {
			return lisette.ResultFromPair[string](cb(arg0))
		}
	}
	lisette.ChannelSend(ch, adapted)
}
