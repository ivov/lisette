---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:example.com/aws"
  
  fn apply(f: fn() -> (Option<Slice<Option<string>>>, int)) -> (Option<Slice<Option<string>>>, int) {
    f()
  }
  
  fn main() {
    let (xs, n) = apply(aws.Make)
    let _ = n
    match xs {
      Some(inner) => { for x in inner { let _ = x } },
      None => {},
    }
  }
---
package main

import (
	"example.com/aws"
	lisette "github.com/ivov/lisette/prelude"
)

func apply(f func() lisette.Tuple2[lisette.Option[[]lisette.Option[string]], int]) (lisette.Option[[]lisette.Option[string]], int) {
	tup := f()
	return tup.First, tup.Second
}

func main() {
	cb := aws.Make
	var adapted func() lisette.Tuple2[lisette.Option[[]lisette.Option[string]], int]
	if cb != nil {
		adapted = func() lisette.Tuple2[lisette.Option[[]lisette.Option[string]], int] {
			ret, ret_1 := cb()
			var option lisette.Option[[]lisette.Option[string]]
			if ret != nil {
				src := *ret
				wrapped := make([]lisette.Option[string], len(src))
				for i, v := range src {
					if v != nil {
						wrapped[i] = lisette.MakeOptionSome[string](*v)
					} else {
						wrapped[i] = lisette.MakeOptionNone[string]()
					}
				}
				option = lisette.MakeOptionSome[[]lisette.Option[string]](wrapped)
			} else {
				option = lisette.MakeOptionNone[[]lisette.Option[string]]()
			}
			tup := lisette.MakeTuple2(option, ret_1)
			return tup
		}
	}
	xs, n := apply(adapted)
	_ = n
	if xs.Tag == lisette.OptionSome {
		for _, x := range xs.SomeVal {
			_ = x
		}
	}
}
