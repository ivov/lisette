---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:example.com/aws"
  import "go:errors"
  
  fn main() {
    aws.Use(|n| {
      if n < 0 {
        return Err(errors.New("negative"))
      }
      let v = n
      Ok((Some(&v), n))
    })
  }
---
package main

import (
	"errors"

	"example.com/aws"
)

func main() {
	aws.Use(func(n int) (*int, int, error) {
		if n < 0 {
			return nil, 0, errors.New("negative")
		}
		v := n
		return &v, n, nil
	})
}
