    xs.fold(0, |acc, x| acc + x)
  }

  fn insert_at(out: Slice<int>, pos: int, x: int) -> Slice<int> {
    let mut next: Slice<int> = []
    next = next.append(out[..pos]...)
    next = next.append(x)
    next.append(out[pos..]...)
