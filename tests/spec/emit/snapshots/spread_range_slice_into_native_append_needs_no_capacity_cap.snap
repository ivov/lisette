---
package main

import "slices"

func total(xs ...int) int {
	acc := 0
	for _, x := range xs {
		acc += x
	}
	return acc
}

func insertAt(out []int, pos, x int) []int {
	next := []int{}
	next = append(next, out[:pos]...)
	next = append(next, x)
	added := out[pos:]
	return func() []int {
		if len(added) == 0 {
			return slices.Clone(next)
		}
		return append(next[:len(next):len(next)], added...)
	}()
}

func middle(xs, ys []int) []int {
	added := ys[1 : 2+1]
	return func() []int {
		if len(added) == 0 {
			return slices.Clone(xs)
		}
		return append(xs[:len(xs):len(xs)], added...)
	}()
}

func sumTail(ys []int) int {
	len_1 := len(ys)
	return total(ys[1:len_1:len_1]...)
}
