---
source: tests/spec/emit/functions.rs
description: |
  
  struct H<T>{f:fn(int)->T}
  fn replace<T>(f:mut Ref<fn(int)->T>,g:fn(int)->T){f.* = g}
  fn main(){let mut n=0;let mut h:H<()> = H{f:|x|{n+=x}};let mut r=&h.f;replace<()>(r,|x|{n+=10*x});h.f(3);if n!=30{panic("generic field storage")}}
---
package main

type H[T any] struct {
	f func(int) T
}

func replace[T any](f *func(int) T, g func(int) T) {
	*f = g
}

func main() {
	n := 0
	h := H[struct{}]{f: func(x int) struct{} {
		n += x
		return struct{}{}
	}}
	r := &h.f
	replace[struct{}](r, func(x int) struct{} {
		n += 10 * x
		return struct{}{}
	})
	h.f(3)
	if n != 30 {
		panic("generic field storage")
	}
}
