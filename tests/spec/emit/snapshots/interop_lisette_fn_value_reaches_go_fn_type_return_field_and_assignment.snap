---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:bufio"
  
  struct Splitter {
    split: bufio.SplitFunc,
  }
  
  fn split_words(data: mut Slice<byte>, at_eof: bool) -> Result<(int, Slice<byte>), error> {
    bufio.ScanWords(data, at_eof)
  }
  
  fn pick() -> bufio.SplitFunc {
    split_words
  }
  
  fn main() {
    let mut assigned: bufio.SplitFunc = bufio.ScanWords
    assigned = split_words
    let holder = Splitter { split: split_words }
    let _ = pick()
    let _ = assigned
    let _ = holder
  }
---
package main

import (
	"bufio"

	lisette "github.com/ivov/lisette/prelude"
)

type Splitter struct {
	split bufio.SplitFunc
}

func splitWords(data []byte, at_eof bool) (lisette.Tuple2[int, []byte], error) {
	ret, ret2, ret3 := bufio.ScanWords(data, at_eof)
	tup := lisette.MakeTuple2(ret, ret2)
	var result lisette.Result[lisette.Tuple2[int, []byte], error]
	if ret3 != nil {
		result = lisette.MakeResultErr[lisette.Tuple2[int, []byte], error](ret3)
	} else {
		result = lisette.MakeResultOk[lisette.Tuple2[int, []byte], error](tup)
	}
	if result.Tag == lisette.ResultOk {
		return result.OkVal, nil
	}
	return lisette.Tuple2[int, []byte]{}, result.ErrVal
}

func pick() bufio.SplitFunc {
	cb := func(arg0 []byte, arg1 bool) lisette.Result[lisette.Tuple2[int, []byte], error] {
		return lisette.ResultFromPair[lisette.Tuple2[int, []byte]](splitWords(arg0, arg1))
	}
	return func(arg0 []byte, arg1 bool) (int, []byte, error) {
		res := cb(arg0, arg1)
		if res.Tag == lisette.ResultOk {
			tup := res.OkVal
			return tup.First, tup.Second, nil
		}
		return 0, nil, res.ErrVal
	}
}

func main() {
	var assigned bufio.SplitFunc = bufio.ScanWords
	cb := func(arg0 []byte, arg1 bool) lisette.Result[lisette.Tuple2[int, []byte], error] {
		return lisette.ResultFromPair[lisette.Tuple2[int, []byte]](splitWords(arg0, arg1))
	}
	assigned = func(arg0 []byte, arg1 bool) (int, []byte, error) {
		res := cb(arg0, arg1)
		if res.Tag == lisette.ResultOk {
			tup := res.OkVal
			return tup.First, tup.Second, nil
		}
		return 0, nil, res.ErrVal
	}
	cb2 := func(arg0 []byte, arg1 bool) lisette.Result[lisette.Tuple2[int, []byte], error] {
		return lisette.ResultFromPair[lisette.Tuple2[int, []byte]](splitWords(arg0, arg1))
	}
	holder := Splitter{split: func(arg0 []byte, arg1 bool) (int, []byte, error) {
		res2 := cb2(arg0, arg1)
		if res2.Tag == lisette.ResultOk {
			tup2 := res2.OkVal
			return tup2.First, tup2.Second, nil
		}
		return 0, nil, res2.ErrVal
	}}
	pick()
	_ = assigned
	_ = holder
}
