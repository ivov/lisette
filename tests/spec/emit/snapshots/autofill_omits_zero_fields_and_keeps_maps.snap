---
package main

import lisette "github.com/ivov/lisette/prelude"

type Counter struct {
	label  string
	i      int
	rows   int
	ratio  float64
	done   bool
	parent lisette.Option[int]
	tags   []string
	hits   map[string]int
}

func make_() Counter {
	return Counter{
		label: "x",
		hits:  map[string]int{},
	}
}
