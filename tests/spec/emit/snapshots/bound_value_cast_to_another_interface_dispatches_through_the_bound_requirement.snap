---
source: tests/spec/emit/go_interface_adapter.rs
description: |
  
  import "go:fmt"
  
  pub interface Named {
    fn name() -> Partial<int, error>
  }
  
  pub interface Labeled {
    fn name() -> Partial<int, error>
  }
  
  type Tag = Named
  
  struct Dog {}
  
  impl Dog {
    pub fn name(self) -> Partial<int, error> {
      Partial.Both(4, fmt.Errorf("eof"))
    }
  }
  
  fn show(n: Labeled) -> Partial<int, error> {
    n.name()
  }
  
  fn label<T: Tag>(t: T) -> Partial<int, error> {
    show(t as Labeled)
  }
  
  fn main() {
    fmt.Println(label(Dog {}))
  }
---
package main

import (
	"fmt"

	lisette "github.com/ivov/lisette/prelude"
)

type Named interface {
	Name() (int, error)
}

type Labeled interface {
	Name() (int, error)
}

type Tag = Named

type Dog struct{}

func (d Dog) Name() (int, error) {
	return 4, fmt.Errorf("eof")
}

func show(n Labeled) lisette.Partial[int, error] {
	ret, ret2 := n.Name()
	var result lisette.Partial[int, error]
	if ret2 != nil {
		result = lisette.MakePartialBoth[int, error](ret, ret2)
	} else {
		result = lisette.MakePartialOk[int, error](ret)
	}
	return result
}

func label[T any](t T) lisette.Partial[int, error] {
	return show(_lisAdapter_T_Labeled_0[T]{inner: t})
}

func main() {
	fmt.Println(label(Dog{}))
}

type _lisAdapter_T_Labeled_0[T any] struct {
	inner T
}

func (a _lisAdapter_T_Labeled_0[T]) Name() (int, error) {
	ret, ret2 := any(a.inner).(interface{ Name() (int, error) }).Name()
	return ret, ret2
}
