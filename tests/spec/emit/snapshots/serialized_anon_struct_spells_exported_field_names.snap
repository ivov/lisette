---
source: tests/spec/emit/types.rs
description: |
  
  import "go:fmt"
  
  #[json]
  #[go(anon_struct)]
  struct Point { x: int, y: int }
  
  fn main() {
    let p = Point { x: 1, y: 2 }
    fmt.Println(p.x + p.y)
  }
---
package main

import "fmt"

type Point struct {
	X int `json:"x"`
	Y int `json:"y"`
}

func main() {
	p := struct {
		X int
		Y int
	}{
		X: 1,
		Y: 2,
	}
	fmt.Println(p.X + p.Y)
}
