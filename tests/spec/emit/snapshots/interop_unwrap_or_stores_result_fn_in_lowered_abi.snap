description: |
  
  import "go:example.com/ext"
  
  fn pick(opt: Option<fn(int) -> Result<string, error>>) {
    let _ = opt.unwrap_or(ext.MakeParser())
  }
---
package main

import (
	"example.com/ext"
	lisette "github.com/ivov/lisette/prelude"
)

func pick(opt lisette.Option[func(int) lisette.Result[string, error]]) {
	cb := ext.MakeParser()
	var adapted func(int) lisette.Result[string, error]
	if cb != nil {
		adapted = func(arg0 int) lisette.Result[string, error] {
			return lisette.ResultFromPair[string](cb(arg0))
		}
	}
	opt.UnwrapOr(adapted)
}
