---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:strconv"
  
  fn fallback(s: string) -> Result<int, error> { Ok(0) }
  
  fn main() {
    let mut f = fallback
    f = strconv.Atoi
    let r = f("42")
    match r {
      Ok(v) => { let _ = v },
      Err(_) => { let _ = 0 },
    }
  }
---
package main

import (
	lisette "github.com/ivov/lisette/prelude"
	"strconv"
)

func fallback(_ string) (int, error) {
	return 0, nil
}

func main() {
	cb := fallback
	var adapted func(string) lisette.Result[int, error]
	if cb != nil {
		adapted = func(arg0 string) lisette.Result[int, error] {
			return lisette.ResultFromPair[int](cb(arg0))
		}
	}
	f := adapted
	f = func(arg0 string) lisette.Result[int, error] {
		return lisette.ResultFromPair[int](strconv.Atoi(arg0))
	}
	r := f("42")
	if r.Tag == lisette.ResultOk {
		_ = r.OkVal
	}
}
