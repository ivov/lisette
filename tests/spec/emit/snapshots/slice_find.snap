---
source: tests/spec/emit/prelude.rs
description: |
  
  fn test(s: Slice<int>) -> Option<int> {
    s.find(|x| x > 0)
  }
---
package main

func test(s []int) (int, bool) {
	var ret_1 int
	found_2 := false
	for _, x := range s {
		if x > 0 {
			ret_1 = x
			found_2 = true
			break
		}
	}
	if !found_2 {
		return 0, false
	}
	return ret_1, true
}
