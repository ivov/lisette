---
source: tests/spec/emit/result_option_patterns.rs
description: |
  
  import "go:os"
  import "go:fmt"
  
  fn test() {
    match os.Create("f") {
      Ok(_) => fmt.Println("made"),
      Err(e) => fmt.Println(e),
    }
  }
---
package main

import (
	"errors"
	"fmt"
	"os"
)

func test() {
	if ret_1, e := os.Create("f"); e == nil && ret_1 != nil {
		fmt.Println("made")
	} else {
		if e == nil {
			e = errors.New("unexpected nil")
		}
		fmt.Println(e)
	}
}
