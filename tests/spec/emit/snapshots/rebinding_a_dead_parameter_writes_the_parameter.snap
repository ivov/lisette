---
source: tests/spec/emit/expressions.rs
description: |
  
  struct P { a: int }
  
  impl P {
    fn ptr(self: Ref<P>) -> Ref<P> { self }
  }
  
  fn top(names: Slice<string>) -> Slice<string> {
    let mut names = names
    names = names.append("t")
    names
  }
  
  fn local(n: int) -> int {
    let total = n * 2
    let mut total = total
    total += 1
    total
  }
  
  fn closure_before(names: Slice<string>) -> int {
    let count = || names.length()
    let mut names = names
    names = names.append("x")
    count() + names.length()
  }
  
  fn address_before(p: P) -> int {
    let r = p.ptr()
    let mut p = p
    p.a = 99
    r.a + p.a
  }
  
  fn nested(n: int) -> int {
    if n > 0 {
      let mut n = n
      n += 100
      let _ = n
    }
    n
  }
---
package main

type P struct {
	a int
}

func (p *P) ptr() *P {
	return p
}

func top(names []string) []string {
	names = append(names, "t")
	return names
}

func local(n int) int {
	total := n * 2
	total++
	return total
}

func closureBefore(names []string) int {
	count := func() int {
		return len(names)
	}
	names_1 := names
	names_1 = append(names_1, "x")
	return count() + len(names_1)
}

func addressBefore(p P) int {
	r := p.ptr()
	p_1 := p
	p_1.a = 99
	return r.a + p_1.a
}

func nested(n int) int {
	if n > 0 {
		n_1 := n
		n_1 += 100
		_ = n_1
	}
	return n
}
