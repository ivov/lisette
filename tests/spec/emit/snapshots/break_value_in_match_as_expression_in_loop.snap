---
source: tests/spec/emit/control_flow.rs
description: |
  
  fn test() -> int {
    let mut n = 0;
    loop {
      n = match n {
        5 => break n,
        _ => n + 1,
      }
    }
  }
---
package main

func test() int {
	n := 0
	var tmp int
	for {
		var tmp2 int
		if n == 5 {
			tmp = n
			break
		}
		tmp2 = n + 1
		n = tmp2
	}
	return tmp
}
