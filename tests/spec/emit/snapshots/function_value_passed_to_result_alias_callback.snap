---
source: tests/spec/emit/types.rs
description: |
  
  type MyRes = Result<int, error>
  
  fn make(x: int) -> Result<int, error> {
    Ok(x)
  }
  
  fn apply(f: fn(int) -> MyRes) -> MyRes {
    f(1)
  }
  
  fn main() {
    let _ = apply(make)
    let _ = apply(Ok)
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

type MyRes = lisette.Result[int, error]

func make_(x int) (int, error) {
	return x, nil
}

func apply(f func(int) MyRes) (int, error) {
	v := f(1)
	if v.Tag == lisette.ResultOk {
		return v.OkVal, nil
	}
	return 0, v.ErrVal
}

func main() {
	cb := func(arg0 int) lisette.Result[int, error] {
		return lisette.ResultFromPair[int](make_(arg0))
	}
	apply(func(arg0 int) MyRes {
		return cb(arg0)
	})
	cb_1 := lisette.MakeResultOk[int, error]
	var adapted func(int) MyRes
	if cb_1 != nil {
		adapted = func(arg0 int) MyRes {
			return cb_1(arg0)
		}
	}
	apply(adapted)
}
