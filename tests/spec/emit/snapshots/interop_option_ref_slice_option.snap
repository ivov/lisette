---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:example.com/aws"
  
  fn main() {
    match aws.Make() {
      Some(xs) => aws.Use(Some(xs)),
      None => aws.Use(None),
    }
  }
---
package main

import (
	"example.com/aws"
	lisette "github.com/ivov/lisette/prelude"
)

func main() {
	raw := aws.Make()
	var option lisette.Option[*[]lisette.Option[string]]
	if raw != nil {
		src := *raw
		wrapped := make([]lisette.Option[string], len(src))
		for i, v := range src {
			if v != nil {
				wrapped[i] = lisette.MakeOptionSome[string](*v)
			} else {
				wrapped[i] = lisette.MakeOptionNone[string]()
			}
		}
		ref := &wrapped
		option = lisette.MakeOptionSome[*[]lisette.Option[string]](ref)
	} else {
		option = lisette.MakeOptionNone[*[]lisette.Option[string]]()
	}
	if option.Tag == lisette.OptionSome {
		src2 := option.SomeVal
		src3 := *src2
		unwrapped := make([]*string, len(src3))
		for i2, v2 := range src3 {
			if v2.Tag == lisette.OptionSome {
				unwrapped[i2] = &v2.SomeVal
			} else {
				unwrapped[i2] = nil
			}
		}
		ref2 := &unwrapped
		aws.Use(ref2)
	} else {
		aws.Use(nil)
	}
}
