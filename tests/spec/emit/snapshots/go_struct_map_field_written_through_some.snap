---
source: tests/spec/emit/imports.rs
description: |
  
  import "go:encoding/pem"
  
  fn test() -> string {
    let mut headers = Map.new<string, string>()
    headers["key"] = "value"
    let b = pem.Block { Type: "X", Headers: Some(headers), .. }
    match b.Headers {
      Some(h) => h["key"],
      None => "",
    }
  }
---
package main

import (
	"encoding/pem"
	lisette "github.com/ivov/lisette/prelude"
)

func test() string {
	headers := make(map[string]string)
	headers["key"] = "value"
	b := pem.Block{
		Type:    "X",
		Headers: headers,
	}
	raw_1 := b.Headers
	option_2 := lisette.OptionFromNilable[map[string]string](raw_1, raw_1 == nil)
	if option_2.Tag == lisette.OptionSome {
		return option_2.SomeVal["key"]
	}
	return ""
}
