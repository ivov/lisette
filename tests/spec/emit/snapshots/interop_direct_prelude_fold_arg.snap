---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:math"
  
  fn main() {
    let xs: Slice<float64> = [1.0, 5.0]
    let biggest = xs.fold(0.0, math.Max)
    let _ = biggest
  }
---
package main

import "math"

func main() {
	xs := []float64{1.0, 5.0}
	biggest := 0.0
	for _, v := range xs {
		biggest = math.Max(biggest, v)
	}
	_ = biggest
}
