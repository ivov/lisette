---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:fmt"
  import "go:go/ast"
  import "go:go/token"
  
  fn main() {
    let lit = ast.CompositeLit {
      Type: None,
      Lbrace: 0 as token.Pos,
      Elts: [],
      Rbrace: 0 as token.Pos,
      Incomplete: false,
    }
    let elts = lit.Elts
    for elt in elts {
      match elt {
        Some(e) => fmt.Println(e.Pos()),
        None => fmt.Println("nil"),
      }
    }
  }
---
package main

import (
	"fmt"
	lisette "github.com/ivov/lisette/prelude"
	"go/ast"
	"go/token"
)

func main() {
	src_1 := []lisette.Option[ast.Expr]{}
	unwrapped_2 := make([]ast.Expr, len(src_1))
	for i_3, v_4 := range src_1 {
		if v_4.Tag == lisette.OptionSome {
			unwrapped_2[i_3] = v_4.SomeVal
		}
	}
	lit := ast.CompositeLit{
		Type:       nil,
		Lbrace:     token.Pos(0),
		Elts:       unwrapped_2,
		Rbrace:     token.Pos(0),
		Incomplete: false,
	}
	raw_5 := lit.Elts
	wrapped_6 := make([]lisette.Option[ast.Expr], len(raw_5))
	for i_7, v_8 := range raw_5 {
		if !lisette.IsNilInterface(v_8) {
			wrapped_6[i_7] = lisette.MakeOptionSome[ast.Expr](v_8)
		} else {
			wrapped_6[i_7] = lisette.MakeOptionNone[ast.Expr]()
		}
	}
	elts := wrapped_6
	for _, elt := range elts {
		if elt.Tag == lisette.OptionSome {
			fmt.Println(elt.SomeVal.Pos())
		} else {
			fmt.Println("nil")
		}
	}
}
