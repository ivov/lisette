---
source: tests/spec/emit/concurrency.rs
description: |
  
  fn process(v: int) {}
  
  fn test(rx: Receiver<int>) {
    for v in rx {
      process(v);
    }
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

func process(_ int) {}

func test(rx <-chan int) {
	for v := range lisette.ChannelRange(rx) {
		process(v)
	}
}
