---
source: tests/spec/emit/control_flow.rs
description: |
  
  fn test(x: int) -> string {
    match x {
      1 | 2 | 3 => "small",
      4 | 5 | 6 => "medium",
      _ => "large",
    }
  }
---
package main

func test(x int) string {
	switch x {
	case 1, 2, 3:
		return "small"
	case 4, 5, 6:
		return "medium"
	default:
		return "large"
	}
}
