---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:flag"
  
  fn apply(f: fn(string) -> Option<Ref<flag.Flag>>, name: string) -> bool {
    match f(name) {
      Some(_) => true,
      None => false,
    }
  }
  
  fn main() {
    let r = apply(flag.Lookup, "verbose")
    let _ = r
  }
---
package main

import (
	"flag"
	lisette "github.com/ivov/lisette/prelude"
)

func apply(f func(string) lisette.Option[*flag.Flag], name string) bool {
	if f(name).Tag == lisette.OptionSome {
		return true
	}
	return false
}

func main() {
	cb := flag.Lookup
	var adapted func(string) lisette.Option[*flag.Flag]
	if cb != nil {
		adapted = func(arg0 string) lisette.Option[*flag.Flag] {
			raw := cb(arg0)
			option := lisette.OptionFromNilable[*flag.Flag](raw, raw == nil)
			return option
		}
	}
	r := apply(adapted, "verbose")
	_ = r
}
