---
source: tests/spec/emit/functions.rs
description: |
  
  struct Counter { n: int }
  
  impl Counter {
    fn plus(self, k: int) -> int {
      self.n + k
    }
  }
  
  fn main() {
    let mut c = Counter { n: 1 }
    let bump = || -> int { c.n += 10; 1 }
    let v = c.plus(bump())
    let _ = v
  }
---
package main

type Counter struct {
	n int
}

func (c Counter) plus(k int) int {
	return c.n + k
}

func main() {
	c := Counter{n: 1}
	bump := func() int {
		c.n += 10
		return 1
	}
	callee := c.plus
	v := callee(bump())
	_ = v
}
