---
source: tests/spec/emit/types.rs
description: |
  
  fn main() {
    let f = Some
    let x = f(42)
    let _ = x
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

func main() {
	cb := lisette.MakeOptionSome[int]
	f := func(arg0 int) (int, bool) {
		opt := cb(arg0)
		if opt.Tag == lisette.OptionSome {
			return opt.SomeVal, true
		}
		return 0, false
	}
	x := lisette.OptionFromCommaOk[int](f(42))
	_ = x
}
