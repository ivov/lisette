package main

import "example.com/lib"

func test() int {
	s := lib.Stat_t{}
	s.Pad_cgo_0 = 1
	t := lib.Stat_t{Pad_cgo_0: s.Pad_cgo_0}
	return t.Pad_cgo_0
}
