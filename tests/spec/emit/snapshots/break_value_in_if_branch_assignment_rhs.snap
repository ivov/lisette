---
source: tests/spec/emit/control_flow.rs
description: |
  
  fn test() {
    let _ = loop {
      let mut x = 0
      x = if true { break 1 } else { 1 }
      let _ = x
      2
    }
  }
---
package main

func test() {
	var tmp int
	for {
		x := 0
		var tmp2 int
		if true {
			tmp = 1
			break
		}
		tmp2 = 1
		x = tmp2
		_ = x
	}
	_ = tmp
}
