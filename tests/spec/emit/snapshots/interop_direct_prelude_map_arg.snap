---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:strings"
  
  fn main() {
    let xs: Slice<string> = ["a"]
    let ys = xs.map(strings.ToUpper)
    let _ = ys
  }
---
package main

import "strings"

func main() {
	xs := []string{"a"}
	ys := make([]string, len(xs))
	for i, v := range xs {
		ys[i] = strings.ToUpper(v)
	}
	_ = ys
}
