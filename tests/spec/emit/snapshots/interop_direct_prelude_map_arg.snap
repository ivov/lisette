---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:strings"
  
  fn main() {
    let xs: Slice<string> = ["a"]
    let ys = xs.map(strings.ToUpper)
    let _ = ys
  }
---
package main

import (
	"strings"

	lisette "github.com/ivov/lisette/prelude"
)

func main() {
	xs := []string{"a"}
	ys := lisette.SliceMap(xs, strings.ToUpper)
	_ = ys
}
