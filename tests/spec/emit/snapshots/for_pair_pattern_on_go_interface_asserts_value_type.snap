---
package main

import "example.com/shapes"

func sumAreas(items map[string]shapes.Shape) int {
	total := 0
	for key, value := range items {
		_ = key
		asserted := value.(shapes.Rect)
		w := asserted.W
		h := asserted.H
		total += w * h
	}
	return total
}
