---
source: tests/spec/emit/prelude.rs
description: |
  
  fn test(s: Slice<int>, f: fn(int) -> string) -> Slice<string> {
    s.map(f)
  }
---
package main

func test(s []int, f func(int) string) []string {
	result := make([]string, len(s))
	for i, v := range s {
		result[i] = f(v)
	}
	return result
}
