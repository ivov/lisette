---
package main

import (
	"archive/zip"
	"io/fs"
)

func main() {
	var header zip.FileHeader
	cb := (*zip.FileHeader).SetMode
	var adapted func(*zip.FileHeader, fs.FileMode) struct{}
	if cb != nil {
		adapted = func(arg0 *zip.FileHeader, arg1 fs.FileMode) struct{} {
			cb(arg0, arg1)
			return struct{}{}
		}
	}
	set_mode := adapted
	set_mode(&header, fs.FileMode(0o644))
}
