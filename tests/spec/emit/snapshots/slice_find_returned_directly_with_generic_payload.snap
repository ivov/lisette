---
source: tests/spec/emit/prelude.rs
description: |
  
  fn first<T>(xs: Slice<T>, keep: fn(T) -> bool) -> Option<T> {
    xs.find(keep)
  }
  
  fn test() {
    match first([1, 2, 3], |x| x > 1) {
      Some(v) => { if v != 2 { panic("wrong element") } },
      None => { panic("expected a hit") },
    }
  }
---
package main

func first[T any](xs []T, keep func(T) bool) (T, bool) {
	for _, v := range xs {
		if keep(v) {
			return v, true
		}
	}
	return *new(T), false
}

func test() {
	v, ok := first([]int{1, 2, 3}, func(x int) bool {
		return x > 1
	})
	if !ok {
		panic("expected a hit")
	}
	if v != 2 {
		panic("wrong element")
	}
}
