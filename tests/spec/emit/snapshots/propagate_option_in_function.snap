---
source: tests/spec/emit/result_option_patterns.rs
description: |
  
  fn maybe_get() -> Option<int> {
    None
  }
  
  fn process() -> Option<int> {
    let x = maybe_get()?;
    Some(x + 1)
  }
---
package main

func maybeGet() (int, bool) {
	return 0, false
}

func process() (int, bool) {
	ret_1, ret_2 := maybeGet()
	if !ret_2 {
		return 0, false
	}
	x := ret_1
	return x + 1, true
}
