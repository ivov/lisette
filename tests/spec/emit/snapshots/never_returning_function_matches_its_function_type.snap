---
source: tests/spec/emit/functions.rs
description: |
  
  fn die() -> Never { panic("x") }
  
  fn call(f: fn() -> Never) { f() }
  
  fn named() { call(die) }
  
  fn lambda() { call(|| { die() }) }
  
  fn typed_lambda() {
    let g: fn() -> Never = || { panic("z") }
    call(g)
  }
---
package main

func die() {
	panic("x")
}

func call(f func() struct{}) {
	f()
}

func named() {
	cb := die
	var adapted func() struct{}
	if cb != nil {
		adapted = func() struct{} {
			cb()
			panic("unreachable")
		}
	}
	call(adapted)
}

func lambda() {
	call(func() struct{} {
		die()
		panic("unreachable")
	})
}

func typedLambda() {
	g := func() struct{} {
		panic("z")
	}
	call(g)
}
