---
source: tests/spec/emit/functions.rs
description: |
  
  import "go:errors"
  type F<T> = fn(int) -> T
  type Nested<T> = (Option<F<T>>, Result<F<T>, string>)
  type Alias<T> = Nested<T>
  struct Box<T> { value: Alias<T> }
  fn check(ok: bool) { if !ok { panic("runtime assertion failed") } }
  fn source(n: int) -> Result<int, error> { if n > 0 { Ok(n + 1) } else { Err(errors.New("fail")) } }
  fn make(n: int) -> Alias<Result<int, error>> { if n == 0 { return (None, Err("none")) }; (Some(source), Ok(|x| source(x))) }
  fn forward(x: Alias<Result<int, error>>) -> Nested<Result<int, error>> { x }
  fn boxed(b: Box<Result<int, error>>) -> Alias<Result<int, error>> { b.value }
  fn main() {
    let empty = make(0)
    let (none, err) = empty
    let None = none else { panic("expected none") }
    let Err(text) = err else { panic("expected err") }
    check(text == "none")
    let pair = make(1)
    let stored = Box { value: pair }
    let (o, r) = forward(boxed(stored))
    let Some(f) = o else { panic("missing f") }
    let Ok(g) = r else { panic("missing g") }
    check(f(5).unwrap_or(0) == 6)
    check(g(8).unwrap_or(0) == 9)
    check(f(0).is_err())
    check(g(0).is_err())
  }
---
package main

import (
	"errors"
	lisette "github.com/ivov/lisette/prelude"
)

type F[T any] = func(int) T

type Nested[T any] = lisette.Tuple2[lisette.Option[F[T]], lisette.Result[F[T], string]]

type Alias[T any] = Nested[T]

type Box[T any] struct {
	value Alias[T]
}

func check(ok bool) {
	if !ok {
		panic("runtime assertion failed")
	}
}

func source(n int) (int, error) {
	if n > 0 {
		return n + 1, nil
	}
	return 0, errors.New("fail")
}

func make_(n int) (F[lisette.Result[int, error]], lisette.Result[F[lisette.Result[int, error]], string]) {
	if n == 0 {
		return nil, lisette.MakeResultErr[F[lisette.Result[int, error]], string]("none")
	}
	src := lisette.MakeTuple2[lisette.Option[func(int) lisette.Result[int, error]], lisette.Result[func(int) lisette.Result[int, error], string]](lisette.MakeOptionSome(func(arg0 int) lisette.Result[int, error] {
		return lisette.ResultFromPair[int](source(arg0))
	}), lisette.MakeResultOk[func(int) lisette.Result[int, error], string](func(x int) lisette.Result[int, error] {
		return lisette.ResultFromPair[int](source(x))
	}))
	var adapted lisette.Tuple2[lisette.Option[F[lisette.Result[int, error]]], lisette.Result[F[lisette.Result[int, error]], string]]
	src2 := src.First
	var adapted2 lisette.Option[F[lisette.Result[int, error]]]
	adapted2.Tag = src2.Tag
	if src2.Tag == lisette.OptionSome {
		adapted2.SomeVal = src2.SomeVal
	}
	adapted.First = adapted2
	src3 := src.Second
	var adapted3 lisette.Result[F[lisette.Result[int, error]], string]
	adapted3.Tag = src3.Tag
	if src3.Tag == lisette.ResultOk {
		adapted3.OkVal = src3.OkVal
	}
	if src3.Tag == lisette.ResultErr {
		adapted3.ErrVal = src3.ErrVal
	}
	adapted.Second = adapted3
	opt := adapted.First
	var unwrap F[lisette.Result[int, error]]
	if opt.Tag == lisette.OptionSome {
		unwrap = opt.SomeVal
	}
	return unwrap, adapted.Second
}

func forward(x Alias[lisette.Result[int, error]]) (F[lisette.Result[int, error]], lisette.Result[F[lisette.Result[int, error]], string]) {
	tup := x
	opt := tup.First
	var unwrap F[lisette.Result[int, error]]
	if opt.Tag == lisette.OptionSome {
		unwrap = opt.SomeVal
	}
	return unwrap, tup.Second
}

func boxed(b Box[lisette.Result[int, error]]) (F[lisette.Result[int, error]], lisette.Result[F[lisette.Result[int, error]], string]) {
	tup := b.value
	opt := tup.First
	var unwrap F[lisette.Result[int, error]]
	if opt.Tag == lisette.OptionSome {
		unwrap = opt.SomeVal
	}
	return unwrap, tup.Second
}

func main() {
	ret, ret2 := make_(0)
	option := lisette.OptionFromNilable[F[lisette.Result[int, error]]](ret, ret == nil)
	empty := lisette.MakeTuple2(option, ret2)
	none := empty.First
	err := empty.Second
	if none.Tag != lisette.OptionNone {
		panic("expected none")
	}
	if err.Tag != lisette.ResultErr {
		panic("expected err")
	}
	text := err.ErrVal
	check(text == "none")
	ret3, ret4 := make_(1)
	option2 := lisette.OptionFromNilable[F[lisette.Result[int, error]]](ret3, ret3 == nil)
	pair := lisette.MakeTuple2(option2, ret4)
	stored := Box[lisette.Result[int, error]]{value: pair}
	ret5, ret6 := boxed(stored)
	option3 := lisette.OptionFromNilable[F[lisette.Result[int, error]]](ret5, ret5 == nil)
	tup := lisette.MakeTuple2(option3, ret6)
	ret7, ret8 := forward(tup)
	option4 := lisette.OptionFromNilable[F[lisette.Result[int, error]]](ret7, ret7 == nil)
	tup4 := lisette.MakeTuple2(option4, ret8)
	o := tup4.First
	r := tup4.Second
	if o.Tag != lisette.OptionSome {
		panic("missing f")
	}
	f := o.SomeVal
	if r.Tag != lisette.ResultOk {
		panic("missing g")
	}
	g := r.OkVal
	check(f(5).UnwrapOr(0) == 6)
	check(g(8).UnwrapOr(0) == 9)
	check(f(0).IsErr())
	check(g(0).IsErr())
}
