---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:strconv"
  
  fn main() {
    let t: (fn(string) -> Result<int, error>, int) = (strconv.Atoi, 1)
    let r = t.0("1")
    match r {
      Ok(v) => { let _ = v },
      Err(_) => { let _ = 0 },
    }
  }
---
package main

import (
	lisette "github.com/ivov/lisette/prelude"
	"strconv"
)

func main() {
	t := lisette.MakeTuple2[func(string) lisette.Result[int, error], int](func(arg0 string) lisette.Result[int, error] {
		return lisette.ResultFromPair[int](strconv.Atoi(arg0))
	}, 1)
	r := t.First("1")
	if r.Tag == lisette.ResultOk {
		_ = r.OkVal
	}
}
