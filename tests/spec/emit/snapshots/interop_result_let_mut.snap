---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:strconv"
  
  fn main() {
    let mut f: fn(string) -> Result<int, error> = strconv.Atoi
    let r = f("42")
    let _ = r
    f = strconv.Atoi
    let r2 = f("99")
    let _ = r2
  }
---
package main

import (
	lisette "github.com/ivov/lisette/prelude"
	"strconv"
)

func main() {
	f := func(arg0 string) lisette.Result[int, error] {
		return lisette.ResultFromPair[int](strconv.Atoi(arg0))
	}
	r := f("42")
	_ = r
	f = func(arg0 string) lisette.Result[int, error] {
		return lisette.ResultFromPair[int](strconv.Atoi(arg0))
	}
	r2 := f("99")
	_ = r2
}
