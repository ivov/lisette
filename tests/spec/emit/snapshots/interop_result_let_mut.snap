---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:strconv"
  
  fn main() {
    let mut f: fn(string) -> Result<int, error> = strconv.Atoi
    let r = f("42")
    let _ = r
    f = strconv.Atoi
    let r2 = f("99")
    let _ = r2
  }
---
package main

import (
	lisette "github.com/ivov/lisette/prelude"
	"strconv"
)

func main() {
	f := strconv.Atoi
	ret_1, ret_2 := f("42")
	var r lisette.Result[int, error]
	if ret_2 != nil {
		r = lisette.MakeResultErr[int, error](ret_2)
	} else {
		r = lisette.MakeResultOk[int, error](ret_1)
	}
	_ = r
	f = strconv.Atoi
	ret_3, ret_4 := f("99")
	var r2 lisette.Result[int, error]
	if ret_4 != nil {
		r2 = lisette.MakeResultErr[int, error](ret_4)
	} else {
		r2 = lisette.MakeResultOk[int, error](ret_3)
	}
	_ = r2
}
