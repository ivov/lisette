---
source: tests/spec/emit/result_option_patterns.rs
description: |
  
  fn test() {
    let mut rows = [[1]]
    if let Some(row) = rows.get(0) {
      row[0] = 9
    }
    if rows[0][0] != 9 { panic("the payload write should reach the original slice") }
  }
---
package main

func test() {
	rows := [][]int{{1}}
	if len(rows) > 0 {
		row := rows[0]
		row[0] = 9
	}
	if rows[0][0] != 9 {
		panic("the payload write should reach the original slice")
	}
}
