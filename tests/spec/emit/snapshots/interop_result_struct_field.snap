---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:strconv"
  
  struct Parser { parse: fn(string) -> Result<int, error> }
  
  fn main() {
    let p = Parser { parse: strconv.Atoi }
    let r = p.parse("42")
    match r {
      Ok(v) => { let _ = v },
      Err(_) => { let _ = 0 },
    }
  }
---
package main

import (
	lisette "github.com/ivov/lisette/prelude"
	"strconv"
)

type Parser struct {
	parse func(string) lisette.Result[int, error]
}

func main() {
	p := Parser{parse: func(arg0 string) lisette.Result[int, error] {
		return lisette.ResultFromPair[int](strconv.Atoi(arg0))
	}}
	r := p.parse("42")
	if r.Tag == lisette.ResultOk {
		_ = r.OkVal
	}
}
