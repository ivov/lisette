---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:strconv"
  
  struct Parser { parse: fn(string) -> Result<int, error> }
  
  fn main() {
    let p = Parser { parse: strconv.Atoi }
    let r = p.parse("42")
    match r {
      Ok(v) => { let _ = v },
      Err(_) => { let _ = 0 },
    }
  }
---
package main

import (
	lisette "github.com/ivov/lisette/prelude"
	"strconv"
)

type Parser struct {
	parse func(string) (int, error)
}

func main() {
	p := Parser{parse: strconv.Atoi}
	ret, ret_1 := p.parse("42")
	var r lisette.Result[int, error]
	if ret_1 != nil {
		r = lisette.MakeResultErr[int, error](ret_1)
	} else {
		r = lisette.MakeResultOk[int, error](ret)
	}
	if r.Tag == lisette.ResultOk {
		_ = r.OkVal
	}
}
