---
package main

import (
	"fmt"
	lisette "github.com/ivov/lisette/prelude"
	"strconv"
)

func main() {
	_ = strconv.Atoi
	f := strconv.Atoi
	r := lisette.ResultFromPair[int](f("42"))
	fmt.Println(r)
}
