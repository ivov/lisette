---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:bufio"
  import "go:fmt"
  import "go:strings"
  
  fn main() {
    let mut forwarded = bufio.NewScanner(strings.NewReader("one two three"))
    forwarded.Split(|data, at_eof| bufio.ScanWords(data, at_eof))
    let mut count = 0
    while forwarded.Scan() {
      count += 1
    }
    fmt.Println(count)
  
    let mut rebuilt = bufio.NewScanner(strings.NewReader("four five"))
    rebuilt.Split(|data, at_eof| {
      let (advance, token) = bufio.ScanWords(data, at_eof)?
      Ok((advance, token))
    })
    let mut words = 0
    while rebuilt.Scan() {
      words += 1
    }
    fmt.Println(words)
  }
---
package main

import (
	"bufio"
	"fmt"
	"strings"

	lisette "github.com/ivov/lisette/prelude"
)

func main() {
	forwarded := bufio.NewScanner(strings.NewReader("one two three"))
	callee := forwarded.Split
	cb := func(data []byte, atEof bool) lisette.Result[lisette.Tuple2[int, []byte], error] {
		ret, ret2, ret3 := bufio.ScanWords(data, atEof)
		tup := lisette.MakeTuple2(ret, ret2)
		if ret3 != nil {
			return lisette.MakeResultErr[lisette.Tuple2[int, []byte], error](ret3)
		}
		return lisette.MakeResultOk[lisette.Tuple2[int, []byte], error](tup)
	}
	callee(func(arg0 []byte, arg1 bool) (int, []byte, error) {
		res := cb(arg0, arg1)
		if res.Tag == lisette.ResultOk {
			tup2 := res.OkVal
			return tup2.First, tup2.Second, nil
		}
		return 0, nil, res.ErrVal
	})
	count := 0
	for forwarded.Scan() {
		count++
	}
	fmt.Println(count)
	rebuilt := bufio.NewScanner(strings.NewReader("four five"))
	callee2 := rebuilt.Split
	cb2 := func(data []byte, atEof bool) lisette.Result[lisette.Tuple2[int, []byte], error] {
		ret4, ret5, ret6 := bufio.ScanWords(data, atEof)
		tup3 := lisette.MakeTuple2(ret4, ret5)
		var result lisette.Result[lisette.Tuple2[int, []byte], error]
		if ret6 != nil {
			result = lisette.MakeResultErr[lisette.Tuple2[int, []byte], error](ret6)
		} else {
			result = lisette.MakeResultOk[lisette.Tuple2[int, []byte], error](tup3)
		}
		check := result
		if check.Tag != lisette.ResultOk {
			return check
		}
		advance := check.OkVal.First
		token := check.OkVal.Second
		return lisette.MakeResultOk[lisette.Tuple2[int, []byte], error](lisette.MakeTuple2[int, []byte](advance, token))
	}
	callee2(func(arg0 []byte, arg1 bool) (int, []byte, error) {
		res2 := cb2(arg0, arg1)
		if res2.Tag == lisette.ResultOk {
			tup4 := res2.OkVal
			return tup4.First, tup4.Second, nil
		}
		return 0, nil, res2.ErrVal
	})
	words := 0
	for rebuilt.Scan() {
		words++
	}
	fmt.Println(words)
}
