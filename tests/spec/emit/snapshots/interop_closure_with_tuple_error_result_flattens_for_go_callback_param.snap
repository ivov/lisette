---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:bufio"
  import "go:fmt"
  import "go:strings"
  
  fn main() {
    let mut forwarded = bufio.NewScanner(strings.NewReader("one two three"))
    forwarded.Split(|data, at_eof| bufio.ScanWords(data, at_eof))
    let mut count = 0
    while forwarded.Scan() {
      count += 1
    }
    fmt.Println(count)
  
    let mut rebuilt = bufio.NewScanner(strings.NewReader("four five"))
    rebuilt.Split(|data, at_eof| {
      let (advance, token) = bufio.ScanWords(data, at_eof)?
      Ok((advance, token))
    })
    let mut words = 0
    while rebuilt.Scan() {
      words += 1
    }
    fmt.Println(words)
  }
---
package main

import (
	"bufio"
	"fmt"
	lisette "github.com/ivov/lisette/prelude"
	"strings"
)

func main() {
	forwarded := bufio.NewScanner(strings.NewReader("one two three"))
	callee := forwarded.Split
	cb := func(data []byte, at_eof bool) lisette.Result[lisette.Tuple2[int, []byte], error] {
		ret, ret_1, ret_2 := bufio.ScanWords(data, at_eof)
		tup := lisette.MakeTuple2(ret, ret_1)
		if ret_2 != nil {
			return lisette.MakeResultErr[lisette.Tuple2[int, []byte], error](ret_2)
		}
		return lisette.MakeResultOk[lisette.Tuple2[int, []byte], error](tup)
	}
	callee(func(arg0 []byte, arg1 bool) (int, []byte, error) {
		res := cb(arg0, arg1)
		if res.Tag == lisette.ResultOk {
			tup_1 := res.OkVal
			return tup_1.First, tup_1.Second, nil
		}
		return 0, nil, res.ErrVal
	})
	count := 0
	for forwarded.Scan() {
		count++
	}
	fmt.Println(count)
	rebuilt := bufio.NewScanner(strings.NewReader("four five"))
	callee_1 := rebuilt.Split
	cb_1 := func(data []byte, at_eof bool) lisette.Result[lisette.Tuple2[int, []byte], error] {
		ret_3, ret_4, ret_5 := bufio.ScanWords(data, at_eof)
		tup_2 := lisette.MakeTuple2(ret_3, ret_4)
		var result lisette.Result[lisette.Tuple2[int, []byte], error]
		if ret_5 != nil {
			result = lisette.MakeResultErr[lisette.Tuple2[int, []byte], error](ret_5)
		} else {
			result = lisette.MakeResultOk[lisette.Tuple2[int, []byte], error](tup_2)
		}
		check := result
		if check.Tag != lisette.ResultOk {
			return check
		}
		advance := check.OkVal.First
		token := check.OkVal.Second
		return lisette.MakeResultOk[lisette.Tuple2[int, []byte], error](lisette.MakeTuple2[int, []byte](advance, token))
	}
	callee_1(func(arg0 []byte, arg1 bool) (int, []byte, error) {
		res_1 := cb_1(arg0, arg1)
		if res_1.Tag == lisette.ResultOk {
			tup_3 := res_1.OkVal
			return tup_3.First, tup_3.Second, nil
		}
		return 0, nil, res_1.ErrVal
	})
	words := 0
	for rebuilt.Scan() {
		words++
	}
	fmt.Println(words)
}
