---
source: tests/spec/emit/types.rs
description: |
  
  import "go:fmt"
  
  struct Pair<X, Y> { x: X, y: Y }
  
  impl<A, B> Pair<B, A> {
    fn names() -> string {
      let a: Option<A> = None
      let b: Option<B> = None
      fmt.Sprintf("%T %T", a, b)
    }
  }
  
  struct Q<X, Y> { x: X, y: Y }
  
  impl<T> Q<int, T> {
    fn name() -> string {
      let t: Option<T> = None
      fmt.Sprintf("%T", t)
    }
  }
  
  type P = Pair<int, string>
  type R = Q<int, string>
  
  fn main() {
    let f = P.names
    fmt.Println(f(), P.names())
    let g = R.name
    fmt.Println(g(), R.name())
  }
---
package main

import (
	"fmt"

	lisette "github.com/ivov/lisette/prelude"
)

type Pair[X any, Y any] struct {
	x X
	y Y
}

func pairNames[A any, B any]() string {
	a := lisette.MakeOptionNone[A]()
	b := lisette.MakeOptionNone[B]()
	return fmt.Sprintf("%T %T", a, b)
}

type Q[X any, Y any] struct {
	x X
	y Y
}

func qName[T any]() string {
	t := lisette.MakeOptionNone[T]()
	return fmt.Sprintf("%T", t)
}

type P = Pair[int, string]

type R = Q[int, string]

func main() {
	f := pairNames[string, int]
	fmt.Println(f(), pairNames[string, int]())
	g := qName[string]
	fmt.Println(g(), qName[string]())
}
