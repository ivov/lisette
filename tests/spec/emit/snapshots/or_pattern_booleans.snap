---
source: tests/spec/emit/control_flow.rs
description: |
  
  fn test(a: bool, b: bool) -> string {
    match (a, b) {
      (true, true) | (false, false) => "same",
      (true, false) | (false, true) => "different",
    }
  }
---
package main

func test(a, b bool) string {
	if (a && b) || (!a && !b) {
		return "same"
	}
	return "different"
}
