---
source: tests/spec/emit/functions.rs
description: |
  
  fn side_a() -> int { 1 }
  
  fn get_xs() -> Result<Slice<int>, error> { Ok([1, 2, 3]) }
  
  fn variadic(_first: int, _rest: VarArgs<int>) -> int { 0 }
  
  fn run() -> Result<int, error> {
    Ok(variadic(side_a(), get_xs()?...))
  }
---
package main

func sideA() int {
	return 1
}

func getXs() ([]int, error) {
	return []int{1, 2, 3}, nil
}

func variadic(_ int, _ ...int) int {
	return 0
}

func run() (int, error) {
	arg_3 := sideA()
	ret_1, ret_2 := getXs()
	if ret_2 != nil {
		return 0, ret_2
	}
	return variadic(arg_3, ret_1...), nil
}
