---
source: tests/spec/emit/types.rs
description: |
  
  fn main() {
    let ch = Channel.buffered<int>(1)
    ch.send(42)
    let r = &ch
    let _ = select {
      let Some(v) = r.receive() => v,
      _ => 0,
    }
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

func main() {
	ch := make(chan int, 1)
	lisette.ChannelSend(ch, 42)
	r := &ch
	var tmp int
	ch_1 := *r
	for {
		select {
		case v, ok := <-ch_1:
			if ok {
				tmp = v
			} else {
				ch_1 = nil
				continue
			}
		default:
			tmp = 0
		}
		break
	}
	_ = tmp
}
