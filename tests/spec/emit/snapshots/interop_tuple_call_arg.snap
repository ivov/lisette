---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:path"
  
  fn use_split(f: fn(string) -> (string, string), p: string) -> string {
    let (dir, file) = f(p)
    f"{dir}/{file}"
  }
  
  fn main() {
    let r = use_split(path.Split, "/foo/bar.txt")
    let _ = r
  }
---
package main

import (
	lisette "github.com/ivov/lisette/prelude"
	"path"
)

func useSplit(f func(string) lisette.Tuple2[string, string], p string) string {
	tmp := f(p)
	dir := tmp.First
	file := tmp.Second
	return dir + "/" + file
}

func main() {
	cb := path.Split
	var adapted func(string) lisette.Tuple2[string, string]
	if cb != nil {
		adapted = func(arg0 string) lisette.Tuple2[string, string] {
			ret, ret_1 := cb(arg0)
			tup := lisette.MakeTuple2(ret, ret_1)
			return tup
		}
	}
	r := useSplit(adapted, "/foo/bar.txt")
	_ = r
}
