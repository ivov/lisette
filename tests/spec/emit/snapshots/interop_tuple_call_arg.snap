---
source: tests/spec/emit/interop_matrix.rs
description: |
  
  import "go:path"
  
  fn use_split(f: fn(string) -> (string, string), p: string) -> string {
    let (dir, file) = f(p)
    f"{dir}/{file}"
  }
  
  fn main() {
    let r = use_split(path.Split, "/foo/bar.txt")
    let _ = r
  }
---
package main

import (
	"fmt"
	lisette "github.com/ivov/lisette/prelude"
	"path"
)

func useSplit(f func(string) (string, string), p string) string {
	ret_1, ret_2 := f(p)
	tup_3 := lisette.MakeTuple2(ret_1, ret_2)
	dir := tup_3.First
	file := tup_3.Second
	return fmt.Sprintf("%s/%s", dir, file)
}

func main() {
	r := useSplit(path.Split, "/foo/bar.txt")
	_ = r
}
