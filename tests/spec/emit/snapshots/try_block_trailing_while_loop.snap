---
source: tests/spec/emit/result_option_patterns.rs
description: |
  
  fn f() -> Result<(), string> {
    try {
      let _ = Ok(1)?
      while true {
        break
      }
    }
  }
  
  fn test() -> Result<(), string> {
    f()
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

func f() lisette.Result[struct{}, string] {
	check := lisette.MakeResultOk[int, string](1)
	if check.Tag != lisette.ResultOk {
		return lisette.MakeResultErr[struct{}, string](check.ErrVal)
	}
	for {
		break
	}
	return lisette.MakeResultOk[struct{}, string](struct{}{})
}

func test() lisette.Result[struct{}, string] {
	return f()
}
