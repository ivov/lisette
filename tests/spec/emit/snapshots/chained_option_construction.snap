---
source: tests/spec/emit/result_option_patterns.rs
description: |
  
  fn get_value() -> Option<int> {
    Some(42)
  }
  
  fn test() -> Option<int> {
    let x = get_value();
    x
  }
---
package main

import lisette "github.com/ivov/lisette/prelude"

func getValue() (int, bool) {
	return 42, true
}

func test() (int, bool) {
	x := lisette.OptionFromCommaOk[int](getValue())
	v_1 := x
	if v_1.Tag == lisette.OptionSome {
		return v_1.SomeVal, true
	}
	return 0, false
}
