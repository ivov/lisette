---
source: tests/spec/emit/functions.rs
description: |
  
  import "go:errors"
  type F<T> = fn(int) -> T
  type R = Result<F<Option<int>>, error>
  type O = Option<F<Option<int>>>
  fn check(ok: bool) { if !ok { panic("runtime assertion failed") } }
  fn source(n: int) -> Option<int> { if n > 0 { Some(n) } else { None } }
  fn int_result(n: int) -> Result<int, error> { if n == 0 { Err(errors.New("empty")) } else { Ok(n) } }
  fn make_r(n: int) -> R { let _ = int_result(n)?; Ok(source) }
  fn make_o(n: int) -> O { let _ = source(n)?; Some(source) }
  fn try_r(n: int) -> R { try { let _ = int_result(n)?; source } }
  fn try_o(n: int) -> O { try { let _ = source(n)?; source } }
  fn main() {
    let Ok(r) = make_r(1) else { panic("missing result") }
    check(r(2).unwrap_or(0) == 2)
    let Some(o) = make_o(1) else { panic("missing option") }
    check(o(3).unwrap_or(0) == 3)
    let Ok(tr) = try_r(1) else { panic("missing try result") }
    check(tr(4).unwrap_or(0) == 4)
    let Some(to) = try_o(1) else { panic("missing try option") }
    check(to(5).unwrap_or(0) == 5)
    let Err(_) = make_r(0) else { panic("expected result failure") }
    let None = make_o(0) else { panic("expected option failure") }
    let Err(_) = try_r(0) else { panic("expected try result failure") }
    let None = try_o(0) else { panic("expected try option failure") }
  }
---
package main

import (
	"errors"

	lisette "github.com/ivov/lisette/prelude"
)

type F[T any] = func(int) T

type R = lisette.Result[F[lisette.Option[int]], error]

type O = lisette.Option[F[lisette.Option[int]]]

func check(ok bool) {
	if !ok {
		panic("runtime assertion failed")
	}
}

func source(n int) (int, bool) {
	if n > 0 {
		return n, true
	}
	return 0, false
}

func intResult(n int) (int, error) {
	if n == 0 {
		return 0, errors.New("empty")
	}
	return n, nil
}

func makeR(n int) (F[lisette.Option[int]], error) {
	if _, err := intResult(n); err != nil {
		return *new(F[lisette.Option[int]]), err
	}
	return func(arg0 int) lisette.Option[int] {
		return lisette.OptionFromCommaOk[int](source(arg0))
	}, nil
}

func makeO(n int) F[lisette.Option[int]] {
	if _, ok := source(n); !ok {
		return nil
	}
	return func(arg0 int) lisette.Option[int] {
		return lisette.OptionFromCommaOk[int](source(arg0))
	}
}

func tryR(n int) (F[lisette.Option[int]], error) {
	if _, err := intResult(n); err != nil {
		return *new(F[lisette.Option[int]]), err
	}
	return func(arg0 int) lisette.Option[int] {
		return lisette.OptionFromCommaOk[int](source(arg0))
	}, nil
}

func tryO(n int) F[lisette.Option[int]] {
	if _, ok := source(n); !ok {
		return nil
	}
	return func(arg0 int) lisette.Option[int] {
		return lisette.OptionFromCommaOk[int](source(arg0))
	}
}

func main() {
	r, err := makeR(1)
	if err != nil {
		panic("missing result")
	}
	check(r(2).UnwrapOr(0) == 2)
	raw := makeO(1)
	option := lisette.OptionFromNilable[F[lisette.Option[int]]](raw, raw == nil)
	if option.Tag != lisette.OptionSome {
		panic("missing option")
	}
	o := option.SomeVal
	check(o(3).UnwrapOr(0) == 3)
	tr, err2 := tryR(1)
	if err2 != nil {
		panic("missing try result")
	}
	check(tr(4).UnwrapOr(0) == 4)
	raw2 := tryO(1)
	option2 := lisette.OptionFromNilable[F[lisette.Option[int]]](raw2, raw2 == nil)
	if option2.Tag != lisette.OptionSome {
		panic("missing try option")
	}
	to := option2.SomeVal
	check(to(5).UnwrapOr(0) == 5)
	subject := lisette.ResultFromPair[F[lisette.Option[int]]](makeR(0))
	if subject.Tag != lisette.ResultErr {
		panic("expected result failure")
	}
	raw3 := makeO(0)
	option3 := lisette.OptionFromNilable[F[lisette.Option[int]]](raw3, raw3 == nil)
	if option3.Tag != lisette.OptionNone {
		panic("expected option failure")
	}
	subject2 := lisette.ResultFromPair[F[lisette.Option[int]]](tryR(0))
	if subject2.Tag != lisette.ResultErr {
		panic("expected try result failure")
	}
	raw4 := tryO(0)
	option4 := lisette.OptionFromNilable[F[lisette.Option[int]]](raw4, raw4 == nil)
	if option4.Tag != lisette.OptionNone {
		panic("expected try option failure")
	}
}
