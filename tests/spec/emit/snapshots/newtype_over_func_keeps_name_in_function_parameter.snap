---
source: tests/spec/emit/types.rs
description: |
  
  #[display]
  struct Cb(fn(int) -> ())
  
  fn apply(g: fn(Cb) -> string, c: Cb) -> string {
    g(c)
  }
  
  fn main() {
    let cb = Cb(|_| {})
    let _ = apply(|c| c.to_string(), cb)
  }
---
package main

import "fmt"

type Cb func(int) struct{}

func (c Cb) String() string {
	return fmt.Sprintf("Cb(%p)", (func(int) struct{})(c))
}

func (c Cb) toString() string {
	return c.String()
}

func apply(g func(Cb) string, c Cb) string {
	return g(c)
}

func main() {
	cb := Cb(func(_ int) struct{} {
		return struct{}{}
	})
	apply(func(c Cb) string {
		return c.toString()
	}, cb)
}
