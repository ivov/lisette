---
source: tests/spec/emit/prelude.rs
description: |
  
  import "go:os"
  
  struct Holder {
    slc: Slice<int>,
  }
  
  fn main() {
    for n in [0, 2] {
      let mut base = [1, 2]
      let mut calls = 0
      let count = || {
        calls += 1
        base = [3, 4]
        n
      }
      let result = { base.reserve(count()) }
      if calls != 1 || result[0] != 1 {
        panic("reserve must read the receiver before evaluating the count once")
      }
    }
  
    for extra in [[], [7]] {
      let mut holder = Holder { slc: [1, 2] }
      let mut calls = 0
      let make_extra = || {
        calls += 1
        holder.slc = [3, 4]
        extra
      }
      let result = { holder.slc.append(make_extra()...) }
      if calls != 1 || result[0] != 1 || result.length() != 2 + extra.length() {
        panic("append must read the receiver before evaluating the spread once")
      }
    }
  
    for n in [0, 2] {
      os.Args = ["before"]
      let count = || {
        os.Args = ["after"]
        n
      }
      let result = { os.Args.reserve(count()) }
      if result[0] != "before" {
        panic("reserve must read a package receiver before argument effects")
      }
    }
  }
---
package main

import (
	"os"
	"slices"
)

type Holder struct {
	slc []int
}

func main() {
	for _, n := range []int{0, 2} {
		base := []int{1, 2}
		calls := 0
		count := func() int {
			calls++
			base = []int{3, 4}
			return n
		}
		var result []int
		recv := base
		added := count()
		result = func() []int {
			if added == 0 {
				return slices.Clone(recv)
			}
			return slices.Grow(slices.Clip(recv), added)
		}()
		if calls != 1 || result[0] != 1 {
			panic("reserve must read the receiver before evaluating the count once")
		}
	}
	for _, extra := range [][]int{{}, {7}} {
		holder := Holder{slc: []int{1, 2}}
		calls := 0
		makeExtra := func() []int {
			calls++
			holder.slc = []int{3, 4}
			return extra
		}
		var result []int
		recv2 := holder.slc
		added2 := makeExtra()
		result = func() []int {
			if len(added2) == 0 {
				return slices.Clone(recv2)
			}
			return append(slices.Clip(recv2), added2...)
		}()
		if calls != 1 || result[0] != 1 || len(result) != 2+len(extra) {
			panic("append must read the receiver before evaluating the spread once")
		}
	}
	for _, n := range []int{0, 2} {
		os.Args = []string{"before"}
		count := func() int {
			os.Args = []string{"after"}
			return n
		}
		var result []string
		recv3 := os.Args
		added3 := count()
		result = func() []string {
			if added3 == 0 {
				return slices.Clone(recv3)
			}
			return slices.Grow(slices.Clip(recv3), added3)
		}()
		if result[0] != "before" {
			panic("reserve must read a package receiver before argument effects")
		}
	}
}
