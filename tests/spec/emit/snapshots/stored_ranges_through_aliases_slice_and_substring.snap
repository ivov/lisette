---
package main

import (
	"fmt"

	lisette "github.com/ivov/lisette/prelude"
)

type Span = lisette.RangeInclusive[int]

type Tail = lisette.RangeFrom[int]

func main() {
	items := []int{1, 2, 3, 4, 5}
	s := lisette.RangeInclusive[int]{
		Start: 1,
		End:   3,
	}
	t := lisette.RangeFrom[int]{Start: 2}
	word := "hello"
	arg := items[s.Start : s.End+1 : s.End+1]
	fmt.Println(arg, items[t.Start:len(items):len(items)], lisette.Substring(word, s.Start, s.End+1), lisette.SubstringFrom(word, t.Start))
}
