---
source: tests/spec/emit/types.rs
description: |
  
  import "go:fmt"
  
  type Span = RangeInclusive<int>
  type Tail = RangeFrom<int>
  
  fn main() {
    let items = [1, 2, 3, 4, 5]
    let s: Span = 1..=3
    let t: Tail = 2..
    let word = "hello"
    fmt.Println(items[s], items[t], word.substring(s), word.substring(t))
