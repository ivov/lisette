---
source: tests/spec/emit/functions.rs
description: |
  
  fn main() {
    let target = 7
    let f = || {
      let target = [1].get(0).map(|ret| ret + target).unwrap_or(0)
      let read = || target
      read()
    }
    let mut total = 0
    for target in [2, 3] {
      total += match target {
        value if value > 0 => { let read = || value; read() + f() },
        _ => 0,
      }
    }
    if total != 21 || target != 7 { panic("mapped default identity") }
  }
---
package main

func main() {
	target := 7
	f := func() int {
		var target2 int
		recv := []int{1}
		if len(recv) > 0 {
			ret := recv[0]
			target2 = ret + target
		} else {
			target2 = 0
		}
		read := func() int {
			return target2
		}
		return read()
	}
	total := 0
	for _, target3 := range []int{2, 3} {
		left := total
		var tmp int
		switch {
		case target3 > 0:
			value := target3
			read := func() int {
				return value
			}
			tmp = read() + f()
		default:
			tmp = 0
		}
		total = left + tmp
	}
	if total != 21 || target != 7 {
		panic("mapped default identity")
	}
}
