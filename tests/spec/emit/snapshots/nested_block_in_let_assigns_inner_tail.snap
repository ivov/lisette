---
source: tests/spec/emit/control_flow.rs
description: |
  
  fn do_nothing() {}
  
  fn test() {
    let unit = { { do_nothing() } }
    let value = {
      let k = 2
      {
        let m = k * 3
        m + 1
      }
    }
    let _ = unit
    if value != 7 { panic("wrong") }
  }
---
package main

func doNothing() {}

func test() {
	var unit struct{}
	doNothing()
	unit = struct{}{}
	var value int
	{
		k := 2
		{
			m := k * 3
			value = m + 1
		}
	}
	_ = unit
	if value != 7 {
		panic("wrong")
	}
}
