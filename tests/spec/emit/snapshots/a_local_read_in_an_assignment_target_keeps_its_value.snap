---
source: tests/spec/emit/result_option_patterns.rs
description: |
  
  fn pair(n: int) -> (int, string) {
    (n, f"p{n}")
  }
  
  fn place(m: Map<string, int>) -> Slice<int> {
    let found = m.get("a")
    let mut xs = [0, 0, 0]
    xs[found.unwrap_or(0)] = 9
    xs
  }
  
  fn bump() -> Slice<int> {
    let p = pair(1)
    let mut xs = [0, 0, 0]
    xs[p.0] += 4
    xs
  }
  
  fn test() {
    if place(Map.from([("a", 2)]))[2] != 9 { panic("the found index should be written") }
    if bump()[1] != 4 { panic("the tuple index should be bumped") }
  }
---
package main

import "fmt"

func pair(n int) (int, string) {
	return n, fmt.Sprintf("p%d", n)
}

func place(m map[string]int) []int {
	found, ok := m["a"]
	xs := []int{0, 0, 0}
	base := xs
	if !ok {
		found = 0
	}
	base[found] = 9
	return xs
}

func bump() []int {
	p0, _ := pair(1)
	xs := []int{0, 0, 0}
	xs[p0] += 4
	return xs
}

func test() {
	if place(map[string]int{"a": 2})[2] != 9 {
		panic("the found index should be written")
	}
	if bump()[1] != 4 {
		panic("the tuple index should be bumped")
	}
}
