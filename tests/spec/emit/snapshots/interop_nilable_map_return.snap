package main

import (
	"example.com/reg"
	lisette "github.com/ivov/lisette/prelude"
)

func main() {
	raw_2 := reg.Registry(true)
	option_3 := lisette.OptionFromNilable[map[string]int](raw_2, raw_2 == nil)
	if option_3.Tag == lisette.OptionSome {
		_ = len(option_3.SomeVal)
	} else {
	}
}
