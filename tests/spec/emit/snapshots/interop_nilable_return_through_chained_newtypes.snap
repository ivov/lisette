      None => { let _ = 0 },
    }
  }
---
package main

import (
	"example.com/reg"
	lisette "github.com/ivov/lisette/prelude"
)

func main() {
	raw_1 := reg.Lookup()
	option_2 := lisette.OptionFromNilable[reg.Index](raw_1, raw_1 == nil)
	if option_2.Tag == lisette.OptionSome {
		_ = option_2.SomeVal
	}
}
