---
source: tests/spec/emit/prelude.rs
description: |
  
  struct User { name: string }
  
  fn test(users: Slice<Ref<User>>, wanted: string) -> Option<Ref<User>> {
    users.find(|u| u.name == wanted)
  }
---
package main

type User struct {
	name string
}

func test(users []*User, wanted string) *User {
	for _, u := range users {
		if u.name == wanted {
			return u
		}
	}
	return nil
}
