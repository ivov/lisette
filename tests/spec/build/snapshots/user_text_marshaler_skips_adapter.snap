// === main.go ===
package main

import "encoding"

type Widget struct {
	id int
}

func (w Widget) MarshalText() ([]byte, error) {
	return ([]byte)("custom"), nil
}

func marshaler() encoding.TextMarshaler {
	return Widget{id: 7}
}

func main() {
	marshaler()
}
