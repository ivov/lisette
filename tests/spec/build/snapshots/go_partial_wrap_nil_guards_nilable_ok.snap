// === main.go ===
package main

import (
	"fmt"
	"go/parser"

	lisette "github.com/ivov/lisette/prelude"
)

func main() {
	if ret, err := parser.ParseExpr("1 + 2"); err == nil {
		fmt.Print("ok")
	} else if lisette.IsNilInterface(ret) {
		fmt.Print("err")
	} else {
		fmt.Print("both")
	}
}
