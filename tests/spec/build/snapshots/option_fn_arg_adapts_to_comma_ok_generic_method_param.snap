// === main.go ===
package main

import lisette "github.com/ivov/lisette/prelude"

type Face interface {
}

func Lookup(_ int) Face {
	return nil
}

type Holder struct {
	N int
}

func Holder_Resolve[R any](self Holder, f func(int) lisette.Option[R]) (R, bool) {
	v := f(self.N)
	if v.Tag == lisette.OptionSome {
		return v.SomeVal, true
	}
	return *new(R), false
}

func main() {
	cb := Lookup
	var adapted func(int) lisette.Option[Face]
	if cb != nil {
		adapted = func(arg0 int) lisette.Option[Face] {
			raw := cb(arg0)
			option := lisette.OptionFromNilable[Face](raw, lisette.IsNilInterface(raw))
			return option
		}
	}
	ret, ret_1 := Holder_Resolve(Holder{N: 4}, adapted)
	var rez lisette.Option[Face]
	if ret_1 && !lisette.IsNilInterface(ret) {
		rez = lisette.MakeOptionSome[Face](ret)
	} else {
		rez = lisette.MakeOptionNone[Face]()
	}
	_ = rez
}
