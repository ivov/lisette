// === main.go ===
package main

import lisette "github.com/ivov/lisette/prelude"

type Face interface {
}

func Resultant(arg int) (int, Face) {
	return arg, nil
}

func Resolve[T any, R any, E any](a T, f func(T) lisette.Result[R, E]) lisette.Result[R, E] {
	return f(a)
}

func main() {
	rez := Resolve(42, func(arg0 int) lisette.Result[int, Face] {
		ret, ret2 := Resultant(arg0)
		if ret2 != nil {
			return lisette.MakeResultErr[int, Face](ret2)
		}
		return lisette.MakeResultOk[int, Face](ret)
	})
	_ = rez
}
