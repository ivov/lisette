// === main.go ===
package main

import lisette "github.com/ivov/lisette/prelude"

type Face interface {
}

func Resultant(arg int) (int, Face) {
	return arg, nil
}

type Holder struct {
	N int
}

func Holder_Resolve[R any, E any](self Holder, f func(int) lisette.Result[R, E]) lisette.Result[R, E] {
	return f(self.N)
}

func main() {
	_arg_4 := Holder{N: 4}
	cb_1 := Resultant
	rez := Holder_Resolve(_arg_4, func(arg0 int) lisette.Result[int, Face] {
		ret_2, ret_3 := cb_1(arg0)
		if ret_3 != nil {
			return lisette.MakeResultErr[int, Face](ret_3)
		} else {
			return lisette.MakeResultOk[int, Face](ret_2)
		}
	})
	_ = rez
}
