// === main.go ===
package main

import lisette "github.com/ivov/lisette/prelude"

type Face interface {
}

func Resultant(arg int) (int, Face) {
	return arg, nil
}

type Holder struct{}

func HolderResolve[R any, E any](_ Holder, default_ R, _ ...func(int) lisette.Result[R, E]) lisette.Result[R, E] {
	return lisette.MakeResultOk[R, E](default_)
}

func main() {
	fns := []func(int) lisette.Result[int, Face]{func(arg0 int) lisette.Result[int, Face] {
		ret, ret2 := Resultant(arg0)
		if ret2 != nil {
			return lisette.MakeResultErr[int, Face](ret2)
		}
		return lisette.MakeResultOk[int, Face](ret)
	}}
	rez := HolderResolve[int, Face](Holder{}, 0, fns...)
	_ = rez
}
