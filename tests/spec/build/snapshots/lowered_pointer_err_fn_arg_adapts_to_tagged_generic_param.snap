// === main.go ===
package main

import (
	lisette "github.com/ivov/lisette/prelude"
	"strconv"
)

func Parser(arg int) (int, *strconv.NumError) {
	return arg, nil
}

func Resolve[T any, R any, E any](a T, f func(T) lisette.Result[R, E]) lisette.Result[R, E] {
	return f(a)
}

func main() {
	Resolve(0, func(arg0 int) lisette.Result[int, *strconv.NumError] {
		ret, ret2 := Parser(arg0)
		if ret2 != nil {
			return lisette.MakeResultErr[int, *strconv.NumError](ret2)
		}
		return lisette.MakeResultOk[int, *strconv.NumError](ret)
	})
}
