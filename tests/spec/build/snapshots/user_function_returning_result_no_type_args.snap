// === main.go ===
package main

import (
	"fmt"
	"strconv"
)

func parseInt(s string) (int, error) {
	return strconv.Atoi(s)
}

func main() {
	ret_1, err_2 := parseInt("42")
	if err_2 == nil {
		n := ret_1
		fmt.Println(n)
	} else {
		e := err_2
		fmt.Println(e)
	}
}
