// === main.go ===
package main

import (
	"errors"
	"fmt"
	"io/fs"
	"os"

	lisette "github.com/ivov/lisette/prelude"
)

func main() {
	ret, ret2 := os.Stat("/tmp")
	var result lisette.Result[fs.FileInfo, error]
	if ret2 != nil {
		result = lisette.MakeResultErr[fs.FileInfo, error](ret2)
	} else if lisette.IsNilInterface(ret) {
		result = lisette.MakeResultErr[fs.FileInfo, error](errors.New("unexpected nil"))
	} else {
		result = lisette.MakeResultOk[fs.FileInfo, error](ret)
	}
	if result.Tag == lisette.ResultOk {
		size := result.OkVal.Size()
		fmt.Printf("size: %d\n", size)
	} else {
		msg := result.ErrVal.Error()
		fmt.Printf("error: %s\n", msg)
	}
}
