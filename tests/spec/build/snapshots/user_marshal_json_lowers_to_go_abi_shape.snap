// === main.go ===
package main

import (
	"encoding/json"
	"fmt"
)

type Widget struct {
	id int
}

func (w Widget) MarshalJSON() ([]uint8, error) {
	return ([]uint8)("\"custom\""), nil
}

func main() {
	w := Widget{id: 7}
	if b, e := json.Marshal(w); e == nil {
		fmt.Println(string(b))
	} else {
		fmt.Println(e)
	}
}
