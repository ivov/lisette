// === first.go ===
package main

import lisette "github.com/ivov/lisette/prelude"

func adaptFirst() {
	consume(_lisAdapter_First_Cache_1{inner: First{}})
}

type _lisAdapter_First_Cache_1 struct {
	inner First
}

func (a _lisAdapter_First_Cache_1) get() (*Entry, bool) {
	raw := a.inner.get()
	option := lisette.OptionFromNilable[*Entry](raw, raw == nil)
	if option.Tag == lisette.OptionSome {
		return option.SomeVal, true
	}
	return nil, false
}


// === main.go ===
