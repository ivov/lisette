// === main.go ===
package main

import (
	lisette "github.com/ivov/lisette/prelude"
	"strings"
)

func find(haystack, needle string) int {
	ret := strings.Index(haystack, needle)
	option := lisette.OptionFromCommaOk[int](ret, ret != -1)
	if option.Tag == lisette.OptionSome {
		return option.SomeVal
	}
	return -2
}

func main() {
	find("hello", "lo")
}
