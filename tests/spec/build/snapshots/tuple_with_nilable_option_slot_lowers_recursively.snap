// === main.go ===
package main

import lisette "github.com/ivov/lisette/prelude"

type Cmd = func() int

func produce() (int, Cmd) {
	return 42, func() int {
		return 7
	}
}

func consume() int {
	ret, ret2 := produce()
	option := lisette.OptionFromNilable[Cmd](ret2, ret2 == nil)
	tup := lisette.MakeTuple2(ret, option)
	n := tup.First
	c := tup.Second
	if c.Tag == lisette.OptionSome {
		return n + c.SomeVal()
	}
	return n
}

func main() {
	consume()
}
