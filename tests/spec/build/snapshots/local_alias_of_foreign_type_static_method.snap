// === main.go ===
package main

import s "github.com/user/myproject/shapes"

type P = s.Point

func main() {
	a := s.NewPoint(1)
	f := s.NewPoint
	_ = a.X + f(2).X
}


// === shapes/mod.go ===
package shapes

type Point struct {
	X int
}

func NewPoint(x int) Point {
	return Point{X: x}
}
