// === main.go ===
package main

import lisette "github.com/ivov/lisette/prelude"

type Face interface {
}

func Fallible(arg int) lisette.Partial[int, Face] {
	return lisette.MakePartialOk[int, Face](arg)
}

func Resolve[T any, R any, E any](a T, f func(T) lisette.Partial[R, E]) lisette.Partial[R, E] {
	return f(a)
}

func main() {
	Resolve(42, Fallible)
}
