// === main.go ===
package main

import (
	"fmt"

	"github.com/user/myproject/util"
)

func main() {
	b := util.NewBox[string]()
	fmt.Println(b.Items)
}


// === util/box.go ===
package util

type Box[T any] struct {
	Items []T
}

func NewBox[T any]() Box[T] {
	return Box[T]{Items: []T{}}
}
