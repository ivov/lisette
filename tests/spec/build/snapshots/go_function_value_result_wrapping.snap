// === main.go ===
package main

import (
	"fmt"
	lisette "github.com/ivov/lisette/prelude"
	"strconv"
)

func main() {
	parse := func(arg0 string) lisette.Result[int, error] {
		return lisette.ResultFromPair[int](strconv.Atoi(arg0))
	}
	subject := parse("42")
	if subject.Tag == lisette.ResultOk {
		fmt.Printf("parsed: %d\n", subject.OkVal)
	} else {
		msg := subject.ErrVal.Error()
		fmt.Println(msg)
	}
}
