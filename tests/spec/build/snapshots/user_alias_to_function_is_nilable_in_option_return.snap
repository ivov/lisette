// === main.go ===
package main

import (
	"fmt"
	lisette "github.com/ivov/lisette/prelude"
)

type Callback func() int

func maybeGet() Callback {
	return func() int {
		return 42
	}
}

func run(cb lisette.Option[Callback]) int {
	if cb.Tag == lisette.OptionSome {
		return cb.SomeVal()
	}
	return -1
}

func main() {
	raw_1 := maybeGet()
	cb := lisette.OptionFromNilable[Callback](raw_1, raw_1 == nil)
	fmt.Println(run(cb))
}
