// === main.go ===
package main

import (
	"fmt"
	"strings"
)

type Name struct {
	first string
	last  string
}

func (n Name) full() string {
	return strings.Join([]string{n.first, n.last}, " ")
}

func main() {
	n := Name{
		first: "A",
		last:  "B",
	}
	fmt.Println(n.first)
}
