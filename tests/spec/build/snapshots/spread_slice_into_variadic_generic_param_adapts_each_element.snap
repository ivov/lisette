// === main.go ===
package main

import lisette "github.com/ivov/lisette/prelude"

type Face interface {
}

func Resultant(arg int) (int, Face) {
	return arg, nil
}

func Resolve[R any, E any](def R, _ ...func(int) lisette.Result[R, E]) lisette.Result[R, E] {
	return lisette.MakeResultOk[R, E](def)
}

func main() {
	fns := []func(int) lisette.Result[int, Face]{func(arg0 int) lisette.Result[int, Face] {
		ret, ret2 := Resultant(arg0)
		if ret2 != nil {
			return lisette.MakeResultErr[int, Face](ret2)
		}
		return lisette.MakeResultOk[int, Face](ret)
	}}
	Resolve[int, Face](0, fns...)
}
