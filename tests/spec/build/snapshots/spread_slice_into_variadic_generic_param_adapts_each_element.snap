// === main.go ===
package main

import lisette "github.com/ivov/lisette/prelude"

type Face interface {
}

func Resultant(arg int) (int, Face) {
	return arg, nil
}

func Resolve[R any, E any](default_ R, _ ...func(int) lisette.Result[R, E]) lisette.Result[R, E] {
	return lisette.MakeResultOk[R, E](default_)
}

func main() {
	fns := []func(int) (int, Face){Resultant}
	src := fns
	adapted := make([]func(int) lisette.Result[int, Face], len(src))
	for i, cb := range src {
		cb_1 := cb
		adapted[i] = func(arg0 int) lisette.Result[int, Face] {
			ret, ret_1 := cb_1(arg0)
			if ret_1 != nil {
				return lisette.MakeResultErr[int, Face](ret_1)
			} else {
				return lisette.MakeResultOk[int, Face](ret)
			}
		}
	}
	Resolve[int, Face](0, adapted...)
}
