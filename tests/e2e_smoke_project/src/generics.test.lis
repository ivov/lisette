import "go:encoding/json"
import "go:regexp/syntax"
import "go:time"

#[test]
fn generic_method_int() {
  let b = Box { value: 42 }
  let result = b.get()
  assert result == 42
}

#[test]
fn generic_method_string() {
  let b = Box { value: "hello" }
  assert b.get() == "hello"
}

#[test]
fn generic_method_chain() {
  let b = Box { value: 10 }
  let result = b
    .map(|x: int| -> int {
      x * 2
    })
    .get()
  assert result == 20
}

#[test]
fn generic_struct_direct_construction() {
  let b = Box { value: 50 }
  let result = b.get()
  assert result == 50
}

#[test]
fn type_alias_basic() {
  let nums: Ints = [1, 2, 3, 4, 5]
  let result = sum_ints(nums)
  assert result == 15
}

#[test]
fn type_alias_bitwise() {
  let m: Mask = 0b1111
  let result = m & 0b0101
  assert result == 5
}

#[test]
fn multi_type_params() {
  let duo = make_duo(10, "hello")
  let result = duo.first
  assert result == 10
}

#[test]
fn multi_type_params_swap() {
  let duo = make_duo("world", 99)
  let result = duo.second
  assert result == 99
}

#[test]
fn duration_times_literal() {
  let d = time.Second * 5
  assert d == 5000000000
}

#[test]
fn duration_times_variable() {
  let n: int = 3
  let d = time.Second * (n as time.Duration)
  assert d == 3000000000
}

#[test]
fn duration_div_duration() {
  let ratio: int64 = (time.Second / time.Millisecond) as int64
  assert ratio == 1000
}

#[test]
fn duration_div_scalar() {
  let half = time.Second / 2
  assert half == 500000000
}

#[test]
fn named_div_to_named_annotation() {
  let d: time.Duration = time.Second / time.Millisecond
  assert d == 1000
}

#[test]
fn named_div_literal_to_named_annotation() {
  let d: time.Duration = time.Second / 2
  assert d == 500000000
}

#[test]
fn string_named_primitive() {
  let code: syntax.ErrorCode = "invalid escape sequence"
  let same = code == syntax.ErrInvalidEscape
  let prefixed: syntax.ErrorCode = code + "!"
  let raw = code as string
  assert same && prefixed == "invalid escape sequence!" && raw == "invalid escape sequence"
}

#[test]
fn newtype_struct_nominal() {
  let id: Ticket = 7
  let n: int = 3
  let summed = id + (n as Ticket)
  let raw = id as int
  assert summed == 10 && raw == 7
}

#[test]
fn bool_newtype_nominal() {
  let on: Toggle = true
  let off = !on
  let combined = on && off
  assert on && !combined
}

#[test]
fn duration_add() {
  let sum = time.Second + time.Millisecond
  assert sum == 1001000000
}

#[test]
fn duration_sub() {
  let diff = time.Second - time.Millisecond
  assert diff == 999000000
}

#[test]
fn duration_comparison() {
  assert time.Second > 1000
}

#[test]
fn duration_negation() {
  let neg = -time.Second
  assert neg == -1000000000
}

#[test]
fn eq_with_variable() {
  let n: int = 1000000000
  assert time.Second == (n as time.Duration)
}

#[test]
fn variable_not_variant() {
  let n: int = 5
  let result: time.Duration = time.Second * (n as time.Duration)
  assert result == 5000000000
}

#[test]
fn negated_literal_times_aliased() {
  let d: time.Duration = -5 * time.Second
  assert d == -5000000000
}

#[test]
fn paren_negated_literal_times_aliased() {
  let d: time.Duration = (-5) * time.Second
  assert d == -5000000000
}

struct Box<T> { value: T }

#[test]
fn generic_call_keeps_a_literal_at_its_annotated_type() {
  // Inferring `int` here would make the division integer division.
  let widened: float64 = echo_value(1)
  assert widened / 2.0 > 0.4

  let narrow: float32 = echo_value(3)
  assert narrow > 2.5
}

#[test]
fn tuple_field_autofill_keeps_its_element_types() {
  let p = Measurement { .. }
  assert p.reading.0 == 0
  assert p.reading.1 < 0.5
}

#[test]
fn generic_call_keeps_a_literal_at_its_newtype() {
  let toggle: Toggle = echo_value(true)
  let label: Label = echo_value("on")
  let ticket: Ticket = echo_value(7)
  assert toggle.0
  assert label.0 == "on"
  assert ticket.0 == 7
}

#[test]
fn zero_of_primitives() {
  assert zero<int>() == 0
  assert zero<float64>() == 0.0
  assert zero<string>() == ""
  assert zero<bool>() == false
}

#[test]
fn zero_of_struct_zeroes_every_field() {
  let p = zero<Point>()
  assert p.x == 0
  assert p.y == 0
}

#[test]
fn zero_of_option_is_none() {
  let opt = zero<Option<int>>()
  assert opt.is_none()
}

#[test]
fn zero_of_slice_is_empty_but_appendable() {
  let s = zero<Slice<int>>()
  assert s.is_empty()
  assert s.append(1).length() == 1
}

#[test]
fn zero_of_a_tuple_keeps_its_element_types() {
  let t = zero<(int, float64)>()
  assert t.0 == 0
  assert t.1 < 0.5
}

#[test]
fn zero_of_an_enum_is_its_default_variant() {
  // `Grey` is neither first nor last, so tag 0 cannot land there by accident.
  assert zero<ZeroTone>() == ZeroTone.Grey
  assert zero<ZeroTone>() != ZeroTone.Black
  assert pick<ZeroTone>() == ZeroTone.Grey
  assert pick<ZeroTone>() != ZeroTone.White
}

#[test]
fn zero_of_type_parameter_round_trips_through_json() {
  let raw: Slice<byte> = "{\"name\":\"alice\",\"age\":30}" as Slice<byte>
  let person = parse_json<Person>(raw).unwrap_or(Person { name: "", age: 0 })
  assert person.name == "alice"
  assert person.age == 30
}

#[test]
fn zero_of_type_parameter_reports_bad_json() {
  let raw: Slice<byte> = "not json" as Slice<byte>
  let parsed: Result<Person, error> = parse_json<Person>(raw)
  assert parsed.is_err()
}

#[test]
fn zero_into_an_interface_slot_is_not_nil() {
  // A nil interface would panic on the call; the empty name proves the boxed
  // value is a zeroed `ZeroDog` and not just any non-nil value.
  let speaker: ZeroSpeaker = zero<ZeroDog>()
  assert speaker.speak() == ""
}

#[test]
fn zero_into_an_unknown_slot_keeps_its_type() {
  let n: Unknown = zero<int>()
  assert assert_type<int>(n).unwrap_or(-1) == 0
  let s: Unknown = zero<string>()
  assert assert_type<string>(s).unwrap_or("missing") == ""
}

impl<T> Box<T> {
  fn get(self: Box<T>) -> T {
    self.value
  }

  fn map(self: Box<T>, f: fn(T) -> T) -> Box<T> {
    Box { value: f(self.value) }
  }
}

type Ints = Slice<int>
type Mask = int

fn sum_ints(nums: Ints) -> int {
  let mut total = 0
  for n in nums {
    total += n
  }
  total
}

struct Duo<A, B> { first: A, second: B }

fn make_duo<A, B>(a: A, b: B) -> Duo<A, B> {
  Duo { first: a, second: b }
}

struct Ticket(int)

struct Toggle(bool)

struct Label(string)

struct Measurement { reading: (int, float64) }

fn echo_value<T>(value: T) -> T {
  value
}

#[json]
struct Person {
  #[json("name")]
  name: string,
  #[json("age")]
  age: int,
}

#[equality]
enum ZeroTone { Black, #[default] Grey, White }

fn pick<T: Zeroable>() -> T {
  zero<T>()
}

fn parse_json<T: Zeroable>(data: Slice<byte>) -> Result<T, error> {
  let mut result = zero<T>()
  json.Unmarshal(data, &result)?
  Ok(result)
}

interface ZeroSpeaker { fn speak() -> string }

struct ZeroDog { name: string }

impl ZeroDog {
  fn speak(self) -> string { self.name }
}
